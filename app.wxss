    --glass-accent-warm-text: #8a5a0a;
    --glass-danger-text: #b83a26;
    --glass-shadow: 0 24rpx 72rpx rgba(42, 58, 92, 0.16);
    --glass-shadow-soft: 0 10rpx 32rpx rgba(42, 58, 92, 0.1);
    --glass-noise-opacity: 0.05;
    --glass-sheen: linear-gradient(120deg, rgba(255, 255, 255, 0) 18%, rgba(255, 255, 255, 0.42) 46%, rgba(255, 255, 255, 0) 72%);
    --glass-border-gradient: linear-gradient(135deg, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0.42) 36%, rgba(255, 255, 255, 0.18) 62%, rgba(255, 255, 255, 0.86));
  }
}

/* ---- 手动浅色 · 晨雾玻璃（与媒体查询同源同值） ---- */
.theme-light {
  --glass-canvas: #eef1f7;
  --glass-canvas-2: #f8f9fc;
  --glass-aurora-1: rgba(112, 138, 255, 0.22);
  --glass-aurora-2: rgba(255, 184, 138, 0.18);
  --glass-aurora-3: rgba(68, 220, 190, 0.12);
  --glass-bg: rgba(255, 255, 255, 0.54);
  --glass-bg-soft: rgba(255, 255, 255, 0.34);
  --glass-bg-strong: rgba(255, 255, 255, 0.78);
  --glass-blur: 26px;
  --glass-saturate: 150%;
  --glass-border: rgba(255, 255, 255, 0.72);
  --glass-border-strong: rgba(255, 255, 255, 0.92);
  --glass-highlight: rgba(255, 255, 255, 0.98);
  --glass-inner-glow: rgba(255, 255, 255, 0.9);
  --glass-scrim: rgba(22, 28, 42, 0.34);
  --glass-text: #151a24;
  --glass-text-2: #4e5768;
  --glass-text-3: #5f6a7d;
  --glass-accent: #5367ff;
  --glass-accent-2: #0fb59a;
  --glass-accent-warm: #d99a32;
  --glass-accent-soft: rgba(83, 103, 255, 0.12);
  /* 选中态 / 焦点态专用：比 soft 更亮一档，只作光晕，不作填充 */
  --glass-accent-glow: rgba(83, 103, 255, 0.26);
  --glass-accent-2-soft: rgba(15, 181, 154, 0.12);
  --glass-accent-warm-soft: rgba(217, 154, 50, 0.12);
  --glass-danger: #e85b43;
  --glass-accent-text: #4453e0;
  --glass-accent-2-text: #067a68;
  --glass-accent-warm-text: #8a5a0a;
  --glass-danger-text: #b83a26;
  --glass-shadow: 0 24rpx 72rpx rgba(42, 58, 92, 0.16);
  --glass-shadow-soft: 0 10rpx 32rpx rgba(42, 58, 92, 0.1);
  --glass-noise-opacity: 0.05;
  --glass-sheen: linear-gradient(120deg, rgba(255, 255, 255, 0) 18%, rgba(255, 255, 255, 0.42) 46%, rgba(255, 255, 255, 0) 72%);
  --glass-border-gradient: linear-gradient(135deg, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0.42) 36%, rgba(255, 255, 255, 0.18) 62%, rgba(255, 255, 255, 0.86));
}

/* ---- 低端机 / 不支持 backdrop-filter 的降级 ---- */
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  page,
  .theme-dark {
    --glass-blur: 0px;
    --glass-bg: rgba(13, 17, 26, 0.94);
    --glass-bg-soft: rgba(13, 17, 26, 0.88);
    --glass-bg-strong: rgba(20, 25, 38, 0.97);
    --glass-highlight: rgba(255, 255, 255, 0.12);
    --glass-noise-opacity: 0;
  }

  .theme-light {
    --glass-blur: 0px;
    --glass-bg: rgba(248, 249, 252, 0.94);
    --glass-bg-soft: rgba(248, 249, 252, 0.88);
    --glass-bg-strong: rgba(255, 255, 255, 0.98);
    --glass-highlight: rgba(255, 255, 255, 0.6);
    --glass-noise-opacity: 0;
  }

  @media (prefers-color-scheme: light) {
    page {
      --glass-blur: 0px;
      --glass-bg: rgba(248, 249, 252, 0.94);
      --glass-bg-soft: rgba(248, 249, 252, 0.88);
      --glass-bg-strong: rgba(255, 255, 255, 0.98);
      --glass-highlight: rgba(255, 255, 255, 0.6);
      --glass-noise-opacity: 0;
    }
  }
}

/* ---- 减少动态偏好 ---- */
@media (prefers-reduced-motion: reduce) {
  page {
    --glass-duration-fast: 1ms;
    --glass-duration-base: 1ms;
    --glass-duration-slow: 1ms;
  }
}

/* ==========================================================================
   字号档 · 根容器类
   - 只改变 --fs-scale，字号 token 通过 calc(nrpx * var(--fs-scale, 1)) 取值
   - 不缩放间距、图标与 Canvas；组件内靠自定义属性继承
   ========================================================================== */

.fs-standard {
  --fs-scale: 1;
}

.fs-large {
  --fs-scale: 1.15;
}

.fs-xlarge {
  --fs-scale: 1.3;
}

/* ==========================================================================
   Glass 3.0 · 页面级基础类
   ========================================================================== */

.glass-page {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 100%;
  min-height: 100vh;
  color: var(--glass-text);
  background-color: var(--glass-canvas);
  background-image:
    radial-gradient(120% 80% at 8% 0%, var(--glass-aurora-1), transparent 60%),
    radial-gradient(100% 70% at 92% 8%, var(--glass-aurora-2), transparent 65%),
    radial-gradient(80% 60% at 50% 100%, var(--glass-aurora-3), transparent 70%),
    linear-gradient(180deg, var(--glass-canvas-2), var(--glass-canvas));
  font-family: var(--glass-font-sans);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  overflow: hidden;
}

.glass-surface {
  background: var(--glass-bg);
  border: 1rpx solid var(--glass-border);
  box-shadow: var(--glass-shadow), inset 0 1rpx 0 var(--glass-highlight);
  -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
  backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
}

.glass-noise-layer {
  position: relative;
  overflow: hidden;
}

.glass-noise-layer::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
  border-radius: inherit;
  background-image: var(--glass-noise-image);
  background-size: var(--glass-noise-size);
  opacity: var(--glass-noise-opacity);
  mix-blend-mode: soft-light;
}

.glass-safe-bottom {
  padding-bottom: calc(24rpx + var(--glass-safe-bottom));
}

.glass-safe-top {
  padding-top: calc(24rpx + var(--glass-safe-top));
}

.glass-press {
  transition:
    transform var(--glass-duration-fast) var(--glass-ease-out),
    opacity var(--glass-duration-fast) var(--glass-ease-out),
    box-shadow var(--glass-duration-base) var(--glass-ease-out);
}

.glass-press-active {
  transform: scale(0.975);
  opacity: 0.92;
}

.glass-sheen-layer {
  position: relative;
  overflow: hidden;
}

.glass-sheen-layer::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  border-radius: inherit;
  background-image: var(--glass-sheen);
  opacity: 0.36;
}

/* ==========================================================================
   Spatial Glass 26 · 广色域 / 次表面散射 / 动态光追 / 环境光 / 对比度守护
   - 本段为增量基座，不覆盖旧 --g-* / --v3-* / --tbx-* 令牌
   - P3 / LCH / color-mix 全部放在 @supports 内，旧设备保留 sRGB 回退
   - --sg-* 为新组件命名空间；部分 --glass-* 仅在支持广色域时提亮
   ========================================================================== */

page,
.theme-light {
  --sg-paper: #f4f5f1;
  --sg-paper-2: #e9ece4;
  --sg-ink: #111318;
  --sg-ink-2: #47505a;
  --sg-ink-3: #707a82;

  --sg-iris: #6d78ff;
  --sg-mint: #5fdcc7;
  --sg-warm: #ffb083;
  --sg-danger: #ff5c6d;

  --sg-ambient-cold: #7c8cff;
  --sg-ambient-warm: #ffb083;
  --sg-ambient-iris: #9f7cff;
  --sg-ambient-mint: #5fdcc7;
  --sg-ambient-night: #1a2238;

  --sg-ambient-a: var(--sg-ambient-cold);
  --sg-ambient-b: var(--sg-ambient-mint);
  --sg-ambient-c: var(--sg-ambient-warm);
  --sg-ambient-a-soft: rgba(124, 140, 255, 0.22);
  --sg-ambient-b-soft: rgba(95, 220, 199, 0.16);
  --sg-ambient-c-soft: rgba(255, 176, 131, 0.18);
  --sg-ambient-intensity: 1;
  --sg-ambient-haze: 0.18;
  --sg-ambient-transition: 520ms cubic-bezier(0.22, 1, 0.36, 1);

  --sg-glass-bg: rgba(255, 255, 255, 0.62);
  --sg-glass-bg-strong: rgba(255, 255, 255, 0.82);
  --sg-glass-border: rgba(255, 255, 255, 0.55);
  --sg-glass-border-strong: rgba(255, 255, 255, 0.76);
  --sg-glass-highlight: rgba(255, 255, 255, 0.92);
  --sg-glass-fallback-bg: rgba(250, 251, 247, 0.94);
  --sg-glass-fallback-bg-strong: rgba(255, 255, 255, 0.97);

  --sg-chromatic-red: rgba(255, 58, 96, 0.24);
  --sg-chromatic-blue: rgba(54, 110, 255, 0.24);
  --sg-chromatic-cyan: rgba(62, 236, 220, 0.18);
  --sg-chromatic-glow: rgba(120, 136, 255, 0.18);
  --sg-chromatic-opacity: 0.82;

  --sg-sss-inner:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9),
    inset 0 -1rpx 0 rgba(255, 255, 255, 0.18),
    inset 1rpx 0 0 rgba(255, 90, 120, 0.06),
    inset -1rpx 0 0 rgba(70, 110, 255, 0.06);
  --sg-sss-shadow:
    0 0 0 1rpx rgba(255, 255, 255, 0.08),
    0 12rpx 32rpx rgba(28, 38, 58, 0.08),
    0 42rpx 120rpx rgba(28, 38, 58, 0.12);

  --sg-light-x: 50%;
  --sg-light-y: 12%;
  --sg-light-size: 58%;
  --sg-light-color: rgba(255, 255, 255, 0.52);
  --sg-light-strong: rgba(255, 255, 255, 0.86);
  --sg-light-angle: 135deg;

  --sg-contrast-text: #14171c;
  --sg-contrast-text-2: #3d464f;
  --sg-text-shadow:
    0 1rpx 1rpx rgba(255, 255, 255, 0.5),
    0 1rpx 2rpx rgba(0, 0, 0, 0.14);
  --sg-text-shadow-strong:
    0 1rpx 0 rgba(255, 255, 255, 0.72),
    0 2rpx 10rpx rgba(0, 0, 0, 0.2);
  --sg-backplate: rgba(250, 251, 247, 0.82);
  --sg-backplate-border: rgba(255, 255, 255, 0.68);
  --sg-focus-ring: rgba(92, 108, 255, 0.52);

  --sg-radius-sm: 18rpx;
  --sg-radius-md: 28rpx;
  --sg-radius-lg: 42rpx;
  --sg-radius-xl: 56rpx;
  --sg-radius-sheet: 72rpx;

  --sg-gpu-transform: translateZ(0);
}

.theme-dark {
  --sg-paper: #0a0d12;
  --sg-paper-2: #11151d;
  --sg-ink: #f3f5f8;
  --sg-ink-2: #b4bcc8;
  --sg-ink-3: #828b99;

  --sg-iris: #8e9bff;
  --sg-mint: #74f0da;
  --sg-warm: #ffc09a;
  --sg-danger: #ff7a88;

  --sg-ambient-cold: #6a7bff;
  --sg-ambient-warm: #ff9a6b;
  --sg-ambient-iris: #b184ff;
  --sg-ambient-mint: #5fe3cb;
  --sg-ambient-night: #0b1022;

  --sg-ambient-a: var(--sg-ambient-cold);
  --sg-ambient-b: var(--sg-ambient-mint);
  --sg-ambient-c: var(--sg-ambient-warm);
  --sg-ambient-a-soft: rgba(106, 123, 255, 0.2);
  --sg-ambient-b-soft: rgba(95, 227, 203, 0.13);
  --sg-ambient-c-soft: rgba(255, 154, 107, 0.14);
  --sg-ambient-intensity: 0.78;
  --sg-ambient-haze: 0.34;

  --sg-glass-bg: rgba(18, 22, 32, 0.58);
  --sg-glass-bg-strong: rgba(22, 27, 39, 0.78);
  --sg-glass-border: rgba(255, 255, 255, 0.12);
  --sg-glass-border-strong: rgba(255, 255, 255, 0.2);
  --sg-glass-highlight: rgba(255, 255, 255, 0.24);
  --sg-glass-fallback-bg: rgba(14, 17, 24, 0.94);
  --sg-glass-fallback-bg-strong: rgba(18, 22, 30, 0.97);

  --sg-chromatic-red: rgba(255, 76, 112, 0.3);
  --sg-chromatic-blue: rgba(76, 126, 255, 0.3);
  --sg-chromatic-cyan: rgba(76, 238, 224, 0.16);
  --sg-chromatic-glow: rgba(130, 146, 255, 0.22);
  --sg-chromatic-opacity: 0.86;

  --sg-sss-inner:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.18),

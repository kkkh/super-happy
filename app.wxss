/* ==========================================================================
   全局样式入口 · 曜石画廊
   - 原子化工具类：Tailwind v4 编译产物（唯一样式真相源的编译结果）
   - 语义令牌运行时真值：--g-* 命名空间，双主题（深色 · 黑曜石 / 浅色 · 晨瓷）
   - 三重保障：
     1) page 级默认值 + @media (prefers-color-scheme) —— 零 JS 首帧即正确主题
     2) theme.json + darkmode —— 窗口背景 / 状态栏随系统翻转（见 app.json）
     3) .theme-light / .theme-dark —— uiStore 手动覆盖（页面根节点显式挂载）
   ========================================================================== */
@import "./styles/generated/tailwind.wxss";
@import "./styles/v3.wxss";

/* Tailwind 产物中的 .border 固定为 1px；小程序内统一收敛到 1rpx */
.border {
  border-width: 1rpx;
}

/* 极端字号/Android WebView 字体放大保护：阻止自动字体膨胀与横向溢出 */
page {
  -webkit-text-size-adjust: 100%;
  text-size-adjust: 100%;
  overflow-x: hidden;
}

/* ---- 深色 · 黑曜石（品牌默认基调；系统深色首帧） ---- */
page,
.theme-dark {
  /* 表面材质 */
  --g-canvas: #06080f;
  --g-well: #0b0f1a;
  --g-surface: rgba(255, 255, 255, 0.055);
  --g-surface-strong: rgba(255, 255, 255, 0.09);
  --g-solid: #10141f;
  --g-elevated: rgba(13, 18, 29, 0.92);
  --g-scrim: rgba(4, 6, 11, 0.64);

  /* 描边 */
  --g-stroke: rgba(255, 255, 255, 0.1);
  --g-stroke-strong: rgba(255, 255, 255, 0.2);

  /* 墨色五阶 */
  --g-ink: #f4f6fb;
  --g-ink-2: #dce2ef;
  --g-ink-3: #8c99b6;
  --g-ink-4: #5d6b8b;
  --g-ink-5: #3e4a63;

  /* 主色 1 · iris 铟蓝 */
  --g-iris: #8a93ec;
  --g-iris-2: #a7b0f2;
  --g-iris-soft: rgba(107, 118, 220, 0.16);
  --g-iris-border: rgba(138, 147, 236, 0.35);
  --g-iris-glow: rgba(107, 118, 220, 0.4);

  /* 主色 2 · aurora 薄荷 */
  --g-aurora: #54cfb2;
  --g-aurora-2: #7fe0c8;
  --g-aurora-soft: rgba(82, 205, 176, 0.14);
  --g-aurora-border: rgba(127, 224, 200, 0.32);
  --g-aurora-glow: rgba(82, 205, 176, 0.35);

  /* 点缀 · amber 暖金 */
  --g-amber: #e9c68d;
  --g-amber-soft: rgba(232, 197, 138, 0.14);
  --g-amber-border: rgba(232, 197, 138, 0.32);
  --g-amber-glow: rgba(232, 197, 138, 0.3);

  /* 渐变与光影 */
  --g-gradient-accent: linear-gradient(135deg, #6b76dc 0%, #5560c4 55%, #434ca3 100%);
  --g-gradient-avatar: linear-gradient(135deg, rgba(138, 147, 236, 0.9), rgba(82, 205, 176, 0.7), rgba(232, 197, 138, 0.6));
  --g-orb-iris: rgba(107, 118, 220, 0.4);
  --g-orb-aurora: rgba(82, 205, 176, 0.28);
  --g-orb-amber: rgba(232, 197, 138, 0.16);
  --g-ph-iris-a: rgba(138, 147, 236, 0.85);
  --g-ph-iris-b: rgba(67, 76, 163, 0.8);
  --g-ph-aurora-a: rgba(127, 224, 200, 0.8);
  --g-ph-aurora-b: rgba(42, 148, 128, 0.8);
  --g-ph-amber-a: rgba(232, 197, 138, 0.8);
  --g-ph-amber-b: rgba(163, 128, 67, 0.8);
  --g-ring-iris: rgba(138, 147, 236, 0.55);
  --g-ring-aurora: rgba(127, 224, 200, 0.5);
  --g-grid: rgba(255, 255, 255, 0.05);
  --g-ph-glyph: rgba(255, 255, 255, 0.75);
  --g-dot-off: rgba(255, 255, 255, 0.12);
  --g-skeleton: rgba(255, 255, 255, 0.05);
  --g-skeleton-hi: rgba(255, 255, 255, 0.12);
  --g-sheen-hi: rgba(255, 255, 255, 0.09);
  --g-hi: rgba(255, 255, 255, 0.22);
  --g-hero-glow: rgba(107, 118, 220, 0.45);
  --g-cover-scrim-0: rgba(6, 8, 15, 0);
  --g-cover-scrim: rgba(6, 8, 15, 0.85);
  --g-hero-scrim-0: rgba(6, 8, 15, 0);
  --g-hero-scrim: rgba(6, 8, 15, 0.92);
  --g-shadow-glass: 0 8rpx 32rpx rgba(3, 6, 12, 0.45);
  --g-shadow-lift: 0 16rpx 48rpx rgba(3, 6, 12, 0.55);

  background-color: var(--g-canvas);
  color: var(--g-ink);
}


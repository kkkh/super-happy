    inset 1rpx 0 0 rgba(255, 90, 120, 0.1),
    inset -1rpx 0 0 rgba(80, 120, 255, 0.12);
  --sg-sss-shadow:
    0 0 0 1rpx rgba(255, 255, 255, 0.03),
    0 16rpx 42rpx rgba(0, 0, 0, 0.32),
    0 54rpx 140rpx rgba(0, 0, 0, 0.46);

  --sg-light-x: 50%;
  --sg-light-y: 8%;
  --sg-light-size: 62%;
  --sg-light-color: rgba(255, 255, 255, 0.16);
  --sg-light-strong: rgba(255, 255, 255, 0.3);

  --sg-contrast-text: #f7f8fb;
  --sg-contrast-text-2: #c5ccd6;
  --sg-text-shadow:
    0 1rpx 2rpx rgba(0, 0, 0, 0.55),
    0 0 12rpx rgba(0, 0, 0, 0.2);
  --sg-text-shadow-strong:
    0 1rpx 0 rgba(0, 0, 0, 0.7),
    0 2rpx 14rpx rgba(0, 0, 0, 0.36);
  --sg-backplate: rgba(12, 15, 22, 0.86);
  --sg-backplate-border: rgba(255, 255, 255, 0.14);
  --sg-focus-ring: rgba(142, 155, 255, 0.6);
}

/* ---- 系统深色：页面尚未拿到 .theme-dark 时的首帧兜底 ---- */
@media (prefers-color-scheme: dark) {
  page {
    --sg-paper: #0a0d12;
    --sg-paper-2: #11151d;
    --sg-ink: #f3f5f8;
    --sg-ink-2: #b4bcc8;
    --sg-ink-3: #828b99;

    --sg-iris: #8e9bff;
    --sg-mint: #74f0da;
    --sg-warm: #ffc09a;
    --sg-danger: #ff7a88;

    --sg-ambient-cold: #6a7bff;
    --sg-ambient-warm: #ff9a6b;
    --sg-ambient-iris: #b184ff;
    --sg-ambient-mint: #5fe3cb;
    --sg-ambient-night: #0b1022;

    --sg-ambient-a-soft: rgba(106, 123, 255, 0.2);
    --sg-ambient-b-soft: rgba(95, 227, 203, 0.13);
    --sg-ambient-c-soft: rgba(255, 154, 107, 0.14);
    --sg-ambient-intensity: 0.78;
    --sg-ambient-haze: 0.34;

    --sg-glass-bg: rgba(18, 22, 32, 0.58);
    --sg-glass-bg-strong: rgba(22, 27, 39, 0.78);
    --sg-glass-border: rgba(255, 255, 255, 0.12);
    --sg-glass-border-strong: rgba(255, 255, 255, 0.2);
    --sg-glass-highlight: rgba(255, 255, 255, 0.24);
    --sg-glass-fallback-bg: rgba(14, 17, 24, 0.94);
    --sg-glass-fallback-bg-strong: rgba(18, 22, 30, 0.97);

    --sg-chromatic-red: rgba(255, 76, 112, 0.3);
    --sg-chromatic-blue: rgba(76, 126, 255, 0.3);
    --sg-chromatic-glow: rgba(130, 146, 255, 0.22);

    --sg-contrast-text: #f7f8fb;
    --sg-contrast-text-2: #c5ccd6;
    --sg-text-shadow:
      0 1rpx 2rpx rgba(0, 0, 0, 0.55),
      0 0 12rpx rgba(0, 0, 0, 0.2);
    --sg-text-shadow-strong:
      0 1rpx 0 rgba(0, 0, 0, 0.7),
      0 2rpx 14rpx rgba(0, 0, 0, 0.36);
    --sg-backplate: rgba(12, 15, 22, 0.86);
    --sg-backplate-border: rgba(255, 255, 255, 0.14);
    --sg-focus-ring: rgba(142, 155, 255, 0.6);
  }
}

/* ---- 环境光预设 ---- */
.sg-ambient-cold {
  --sg-ambient-a: var(--sg-ambient-cold);
  --sg-ambient-b: var(--sg-ambient-iris);
  --sg-ambient-c: var(--sg-ambient-mint);
  --sg-ambient-a-soft: rgba(124, 140, 255, 0.22);
  --sg-ambient-b-soft: rgba(159, 124, 255, 0.16);
  --sg-ambient-c-soft: rgba(95, 220, 199, 0.14);
}

.sg-ambient-warm {
  --sg-ambient-a: var(--sg-ambient-warm);
  --sg-ambient-b: var(--sg-ambient-iris);
  --sg-ambient-c: var(--sg-ambient-mint);
  --sg-ambient-a-soft: rgba(255, 176, 131, 0.2);
  --sg-ambient-b-soft: rgba(159, 124, 255, 0.15);
  --sg-ambient-c-soft: rgba(95, 220, 199, 0.1);
}

.sg-ambient-iris {
  --sg-ambient-a: var(--sg-ambient-iris);
  --sg-ambient-b: var(--sg-ambient-cold);
  --sg-ambient-c: var(--sg-ambient-warm);
  --sg-ambient-a-soft: rgba(159, 124, 255, 0.22);
  --sg-ambient-b-soft: rgba(124, 140, 255, 0.16);
  --sg-ambient-c-soft: rgba(255, 176, 131, 0.12);
}

.sg-ambient-mint {
  --sg-ambient-a: var(--sg-ambient-mint);
  --sg-ambient-b: var(--sg-ambient-cold);
  --sg-ambient-c: var(--sg-ambient-iris);
  --sg-ambient-a-soft: rgba(95, 220, 199, 0.2);
  --sg-ambient-b-soft: rgba(124, 140, 255, 0.14);
  --sg-ambient-c-soft: rgba(159, 124, 255, 0.12);
}

.sg-ambient-night {
  --sg-ambient-a: var(--sg-ambient-night);
  --sg-ambient-b: var(--sg-ambient-cold);
  --sg-ambient-c: var(--sg-ambient-iris);
  --sg-ambient-intensity: 0.42;
  --sg-ambient-haze: 0.52;
}

/* ---- 极光氛围层：实色椭圆 + 80px 高斯模糊，真机可见的彩色底光 ---- */
.sg-aurora-a {
  background-color: rgba(147, 71, 255, 0.6);
  border-radius: 50%;
  filter: blur(80px);
}

.sg-aurora-b {
  background-color: rgba(56, 189, 248, 0.62);
  border-radius: 50%;
  filter: blur(80px);
}

.sg-aurora-c {
  background-color: rgba(255, 120, 214, 0.42);
  border-radius: 50%;
  filter: blur(80px);
}

/* 夜航：同一组极光整体收一档，深色画布上不过曝 */
.theme-dark .sg-aurora-a,
.theme-dark .sg-aurora-b,
.theme-dark .sg-aurora-c {
  opacity: 0.72;
}

/* 主题切换呼吸：真实昼↔夜翻转时播放一次，掩盖硬切 */
@keyframes sg-theme-breathe {
  0% {
    opacity: 1;
  }

  30% {
    opacity: 0.84;
  }

  100% {
    opacity: 1;
  }
}

.theme-breathing {
  animation: sg-theme-breathe 420ms var(--glass-ease-out);
}

.sg-ambient-surface {
  background-color: var(--sg-paper);
  background-image:
    radial-gradient(
      120% 82% at 8% -4%,
      var(--sg-ambient-a-soft) 0%,
      transparent 62%
    ),
    radial-gradient(
      92% 68% at 96% 18%,
      var(--sg-ambient-b-soft) 0%,
      transparent 66%
    ),
    radial-gradient(
      110% 78% at 52% 108%,
      var(--sg-ambient-c-soft) 0%,
      transparent 68%
    );
  background-attachment: local;
  transition:
    background-color var(--sg-ambient-transition),
    background-image var(--sg-ambient-transition);
}

.sg-ambient-veil {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  border-radius: inherit;
  background-image:
    radial-gradient(
      70% 54% at var(--sg-light-x) var(--sg-light-y),
      var(--sg-light-color) 0%,
      transparent 70%
    ),
    linear-gradient(
      var(--sg-ambient-haze),
      var(--sg-ambient-haze)
    );
  opacity: var(--sg-ambient-intensity);
  mix-blend-mode: soft-light;
}

/* ---- 动态光追 ---- */
.sg-light-track {
  --sg-light-x: 50%;
  --sg-light-y: 12%;
  --sg-light-size: 64%;
  position: relative;
  isolation: isolate;
  background-image: radial-gradient(
    ellipse var(--sg-light-size) 52% at var(--sg-light-x) var(--sg-light-y),
    var(--sg-light-color) 0%,
    transparent 70%
  );
}

.sg-light-sheen::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  border-radius: inherit;
  background-image:
    radial-gradient(
      circle at var(--sg-light-x) var(--sg-light-y),
      var(--sg-light-strong) 0%,
      transparent 34%
    ),
    linear-gradient(
      var(--sg-light-angle),
      transparent 28%,
      rgba(255, 255, 255, 0.18) 46%,
      transparent 64%
    );
  opacity: 0.72;
  mix-blend-mode: screen;
}

/* ---- 次表面散射 + 色散边缘 ---- */
.sg-chromatic {
  position: relative;
  isolation: isolate;
}

.sg-chromatic::before {
  content: "";
  position: absolute;
  inset: -1rpx;
  z-index: 0;
  pointer-events: none;
  border-radius: inherit;
  box-shadow:
    1rpx 0 0 var(--sg-chromatic-red),
    -1rpx 0 0 var(--sg-chromatic-blue),
    0 1rpx 0 var(--sg-chromatic-cyan),
    0 0 24rpx var(--sg-chromatic-glow);
  opacity: var(--sg-chromatic-opacity);
  mix-blend-mode: screen;
}

.sg-chromatic::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  border-radius: inherit;
  box-shadow: var(--sg-sss-inner);
  background-image: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.14) 0%,
    transparent 18%,
    transparent 82%,
    rgba(0, 0, 0, 0.06) 100%
  );
}

/* ---- 毛玻璃基座 ---- */
.sg-glass {
  position: relative;
  border: 1rpx solid var(--sg-glass-border);
  border-radius: var(--sg-radius-lg);
  background-color: var(--sg-glass-bg);
  box-shadow:
    var(--sg-sss-shadow),
    inset 0 1rpx 0 var(--sg-glass-highlight);
  -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
  backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
  -webkit-font-smoothing: antialiased;
  transition:
    background-color 320ms var(--glass-ease-out),
    box-shadow 420ms var(--glass-ease-out);
}

.sg-glass-strong {
  background-color: var(--sg-glass-bg-strong);
  border-color: var(--sg-glass-border-strong);
}

/* ---- GPU 合成层 ---- */
.sg-gpu {
  transform: var(--sg-gpu-transform);
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  will-change: transform, opacity;
  contain: layout style;
}

.sg-gpu-layer {
  transform: translateZ(0);
  will-change: transform;
  pointer-events: none;
}

/* ---- 对比度守护 ---- */
.text-on-glass {
  color: var(--sg-contrast-text);
  text-shadow: var(--sg-text-shadow);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

.text-on-glass--strong {
  color: var(--sg-contrast-text);
  text-shadow: var(--sg-text-shadow-strong);
}

.text-on-glass--secondary {
  color: var(--sg-contrast-text-2);
  text-shadow: var(--sg-text-shadow);
}

.text-on-glass--difference {
  color: #ffffff;
  text-shadow: none;
  mix-blend-mode: difference;
  isolation: isolate;
}

.sg-contrast-backplate {
  border: 1rpx solid var(--sg-backplate-border);
  border-radius: var(--sg-radius-md);
  background-color: var(--sg-backplate);
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.08);
  -webkit-backdrop-filter: blur(18rpx);
  backdrop-filter: blur(18rpx);
}

.sg-focus-ring {
  outline: none;
  box-shadow: 0 0 0 4rpx var(--sg-focus-ring);
}

/* ---- 广色域 P3 ---- */
@supports (color: color(display-p3 1 0 0)) {
  page,
  .theme-light {
    --sg-paper: color(display-p3 0.956 0.958 0.932);
    --sg-paper-2: color(display-p3 0.912 0.924 0.892);
    --sg-ink: color(display-p3 0.066 0.074 0.094);
    --sg-ink-2: color(display-p3 0.278 0.314 0.353);
    --sg-ink-3: color(display-p3 0.44 0.48 0.52);

    --sg-iris: color(display-p3 0.46 0.49 1);
    --sg-mint: color(display-p3 0.42 0.9 0.82);
    --sg-warm: color(display-p3 1 0.68 0.5);
    --sg-danger: color(display-p3 1 0.34 0.4);

    --sg-ambient-cold: color(display-p3 0.48 0.55 1);
    --sg-ambient-warm: color(display-p3 1 0.68 0.5);
    --sg-ambient-iris: color(display-p3 0.64 0.48 1);
    --sg-ambient-mint: color(display-p3 0.38 0.88 0.78);
    --sg-ambient-night: color(display-p3 0.08 0.12 0.22);

    --sg-chromatic-red: color(display-p3 1 0.2 0.36);
    --sg-chromatic-blue: color(display-p3 0.28 0.42 1);
    --sg-chromatic-cyan: color(display-p3 0.24 0.9 0.84);
    --sg-chromatic-glow: color(display-p3 0.52 0.58 1);

    --glass-accent: color(display-p3 0.46 0.49 1);
    --glass-accent-2: color(display-p3 0.42 0.9 0.82);
    --glass-accent-warm: color(display-p3 1 0.68 0.5);
    --glass-danger: color(display-p3 1 0.34 0.4);
  }

  .theme-dark {
    --sg-paper: color(display-p3 0.038 0.05 0.07);
    --sg-paper-2: color(display-p3 0.07 0.085 0.11);
    --sg-ink: color(display-p3 0.95 0.958 0.976);
    --sg-ink-2: color(display-p3 0.7 0.74 0.79);
    --sg-ink-3: color(display-p3 0.5 0.54 0.6);

    --sg-iris: color(display-p3 0.56 0.62 1);
    --sg-mint: color(display-p3 0.45 0.94 0.84);
    --sg-warm: color(display-p3 1 0.72 0.56);
    --sg-danger: color(display-p3 1 0.4 0.47);

    --sg-ambient-cold: color(display-p3 0.42 0.5 1);
    --sg-ambient-warm: color(display-p3 1 0.6 0.4);
    --sg-ambient-iris: color(display-p3 0.7 0.52 1);
    --sg-ambient-mint: color(display-p3 0.38 0.9 0.8);
    --sg-ambient-night: color(display-p3 0.04 0.06 0.12);

    --sg-chromatic-red: color(display-p3 1 0.28 0.42);
    --sg-chromatic-blue: color(display-p3 0.34 0.48 1);
    --sg-chromatic-cyan: color(display-p3 0.3 0.92 0.86);
    --sg-chromatic-glow: color(display-p3 0.56 0.62 1);

    --glass-accent: color(display-p3 0.56 0.62 1);
    --glass-accent-2: color(display-p3 0.45 0.94 0.84);
    --glass-accent-warm: color(display-p3 1 0.72 0.56);
    --glass-danger: color(display-p3 1 0.4 0.47);
  }
}

/* ---- LCH 感知均匀层 ---- */
@supports (color: lch(50% 50 250)) {
  page,
  .theme-light {
    --sg-paper: lch(96.8% 2 96);
    --sg-paper-2: lch(93.2% 2.4 110);
    --sg-ink: lch(18% 3 264);
    --sg-ink-2: lch(40% 5 264);
    --sg-ink-3: lch(58% 4 264);
    --sg-contrast-text: lch(17% 2 264);
    --sg-contrast-text-2: lch(38% 4 264);
  }

  .theme-dark {
    --sg-paper: lch(7.6% 2 270);
    --sg-paper-2: lch(12% 2.4 270);
    --sg-ink: lch(96% 1.6 260);
    --sg-ink-2: lch(76% 2.6 260);
    --sg-ink-3: lch(58% 3 260);
    --sg-contrast-text: lch(96% 1.6 260);
    --sg-contrast-text-2: lch(78% 2.4 260);
  }
}

/* ---- color-mix 半透明与色散光晕 ---- */
@supports (color: color-mix(in srgb, red, blue)) {
  page,
  .theme-light {
    --sg-ambient-a-soft: color-mix(in oklab, var(--sg-ambient-a) 24%, transparent);
    --sg-ambient-b-soft: color-mix(in oklab, var(--sg-ambient-b) 17%, transparent);
    --sg-ambient-c-soft: color-mix(in oklab, var(--sg-ambient-c) 18%, transparent);
    --sg-glass-bg: color-mix(in oklab, var(--sg-paper) 64%, transparent);
    --sg-glass-bg-strong: color-mix(in oklab, var(--sg-paper) 84%, transparent);
    --sg-glass-border: color-mix(in oklab, var(--sg-ink) 10%, transparent);
    --sg-glass-border-strong: color-mix(in oklab, var(--sg-ink) 16%, transparent);
    --sg-chromatic-red: color-mix(in oklab, var(--sg-danger) 26%, transparent);
    --sg-chromatic-blue: color-mix(in oklab, var(--sg-iris) 28%, transparent);
    --sg-chromatic-cyan: color-mix(in oklab, var(--sg-mint) 18%, transparent);
    --sg-backplate: color-mix(in oklab, var(--sg-paper) 82%, transparent);
    --glass-accent-soft: color-mix(in oklab, var(--glass-accent) 16%, transparent);
    --glass-accent-2-soft: color-mix(in oklab, var(--glass-accent-2) 14%, transparent);
    --glass-accent-warm-soft: color-mix(in oklab, var(--glass-accent-warm) 14%, transparent);
  }

  .theme-dark {
    --sg-ambient-a-soft: color-mix(in oklab, var(--sg-ambient-a) 22%, transparent);
    --sg-ambient-b-soft: color-mix(in oklab, var(--sg-ambient-b) 15%, transparent);
    --sg-ambient-c-soft: color-mix(in oklab, var(--sg-ambient-c) 15%, transparent);
    --sg-glass-bg: color-mix(in oklab, var(--sg-paper) 58%, transparent);
    --sg-glass-bg-strong: color-mix(in oklab, var(--sg-paper) 78%, transparent);
    --sg-glass-border: color-mix(in oklab, var(--sg-ink) 12%, transparent);
    --sg-glass-border-strong: color-mix(in oklab, var(--sg-ink) 20%, transparent);
    --sg-chromatic-red: color-mix(in oklab, var(--sg-danger) 30%, transparent);
    --sg-chromatic-blue: color-mix(in oklab, var(--sg-iris) 30%, transparent);
    --sg-chromatic-cyan: color-mix(in oklab, var(--sg-mint) 16%, transparent);
    --sg-backplate: color-mix(in oklab, var(--sg-paper) 86%, transparent);
    --glass-accent-soft: color-mix(in oklab, var(--glass-accent) 14%, transparent);
    --glass-accent-2-soft: color-mix(in oklab, var(--glass-accent-2) 14%, transparent);
    --glass-accent-warm-soft: color-mix(in oklab, var(--glass-accent-warm) 12%, transparent);
  }
}

/* ---- 低端机：关闭 backdrop-filter ---- */
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .sg-glass {
    background-color: var(--sg-glass-fallback-bg);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    border-color: var(--sg-glass-border-strong);
    box-shadow: 0 18rpx 48rpx rgba(0, 0, 0, 0.2);
  }

  .sg-glass-strong,
  .sg-contrast-backplate {
    background-color: var(--sg-glass-fallback-bg-strong);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  .sg-light-sheen::before,
  .sg-ambient-veil {
    opacity: 0.32;
  }

  .sg-chromatic::before {
    opacity: 0.56;
  }
}

/* ---- 对比度增强偏好 ---- */
@media (prefers-contrast: more) {
  .text-on-glass,
  .text-on-glass--secondary {
    text-shadow:
      0 0 2rpx rgba(0, 0, 0, 0.92),
      0 1rpx 2rpx rgba(0, 0, 0, 0.92);
  }

  .sg-glass,
  .sg-contrast-backplate {
    background-color: var(--sg-glass-fallback-bg-strong);
  }

  .sg-chromatic::before {
    opacity: 0.5;
  }
}

/* ==========================================================================
   设置中心 · 全局动效 / 光效档位
   - 由 uiStore.themeClass 挂载到所有页面根节点，组件通过 CSS 变量继承
   - motion-lite：延长过渡、降低极光存在感
   - motion-saver：1ms 过渡 + 关闭极光模糊，低端机 / 省电模式使用
   - light-off：关闭动态光追与大面积高斯模糊，静态渐变仍然保留
   ========================================================================== */
.motion-lite {
  --glass-duration-fast: 260ms;
  --glass-duration-base: 380ms;
  --glass-duration-slow: 640ms;
  --sg-ambient-transition: 680ms cubic-bezier(0.22, 1, 0.36, 1);
}

.motion-saver {
  --glass-duration-fast: 1ms;
  --glass-duration-base: 1ms;
  --glass-duration-slow: 1ms;
  --sg-ambient-transition: 1ms linear;
  /* 低端机 / 省电：彻底去掉毛玻璃模糊，改用实色玻璃底，消除合成开销 */
  --glass-blur: 0px;
  --glass-noise-opacity: 0;
}

.motion-saver.theme-dark {
  --glass-bg: rgba(13, 17, 26, 0.94);
  --glass-bg-soft: rgba(13, 17, 26, 0.88);
  --glass-bg-strong: rgba(20, 25, 38, 0.97);
  --glass-highlight: rgba(255, 255, 255, 0.12);
}

.motion-saver.theme-light {
  --glass-bg: rgba(248, 249, 252, 0.94);
  --glass-bg-soft: rgba(248, 249, 252, 0.88);
  --glass-bg-strong: rgba(255, 255, 255, 0.98);
  --glass-highlight: rgba(255, 255, 255, 0.6);
}

.theme-breathing.motion-saver {
  animation: none;
}

.motion-lite .sg-aurora-a,
.motion-lite .sg-aurora-b,
.motion-lite .sg-aurora-c {
  opacity: 0.62;
}

/* 动态光效关闭：保留色彩，去掉 80px 大模糊和流动光追 */
.light-off .sg-aurora-a,
.light-off .sg-aurora-b,
.light-off .sg-aurora-c {
  opacity: 0.26;
  filter: blur(28px);
  animation: none !important;
}

.light-off .sg-ambient-veil {
  opacity: 0.18;
}

.light-off .sg-light-track {
  background-image: none;
}

.light-off .sg-light-sheen::before {
  opacity: 0.18;
}

/* 系统「减少动态效果」优先级最高 */
@media (prefers-reduced-motion: reduce) {
  .motion-lite,
  .motion-saver {
    --glass-duration-fast: 1ms;
    --glass-duration-base: 1ms;
    --glass-duration-slow: 1ms;
    --sg-ambient-transition: 1ms linear;
  }

  .motion-lite .sg-aurora-a,
  .motion-lite .sg-aurora-b,
  .motion-lite .sg-aurora-c {
    animation: none !important;
  }
}

/* ---- 减少动态 ---- */
@media (prefers-reduced-motion: reduce) {
  .sg-gpu,
  .sg-light-sheen::before,
  .sg-ambient-surface,
  .theme-breathing {
    transition-duration: 1ms;
    animation-duration: 1ms;
  }

  .sg-ambient-veil {
    opacity: calc(var(--sg-ambient-intensity) * 0.7);
  }
}

/* ==========================================================================
   工具页共享基元 · 20 页统一结构
   - 输入字段栈 / 结果卡内容 / 键值行 / 说明卡
   - 页面只保留 tool-<page>-* 专属布局
   ========================================================================== */

.sg-tool-fields {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.sg-tool-unit {
  color: var(--glass-text-3);
  font-size: 22rpx;
  font-size: calc(22rpx * var(--fs-scale, 1));
}

.sg-tool-result {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-top: 4rpx;
  padding-right: 2rpx;
  padding-bottom: 4rpx;
  padding-left: 2rpx;
  box-sizing: border-box;
}

.sg-tool-result__head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.sg-tool-result__label {
  color: var(--glass-text-2);
  font-size: 24rpx;
  font-size: calc(24rpx * var(--fs-scale, 1));
  font-weight: 600;
}

.sg-tool-result__meta {
  color: var(--glass-text-3);
  font-size: 19rpx;
  font-size: calc(19rpx * var(--fs-scale, 1));
}

.sg-tool-result__main {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 18rpx;
}

.sg-tool-result__caption {
  color: var(--glass-text-2);
  font-size: 24rpx;
  font-size: calc(24rpx * var(--fs-scale, 1));
  line-height: 1.6;
}

.sg-tool-result__actions {
  padding-top: 8rpx;
}

.sg-tool-result__unit {
  color: var(--glass-text-2);
  font-size: 26rpx;
  font-size: calc(26rpx * var(--fs-scale, 1));
  font-weight: 600;
}

.sg-tool-rows {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-top: 4rpx;
}

.sg-tool-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.sg-tool-row__k {
  color: var(--glass-text-3);
  font-size: 22rpx;
  font-size: calc(22rpx * var(--fs-scale, 1));
}

.sg-tool-row__v {
  color: var(--glass-text);
  font-family: var(--glass-font-mono);
  font-size: 23rpx;
  font-size: calc(23rpx * var(--fs-scale, 1));
  text-align: right;
}

.sg-tool-note {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.sg-tool-note__title {
  color: var(--glass-text);
  font-size: 24rpx;
  font-size: calc(24rpx * var(--fs-scale, 1));
  font-weight: 700;
}

.sg-tool-note__text {
  color: var(--glass-text-2);
  font-size: 21rpx;
  font-size: calc(21rpx * var(--fs-scale, 1));
  line-height: 1.7;
}


  --v3-ro-accent: var(--v3-cat-ink);
  --v3-ro-fill-bg: var(--v3-ink);
  --v3-ro-fill-ink: var(--v3-surface);
  --g-on-fill: #ffffff;

  display: flex;
  flex-direction: column;
  width: 100%;
}

.v3_result.theme-dark,
.v3_input.theme-dark,
.v3_note.theme-dark {

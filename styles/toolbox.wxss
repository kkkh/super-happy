}

.v3_input .tbx_media_blank_title {
  font-size: 24rpx;
  color: var(--v3-ink);
}

.v3_input .tbx_media_blank_sub {
  font-size: 19rpx;
  line-height: 1.6;
  color: var(--v3-ink-3);
}

.v3_input .tbx_media_loading {
  background-color: rgba(10, 10, 12, 0.62);
  font-family: var(--v3-mono);
  font-size: 17rpx;
  letter-spacing: 1rpx;
}

.v3_input .tbx_notice {
  margin: 0 0 18rpx;
  padding: 16rpx 18rpx;
  border: 2rpx solid var(--v3-cat);
  border-radius: 0;
  background-color: transparent;
}

.v3_input .tbx_notice_text {
  font-family: var(--v3-mono);
  font-size: 21rpx;
  line-height: 1.7;
  color: var(--v3-cat-ink);
}

.v3_input .tbx_unit_swap {
  border: 2rpx solid var(--v3-cat);
  border-radius: 4rpx;
  background-color: transparent;
  color: var(--v3-cat-ink);
  font-family: var(--v3-mono);
}

/* 注释区：从旧纸卡降级为页脚式说明，不与结果卡争夺重量 */
.v3_note {
  width: auto;
  margin: 0 24rpx;
}

.v3_note .tbx_note {
  margin-top: 28rpx;
  padding: 18rpx 20rpx 0;
  border: 0;
  border-top: 2rpx solid var(--v3-line-2);
  border-radius: 0;
  background-color: transparent;
}

.v3_note .tbx_note_warn {
  border-top-color: var(--v3-cat);
}

.v3_note .tbx_note_title {
  display: block;
  font-family: var(--v3-mono);
  font-size: 16rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  color: var(--v3-cat-ink);
}

.v3_note .tbx_note_text {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.72;
  color: var(--v3-ink-2);
}

.v3_note.theme-dark .tbx_note_title {
  color: var(--v3-cat);
}

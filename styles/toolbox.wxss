/* ==========================================================================
   超欢 · 共享样式层
   - 只使用 tbx- 前缀类名与 --tbx-* 变量，不触碰旧简历样式
   - 纸感留白 / 单一青瓷绿强调 / 1rpx 描边 / 无重阴影
   ========================================================================== */

/* 页面级 hover-class 统一缓动：
   hover 态退场时同样需要基础类带 transition，否则抬手会瞬跳回原状 */
.tbx_picker,
.tbx_seg_item,
.tbx_link,
.tbx_media_stage,
.tbx_compress_stage,
.tbx_palette_stage,
.tbx_legal_contact,
.tbx_unit_swap,
.v3_ro_btn,
.v3_ro_btn_fill,
.v3_ro_color,
.v3_ro_swatch,
.v3_ro_grid_item {
  transition:
    transform 0.18s cubic-bezier(0.2, 0.9, 0.25, 1),
    opacity 0.18s cubic-bezier(0.2, 0.9, 0.25, 1);
}

/* ---- 主题令牌 ---- */
.tbx_page {
  --tbx-bg: #f7f6f2;
  --tbx-surface: #fffdf9;
  --tbx-surface-2: #f1efe9;
  --tbx-input: #ffffff;
  --tbx-ink: #1d2321;
  --tbx-ink-2: #5f6b66;
  --tbx-ink-3: #8a958f;
  --tbx-line: rgba(29, 35, 33, 0.09);
  --tbx-line-strong: rgba(29, 35, 33, 0.16);
  --tbx-accent: #0f9d8a;
  --tbx-accent-deep: #0b6b5f;
  --tbx-accent-soft: rgba(15, 157, 138, 0.09);
  --tbx-accent-border: rgba(15, 157, 138, 0.24);
  --tbx-on-accent: #f7fbf9;
  --tbx-amber: #a9641c;
  --tbx-amber-soft: rgba(199, 123, 43, 0.1);
  --tbx-amber-border: rgba(199, 123, 43, 0.26);
  --tbx-danger: #b44b35;
  --tbx-shadow: 0 10rpx 30rpx rgba(40, 46, 43, 0.06);
  --tbx-scrim: rgba(19, 24, 22, 0.38);
  --tbx-radius: 28rpx;
  --tbx-radius-lg: 36rpx;

  position: relative;
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  background-color: var(--tbx-bg);
  color: var(--tbx-ink);
  font-family: -apple-system, "PingFang SC", "Source Han Sans SC", "Noto Sans CJK SC", "Microsoft YaHei", "SF Pro Display", "Helvetica Neue", sans-serif;
  font-size: 30rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

.tbx_page.theme-dark {
  --tbx-bg: #0d1210;
  --tbx-surface: #141d19;
  --tbx-surface-2: #101814;
  --tbx-input: #18221e;
  --tbx-ink: #edf2ef;
  --tbx-ink-2: #aab7b1;
  --tbx-ink-3: #7d8a84;
  --tbx-line: rgba(255, 255, 255, 0.09);
  --tbx-line-strong: rgba(255, 255, 255, 0.18);
  --tbx-accent: #5fd6b8;
  --tbx-accent-deep: #8ee8d1;
  --tbx-accent-soft: rgba(95, 214, 184, 0.1);
  --tbx-accent-border: rgba(95, 214, 184, 0.26);
  --tbx-on-accent: #07231d;
  --tbx-amber: #e0b173;
  --tbx-amber-soft: rgba(224, 177, 115, 0.1);
  --tbx-amber-border: rgba(224, 177, 115, 0.26);
  --tbx-danger: #e58c74;
  --tbx-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.24);
  --tbx-scrim: rgba(0, 0, 0, 0.55);
}

@media (prefers-color-scheme: dark) {
  .tbx_page:not(.theme-light) {
    --tbx-bg: #0d1210;
    --tbx-surface: #141d19;
    --tbx-surface-2: #101814;
    --tbx-input: #18221e;
    --tbx-ink: #edf2ef;
    --tbx-ink-2: #aab7b1;
    --tbx-ink-3: #7d8a84;
    --tbx-line: rgba(255, 255, 255, 0.09);
    --tbx-line-strong: rgba(255, 255, 255, 0.18);
    --tbx-accent: #5fd6b8;
    --tbx-accent-deep: #8ee8d1;
    --tbx-accent-soft: rgba(95, 214, 184, 0.1);
    --tbx-accent-border: rgba(95, 214, 184, 0.26);
    --tbx-on-accent: #07231d;
    --tbx-amber: #e0b173;
    --tbx-amber-soft: rgba(224, 177, 115, 0.1);
    --tbx-amber-border: rgba(224, 177, 115, 0.26);
    --tbx-danger: #e58c74;
    --tbx-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.24);
    --tbx-scrim: rgba(0, 0, 0, 0.55);
  }
}

/* ---- 骨架 ---- */
.tbx_scroll {
  flex: 1;
  width: 100%;
}

.tbx_body {
  display: flex;
  flex-direction: column;
  padding: 8rpx 48rpx calc(56rpx + env(safe-area-inset-bottom));
}

/* Tab 页底部为自定义 TabBar 预留高度，避免最后一项被遮挡 */
.tbx_tab_page .tbx_body {
  padding-bottom: calc(172rpx + env(safe-area-inset-bottom));
}

/* ---- 文字 ---- */
.tbx_kicker {
  display: block;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  color: var(--tbx-accent-deep);
  text-transform: uppercase;
}

.tbx_title {
  display: block;
  margin-top: 10rpx;
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: 1rpx;
  color: var(--tbx-ink);
}

.tbx_desc {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.65;
  color: var(--tbx-ink-2);
}

/* ---- 卡片 ---- */
.tbx_card {
  position: relative;
  padding: 32rpx;
  border-radius: var(--tbx-radius-lg);
  background-color: var(--tbx-surface);
  border: 1rpx solid var(--tbx-line);
  box-sizing: border-box;
}

.tbx_tile {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-height: 198rpx;
  padding: 24rpx 22rpx 22rpx;
  border-radius: 26rpx;
  background-color: var(--tbx-surface);
  border: 1rpx solid var(--tbx-line);
  box-sizing: border-box;
  overflow: hidden;
}

.tbx_tile_icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--tbx-accent-deep);
  background-color: var(--tbx-accent-soft);
  border: 1rpx solid var(--tbx-accent-border);
}

.tbx_tile_name {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--tbx-ink);
  letter-spacing: 1rpx;
}

.tbx_tile_desc {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 21rpx;
  line-height: 1.5;
  color: var(--tbx-ink-2);
}

.tbx_tile_star {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
}

.tbx_press {
  opacity: 0.82;
}

/* ---- 提示条 ---- */
.tbx_notice {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background-color: var(--tbx-accent-soft);
  border: 1rpx solid var(--tbx-accent-border);
}

.tbx_notice_text {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  line-height: 1.55;
  color: var(--tbx-accent-deep);
}

/* ---- 表单 ---- */
.tbx_field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 30rpx;
}

.tbx_field:last-child {
  margin-bottom: 0;
}

.tbx_label_row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.tbx_label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--tbx-ink-2);
  letter-spacing: 1rpx;
}

.tbx_label_note {
  font-size: 20rpx;
  color: var(--tbx-ink-3);
}

.tbx_input {
  width: 100%;
  height: 96rpx;
  padding: 0 28rpx;
  border-radius: 24rpx;
  background-color: var(--tbx-input);
  border: 1rpx solid var(--tbx-line);
  box-sizing: border-box;
  font-size: 32rpx;
  color: var(--tbx-ink);
}

.tbx_placeholder {
  color: var(--tbx-ink-3);
}

.tbx_textarea {
  width: 100%;
  min-height: 260rpx;
  padding: 24rpx 26rpx;
  border-radius: 24rpx;
  background-color: var(--tbx-input);
  border: 1rpx solid var(--tbx-line);
  box-sizing: border-box;
  font-size: 29rpx;
  line-height: 1.65;
  color: var(--tbx-ink);
}

.tbx_input_row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.tbx_input_row .tbx_input {
  flex: 1;
  min-width: 0;
}

.tbx_input_suffix {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--tbx-ink-3);
  padding-right: 4rpx;
}

.tbx_picker {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 96rpx;
  padding: 0 26rpx;
  border-radius: 24rpx;
  background-color: var(--tbx-input);
  border: 1rpx solid var(--tbx-line);
  box-sizing: border-box;
}

.tbx_picker_text {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  color: var(--tbx-ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tbx_picker_placeholder {
  color: var(--tbx-ink-3);
}

.tbx_hint {
  font-size: 21rpx;
  line-height: 1.55;
  color: var(--tbx-ink-3);
}

.tbx_seg {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tbx_seg_item {
  min-height: 80rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--tbx-ink-2);
  background-color: var(--tbx-surface-2);
  border: 1rpx solid transparent;
  box-sizing: border-box;
}

.tbx_seg_active {
  color: var(--tbx-accent-deep);
  background-color: var(--tbx-accent-soft);
  border-color: var(--tbx-accent-border);
}

.tbx_switch_row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 88rpx;
  padding: 4rpx 0;
}

.tbx_switch_text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.tbx_switch_title {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--tbx-ink);
}

.tbx_switch_sub {
  font-size: 21rpx;
  color: var(--tbx-ink-3);
}

/* ---- 按钮 ---- */
.tbx_btn {
  min-height: 96rpx;
  padding: 0 36rpx;
  border-radius: 24rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--tbx-on-accent);
  background-color: var(--tbx-accent-deep);
  box-sizing: border-box;
}

.tbx_btn_press {
  opacity: 0.86;
  transform: scale(0.985);
}

.tbx_link {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-height: 64rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--tbx-accent-deep);
}

/* ---- 空态 / 注释 ---- */
.tbx_empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 64rpx 24rpx;
  border-radius: var(--tbx-radius);
  background-color: var(--tbx-surface-2);
  border: 1rpx dashed var(--tbx-line-strong);
  box-sizing: border-box;
}

.tbx_empty_title {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--tbx-ink-2);
}

.tbx_empty_sub {
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--tbx-ink-3);
  text-align: center;
}

.tbx_note {
  margin-top: 28rpx;
  padding: 26rpx 28rpx;
  border-radius: 24rpx;
  background-color: var(--tbx-surface-2);
  border: 1rpx solid var(--tbx-line);
  box-sizing: border-box;
}

.tbx_note_warn {
  background-color: var(--tbx-amber-soft);
  border-color: var(--tbx-amber-border);
}

.tbx_note_title {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--tbx-ink-2);
}

.tbx_note_warn .tbx_note_title {
  color: var(--tbx-amber);
}

.tbx_note_text {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: var(--tbx-ink-2);
}

.tbx_note_warn .tbx_note_text {
  color: var(--tbx-amber);
}

.tbx_footer {
  margin-top: 44rpx;
  text-align: center;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: var(--tbx-ink-3);
}

/* ---- 法律页 ---- */
.tbx_legal_nav {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 26rpx;
}

.tbx_legal_section {
  margin-top: 40rpx;
}

.tbx_legal_section:first-of-type {
  margin-top: 28rpx;
}

.tbx_legal_heading {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--tbx-ink);
}

.tbx_legal_paragraph {
  display: block;
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 1.85;
  color: var(--tbx-ink-2);
}

.tbx_legal_list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 14rpx;
}

.tbx_legal_item {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--tbx-ink-2);
}

.tbx_legal_dot {
  width: 8rpx;
  height: 8rpx;
  margin-top: 14rpx;
  border-radius: 999rpx;
  background-color: var(--tbx-accent);
  flex-shrink: 0;
}

.tbx_legal_key {
  font-size: 23rpx;
  color: var(--tbx-ink-3);
  font-variant-numeric: tabular-nums;
}

/* ---- 图片工具 ---- */
.tbx_media_stage {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 320rpx;
  border-radius: var(--tbx-radius);
  background-color: var(--tbx-surface-2);
  border: 1rpx solid var(--tbx-line);
  overflow: hidden;
  box-sizing: border-box;
}

.tbx_media_blank {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 56rpx 24rpx;
}

.tbx_media_blank_icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--tbx-accent-soft);
  border: 1rpx solid var(--tbx-accent-border);
}

.tbx_media_blank_title {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--tbx-ink);
}

.tbx_media_blank_sub {
  font-size: 21rpx;
  color: var(--tbx-ink-3);
  text-align: center;
}

.tbx_media_loading {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  background-color: rgba(10, 16, 13, 0.48);
  color: #f2f7f4;
  font-size: 23rpx;
}

.tbx_spinner_media {
  width: 44rpx;
  height: 44rpx;
  border-radius: 999rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.38);
  border-top-color: #f2f7f4;
  animation: tbx-media-spin 0.8s linear infinite;
}

@keyframes tbx-media-spin {
  to {
    transform: rotate(360deg);
  }
}

.tbx_compress_meta {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 16rpx;
}

/* ---- 动效：只做 180ms 透明度 / 位移 ---- */
@keyframes tbx-rise {
  from {
    opacity: 0;
    transform: translateY(14rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.tbx_anim {
  animation: tbx-rise 0.18s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

.tbx_anim_1 {
  animation-delay: 0.04s;
}

.tbx_anim_2 {
  animation-delay: 0.08s;
}

.tbx_anim_3 {
  animation-delay: 0.12s;
}

/* ==========================================================================
   V3 工具页 slot · 纸面仪表台内胆
   只作用于 .v3_shell，旧页面不受影响
   ========================================================================== */
.v3_input .tbx_card {
  padding: 0;
  border: 0;
  border-radius: 0;
  background-color: transparent;
  box-shadow: none;
}

.v3_input .tbx_seg {
  gap: 8rpx;
}

.v3_input .tbx_seg_item {
  height: 80rpx;
  padding: 0 22rpx;
  border-radius: 4rpx;
  background-color: transparent;
  border: 1rpx solid var(--v3-line);
  color: var(--v3-ink-3);
  font-size: 24rpx;
  font-weight: 600;
}

.v3_input .tbx_seg_active {
  background-color: var(--v3-ink);
  border-color: var(--v3-ink);
  color: #ffffff;
}

.v3_input.theme-dark .tbx_seg_active {
  background-color: var(--v3-cat);
  border-color: var(--v3-cat);
  color: var(--v3-cat-on);
}

.v3_input .tbx_label {
  font-family: var(--v3-mono);
  font-size: 18rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  color: var(--v3-ink-3);
}

.v3_input .tbx_label_note {
  font-family: var(--v3-mono);
  font-size: 17rpx;
  color: var(--v3-ink-3);
}

.v3_input .tbx_field {
  gap: 8rpx;
  margin-bottom: 0;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--v3-line);
}

.v3_input .tbx_field:last-child {
  border-bottom: 0;
}

.v3_input .tbx_input,
.v3_input .tbx_textarea,
.v3_input .tbx_picker {
  padding-left: 0;
  padding-right: 0;
  border: 0;
  border-bottom: 1rpx solid var(--v3-line);
  border-radius: 0;
  background-color: transparent;
}

.v3_input .tbx_input {
  min-height: 88rpx;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: -0.6rpx;
  color: var(--v3-ink);
}

.v3_input .tbx_textarea {
  min-height: 220rpx;
  font-size: 26rpx;
  line-height: 1.65;
  color: var(--v3-ink);
}

.v3_input .tbx_picker {
  font-size: 32rpx;
}

.v3_input .tbx_picker_text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--v3-ink);
}

.v3_input .tbx_input_row {
  border-bottom: 1rpx solid var(--v3-line);
}

.v3_input .tbx_input_row .tbx_input {
  border-bottom: 0;
}

.v3_input .tbx_btn {
  border-radius: 4rpx;
}

.v3_input .tbx_label_note,
.v3_input .tbx_hint,
.v3_input .tbx_formula {
  font-family: var(--v3-mono);
  font-size: 17rpx;
  line-height: 1.6;
  color: var(--v3-ink-3);
}

/* ==========================================================================
   V3 结果结构 · 读数 / 明细 / 仪表
   结果 slot 不再使用旧 tbx_result_card 嵌套卡结构
   slot 跨组件边界，令牌在页面域再声明一次，保证日夜与分类色可用
   ========================================================================== */
.v3_tool_root {
  position: relative;
  display: block;
  width: 100%;
  height: 100vh;
  background-color: #f4f5f1;
  color: #0d0d0f;
}

.v3_tool_root.theme-dark {
  background-color: #0a0a0c;
  color: #f4f5f1;
}


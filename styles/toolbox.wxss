  --v3-surface: #151518;
  --v3-surface-2: #1d1d21;
  --v3-ink: #f4f5f1;
  --v3-ink-2: #b8b8bf;
  --v3-ink-3: #8a8a92;
  --v3-line: rgba(255, 255, 255, 0.12);
  --v3-line-2: rgba(255, 255, 255, 0.24);
  --v3-ro-accent: var(--v3-cat);
  --v3-ro-fill-bg: #f4f5f1;
  --v3-ro-fill-ink: #0a0a0c;
  --g-on-fill: #0a0a0c;
}

.v3_result.v3_cat_calc,
.v3_input.v3_cat_calc,
.v3_note.v3_cat_calc {
  --v3-cat: #ff4d24;
  --v3-cat-ink: #c93a14;
  --v3-cat-on: #0a0a0c;
}

.v3_result.v3_cat_date,
.v3_input.v3_cat_date,
.v3_note.v3_cat_date {
  --v3-cat: #2f4bff;
  --v3-cat-ink: #2438cc;
  --v3-cat-on: #ffffff;
}

.v3_result.v3_cat_text,
.v3_input.v3_cat_text,
.v3_note.v3_cat_text {
  --v3-cat: #d8ff3e;
  --v3-cat-ink: #5f7a00;
  --v3-cat-on: #0a0a0c;
}

.v3_result.v3_cat_media,
.v3_input.v3_cat_media,
.v3_note.v3_cat_media {
  --v3-cat: #f0336b;
  --v3-cat-ink: #c1225a;
  --v3-cat-on: #ffffff;
}

.v3_result.v3_cat_life,

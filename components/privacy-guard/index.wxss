/* ==========================================================================
   privacy-guard · 隐私授权弹窗
   - 全屏遮罩 + 中央玻璃卡
   - 同意按钮必须保持原生 <button open-type="agreePrivacyAuthorization">
   ========================================================================== */

.privacy-guard {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1200;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 40rpx;
}

.privacy-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background-color: var(--glass-scrim);
}

.privacy-card {
  position: relative;
  z-index: 1;
  display: block;
  width: calc(100vw - 80rpx);
  max-width: 640rpx;
  box-sizing: border-box;
}

.privacy-head {
  display: flex;
  flex-direction: column;
}

.privacy-kicker {
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 18rpx;
  letter-spacing: 0.14em;
}

.privacy-title {
  margin-top: 12rpx;
  color: var(--glass-text);
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.25;
}

.privacy-desc {
  margin-top: 14rpx;
  color: var(--glass-text-2);
  font-size: 25rpx;
  line-height: 1.75;
}

.privacy-points {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 22rpx;
}

.privacy-point {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 12rpx;
}

.privacy-point__dot {
  flex: 0 0 auto;
  width: 9rpx;
  height: 9rpx;
  margin-top: 14rpx;
  border-radius: 999rpx;
  background-color: var(--glass-accent);
  box-shadow: 0 0 12rpx var(--glass-accent-soft);
}

.privacy-point__text {
  flex: 1;
  min-width: 0;
  color: var(--glass-text-2);
  font-size: 24rpx;
  line-height: 1.7;
}

.privacy-actions {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 28rpx;
}

/* 原生按钮重置：只保留玻璃材质，不出现系统黑色边框 */
.privacy-action {
  width: 100%;
  height: 88rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border-radius: 999rpx;
  font-family: var(--glass-font-sans);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 88rpx;
  text-align: center;
  transition:
    transform 180ms ease,
    opacity 180ms ease,
    background-color 180ms ease;
}

.privacy-action::after {
  border: none;
}

.privacy-action--agree {
  color: var(--glass-text);
  background-color: var(--glass-accent-soft);
  background-image: linear-gradient(
    135deg,
    var(--glass-accent-soft),
    var(--glass-accent-2-soft) 55%,
    var(--glass-accent-warm-soft)
  );
  border: 1rpx solid var(--glass-border-strong);
  box-shadow:
    inset 0 1rpx 0 var(--glass-highlight),
    0 10rpx 26rpx var(--glass-accent-soft);
}

.privacy-action--disagree {
  color: var(--glass-text-3);
  background-color: transparent;
  border: 1rpx solid var(--glass-border);
}

.privacy-action--press {
  transform: scale(0.97);
  opacity: 0.86;
}

.privacy-link {
  display: block;
  margin-top: 18rpx;
  color: var(--glass-accent-text);
  font-size: 22rpx;
  font-size: calc(22rpx * var(--fs-scale, 1));
  line-height: 1.6;
  text-align: center;
}

.privacy-link--press {
  opacity: 0.72;
}

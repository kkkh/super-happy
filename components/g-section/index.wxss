/* g-section · 发丝线 + 编号式题字 */
.section {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
}

.section_rule {
  width: 32rpx;
  height: 2rpx;
  background-color: var(--g-iris);
}

.section_text {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 16rpx;
}

.section_kicker {
  font-size: 20rpx;
  color: var(--g-iris);
  letter-spacing: 3rpx;
  font-weight: 600;
}

.section_title {
  font-size: 34rpx;
  color: var(--g-ink);
  font-weight: 700;
  letter-spacing: 2rpx;
}

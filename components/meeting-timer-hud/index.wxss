/* ==========================================================================
   会议倒计时 HUD · 浮动胶囊
   - 只使用 --glass-* 令牌；不遮挡底部 TabBar 与结果操作
   ========================================================================== */

.mth {
  position: fixed;
  z-index: 1200;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
  box-sizing: border-box;
  padding: 12rpx 20rpx;
  border: 1rpx solid var(--glass-border-strong);
  border-radius: 999rpx;
  background-color: var(--glass-bg-strong);
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.18);
}

.mth__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: var(--glass-accent);
}

.mth--paused .mth__dot {
  background-color: var(--glass-warn, #d97706);
}

.mth--finished .mth__dot {
  background-color: var(--glass-warn, #d97706);
}

.mth__label {
  color: var(--glass-text-3);
  font-size: 18rpx;
  letter-spacing: 0.08em;
}

.mth__time {
  color: var(--glass-text);
  font-family: var(--glass-font-mono);
  font-size: 24rpx;
  letter-spacing: 0.04em;
}

.mth__state {
  color: var(--glass-text-3);
  font-size: 17rpx;
}

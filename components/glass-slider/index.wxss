/* ==========================================================================
   glass-slider · 极光玻璃滑轨
   - 半透明玻璃凹槽 + 极光渐变已走过区域
   - 拖动时 transition: none，保证跟手；松手恢复弹簧吸附
   - 触摸区高度 88rpx，视觉轨道仅 12rpx，兼顾手感与精致度
   ========================================================================== */

.glass-slider {
  display: block;
  width: 100%;
  box-sizing: border-box;
}

.glass-slider__head {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.glass-slider__caption {
  color: var(--glass-text-2, rgba(255, 255, 255, 0.8));
  font-size: 24rpx;
}

.glass-slider__value {
  color: var(--glass-text, #ffffff);
  font-family: var(--glass-font-mono, monospace);
  font-size: 24rpx;
  font-weight: 600;
}

.glass-slider__stage {
  display: block;
  width: 100%;
  padding: 28rpx 0 0;
  box-sizing: border-box;
}

.glass-slider__track {
  position: relative;
  width: 100%;
  height: 12rpx;
  border-radius: 8rpx;
  background-color: var(--glass-bg-soft, rgba(255, 255, 255, 0.08));
  background-image: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0.22) 0%,
    rgba(255, 255, 255, 0.1) 100%
  );
  box-shadow:
    inset 0 2rpx 6rpx rgba(0, 0, 0, 0.28),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}

.glass-slider__fill {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  border-radius: 8rpx;
  background-image: linear-gradient(
    90deg,
    var(--sg-iris, #6d78ff) 0%,
    var(--sg-ambient-iris, #9f7cff) 48%,
    var(--sg-mint, #5fdcc7) 100%
  );
  box-shadow: 0 0 22rpx var(--sg-chromatic-glow, rgba(120, 136, 255, 0.36));
  transition: width var(--glass-duration-base, 280ms)
    cubic-bezier(0.25, 0.8, 0.25, 1);
}

.glass-slider__thumb {
  position: absolute;
  top: 50%;
  width: 44rpx;
  height: 44rpx;
  margin-left: -22rpx;
  transform: translate3d(0, -50%, 0);
  transition:
    left var(--glass-duration-base, 280ms) cubic-bezier(0.25, 0.8, 0.25, 1),
    transform var(--glass-duration-fast, 180ms) cubic-bezier(0.25, 0.8, 0.25, 1);
  will-change: left, transform;
}

.glass-slider__thumb--dragging {
  transition: none;
}

.glass-slider__thumb--dragging .glass-slider__thumb-core {
  transform: scale(1.12);
}

.glass-slider__thumb-core {
  position: absolute;
  top: 2rpx;
  left: 2rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-image: linear-gradient(
    145deg,
    #ffffff 0%,
    rgba(236, 241, 255, 0.94) 46%,
    rgba(184, 200, 255, 0.84) 100%
  );
  box-shadow:
    inset 0 2rpx 3rpx rgba(255, 255, 255, 0.92),
    0 6rpx 18rpx rgba(6, 8, 18, 0.32),
    0 0 18rpx rgba(159, 124, 255, 0.6);
  transition: transform var(--glass-duration-fast, 180ms)
    cubic-bezier(0.25, 0.8, 0.25, 1);
}

.glass-slider__thumb-halo {
  position: absolute;
  top: -8rpx;
  left: -8rpx;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background-image: radial-gradient(
    circle,
    rgba(159, 124, 255, 0.36) 0%,
    transparent 68%
  );
  opacity: 0.86;
  pointer-events: none;
}

.glass-slider__marks {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin-top: 14rpx;
  padding: 0 2rpx;
  box-sizing: border-box;
}

.glass-slider__mark {
  color: var(--glass-text-3, rgba(255, 255, 255, 0.46));
  font-family: var(--glass-font-mono, monospace);
  font-size: 20rpx;
  letter-spacing: 0.06em;
  transition: color var(--glass-duration-base, 280ms)
    cubic-bezier(0.25, 0.8, 0.25, 1);
}

.glass-slider__mark--active {
  color: var(--glass-text, #ffffff);
  text-shadow: 0 0 12rpx var(--sg-chromatic-glow, rgba(120, 136, 255, 0.32));
}

.glass-slider--disabled {
  opacity: 0.42;
}

/* ---- 系统减少动态偏好 ---- */
@media (prefers-reduced-motion: reduce) {
  .glass-slider__fill,
  .glass-slider__thumb,
  .glass-slider__thumb-core,
  .glass-slider__mark {
    transition-duration: 1ms;
  }
}

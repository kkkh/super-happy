/* ==========================================================================
   glass-modal · 居中玻璃确认层
   - 遮罩纯色、卡片单层 blur，避免双层 backdrop-filter 掉帧
   - 动画只使用 transform / opacity，走 GPU 合成
   ========================================================================== */

.glass-modal {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
  font-family: var(--glass-font-sans);
  pointer-events: none;
}

.glass-modal__mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background-color: var(--glass-scrim);
  opacity: 0;
  transition: opacity 220ms var(--glass-ease-out);
  pointer-events: auto;
}

.glass-modal_active .glass-modal__mask {
  opacity: 1;
}

.glass-modal__panel {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 620rpx;
  padding: 48rpx 40rpx 36rpx;
  box-sizing: border-box;
  overflow: hidden;
  border: 1rpx solid var(--glass-border);
  border-radius: 40rpx;
  background-color: var(--glass-bg-strong);
  box-shadow:
    var(--glass-shadow),
    inset 0 1rpx 0 var(--glass-highlight);
  -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
  backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
  opacity: 0;
  transform: translate3d(0, 16rpx, 0) scale(0.92);
  transition:
    opacity 220ms var(--glass-ease-out),
    transform 260ms var(--glass-ease-spring);
  pointer-events: auto;
  will-change: transform, opacity;
}

.glass-modal_active .glass-modal__panel {
  opacity: 1;
  transform: translate3d(0, 0, 0) scale(1);
}

/* ---- 材质层 ---- */
.glass-modal__sheen {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  border-radius: inherit;
  background-image: var(--glass-sheen);
  opacity: 0.28;
  pointer-events: none;
}

.glass-modal__noise {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2;
  border-radius: inherit;
  background-image: var(--glass-noise-image);
  background-size: var(--glass-noise-size);
  opacity: var(--glass-noise-opacity);
  mix-blend-mode: soft-light;
  pointer-events: none;
}

/* ---- 内容 ---- */
.glass-modal__body {
  position: relative;
  z-index: 3;
  display: flex;
  flex-direction: column;
  padding-bottom: 36rpx;
}

.glass-modal__title {
  color: var(--glass-text);
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.35;
  letter-spacing: 0.4rpx;
}

.glass-modal__desc {
  margin-top: 18rpx;
  color: var(--glass-text-2);
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.6;
  word-break: break-all;
}

/* ---- 可选第三操作：轻量文字链，不与主按钮抢视觉 ---- */
.glass-modal__extra {
  position: relative;
  z-index: 3;
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  margin: 0 0 30rpx;
  padding: 6rpx 0;
}

.glass-modal__extra_press {
  opacity: 0.62;
}

.glass-modal__extra-text {
  color: var(--glass-accent);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.4;
  letter-spacing: 0.02em;
}

.glass-modal__extra-arrow {
  margin-left: 8rpx;
  color: var(--glass-accent);
  font-size: 24rpx;
  line-height: 1;
}

.glass-modal__actions {
  position: relative;
  z-index: 3;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* ---- 低端机 / 不支持滤镜降级 ---- */
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .glass-modal__panel {
    background-color: var(--glass-bg-solid, var(--glass-bg-strong));
    box-shadow:
      var(--glass-shadow-soft, var(--glass-shadow)),
      inset 0 1rpx 0 var(--glass-highlight);
  }
}

/* ---- 减少动态偏好 ---- */
@media (prefers-reduced-motion: reduce) {
  .glass-modal__mask,
  .glass-modal__panel {
    transition-duration: 1ms;
  }
}

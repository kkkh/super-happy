/* g-navbar · 沉浸玻璃导航 */
.nav {
  position: relative;
  z-index: 30;
  width: 100%;
  flex-shrink: 0;
}

.nav_glass {
  background-color: var(--g-elevated);
  border-bottom: 1rpx solid var(--g-stroke);
}

.nav_clear {
  background-color: transparent;
}

.nav_bare {
  background-color: transparent;
}

.nav_bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 24rpx;
}

/* 左槽 */
.nav_back {
  width: 88rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  transition:
    transform 0.18s cubic-bezier(0.2, 0.9, 0.25, 1),
    opacity 0.18s cubic-bezier(0.2, 0.9, 0.25, 1);
}

/* 题字 */
.nav_title_wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav_title {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 34rpx;
  font-size: calc(34rpx * var(--fs-scale, 1));
  font-weight: 600;
  color: var(--g-ink);
  letter-spacing: 2rpx;
}

/* 右槽 */
.nav_right {
  width: 88rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.nav_theme {
  width: 80rpx;
  height: 80rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--g-surface);
  border: 1rpx solid var(--g-stroke);
  transition:
    transform 0.18s cubic-bezier(0.2, 0.9, 0.25, 1),
    opacity 0.18s cubic-bezier(0.2, 0.9, 0.25, 1);
}

.nav_touch {
  opacity: 0.7;
  transform: scale(0.94);
}

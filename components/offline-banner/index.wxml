<view
  wx:if="{{visible}}"
  class="ob ob--{{variant}} ob--{{mode}} {{expanded ? 'ob--expanded' : 'ob--compact'}}"
  style="{{topStyle}}"
  catchtap="onTap"
  aria-role="button"
  aria-live="polite"
  aria-label="{{mode === 'recovered' ? '网络已恢复' : (expanded ? '当前网络不可用，部分联网功能受限' : '当前离线，点击查看')}}"
>
  <view class="ob__dot" aria-hidden="true"></view>
  <text class="ob__text">{{mode === 'recovered' ? '网络已恢复' : (expanded ? '当前离线 · 部分联网功能受限' : '离线')}}</text>
</view>

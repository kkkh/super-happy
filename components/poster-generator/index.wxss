/* ==========================================================================
   poster-generator · 隐藏绘制画布
   - 只在实际生成时挂载，避免常驻 480x720 高分辨率层
   - 模拟器会跳过视口外节点的绘制，导出容易得到灰底；
     改为视口内 1% 透明度布置，确保 Canvas 真正参与渲染
   - 不拦截交互，层级低于预览弹层
   ========================================================================== */
.poster-canvas {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 0;
  width: 480px;
  height: 720px;
  opacity: 0.01;
  pointer-events: none;
}

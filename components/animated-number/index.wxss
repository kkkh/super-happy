/* ==========================================================================
   animated-number · WXS 阻尼滚动数字
   - 数字使用等宽字形，避免滚动时宽度抖动
   - 只消费 --glass-* 令牌
   ========================================================================== */

.animated-number {
  --number-accent: var(--glass-text);
  --number-soft: transparent;

  position: relative;
  display: inline-flex;
  align-items: baseline;
  color: var(--number-accent);
  font-family: var(--glass-font-mono);
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -0.01em;
  font-variant-numeric: tabular-nums;
  text-shadow: 0 0 28rpx var(--number-soft);
  transition: color var(--glass-duration-base) var(--glass-ease-out);
  isolation: isolate;
}

.animated-number__value {
  position: relative;
  z-index: 1;
  display: inline-block;
  white-space: nowrap;
}

/* ---- 尾数微光：只覆盖右侧尾数区，动画时闪烁 ---- */
.animated-number__shimmer {
  position: absolute;
  top: -0.08em;
  right: -0.04em;
  bottom: -0.08em;
  z-index: 2;
  width: 38%;
  pointer-events: none;
  border-radius: 12rpx;
  background-image: linear-gradient(
    90deg,
    transparent 0%,
    var(--number-soft) 38%,
    var(--sg-light-strong, rgba(255, 255, 255, 0.7)) 52%,
    var(--number-soft) 66%,
    transparent 100%
  );
  opacity: 0;
  transform: translate3d(-20%, 0, 0);
  mix-blend-mode: screen;
  will-change: transform, opacity;
}

.animated-number_animating .animated-number__shimmer {
  animation: animated-number-tail 980ms ease-in-out infinite;
}

@keyframes animated-number-tail {
  0% {
    opacity: 0;
    transform: translate3d(-24%, 0, 0);
  }
  38% {
    opacity: 0.82;
  }
  100% {
    opacity: 0;
    transform: translate3d(26%, 0, 0);
  }
}

/* ---- 字号 ---- */
.animated-number_size_sm {
  font-size: 32rpx;
  line-height: 1.15;
}

.animated-number_size_md {
  font-size: 44rpx;
  line-height: 1.1;
}

.animated-number_size_lg {
  font-size: 64rpx;
  line-height: 1.05;
}

.animated-number_size_xl {
  font-size: 88rpx;
  line-height: 1;
}

/* ---- 色调 ---- */
.animated-number_tone_neutral {
  --number-accent: var(--glass-text);
  --number-soft: transparent;
}

.animated-number_tone_iris {
  --number-accent: var(--glass-accent);
  --number-soft: var(--glass-accent-soft);
}

.animated-number_tone_aurora {
  --number-accent: var(--glass-accent-2);
  --number-soft: var(--glass-accent-2-soft);
}

.animated-number_tone_amber {
  --number-accent: var(--glass-accent-warm);
  --number-soft: var(--glass-accent-warm-soft);
}

/* ---- 低端机降级 ---- */
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .animated-number {
    text-shadow: none;
  }

  .animated-number__shimmer {
    display: none;
  }
}

/* ---- 减少动态偏好 ---- */
@media (prefers-reduced-motion: reduce) {
  .animated-number {
    text-shadow: none;
  }

  .animated-number__shimmer {
    display: none;
  }
}

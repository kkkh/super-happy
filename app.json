  "requiredBackgroundModes": [
    "audio"
  ],
  "tabBar": {
    "custom": true,
    "color": "#6F6F76",
    "selectedColor": "#0D0D0F",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "工具"
      },
      {
        "pagePath": "pages/favorites/index",
        "text": "收藏"
      },
      {
        "pagePath": "pages/mine/index",
        "text": "我的"
      }
    ]
  },
  "usingComponents": {
    "update-guard": "/components/update-guard/index",
    "meeting-timer-hud": "/components/meeting-timer-hud/index"
  },
  "window": {
    "navigationStyle": "custom",
    "pageOrientation": "portrait",
    "backgroundColor": "@canvas",
    "backgroundColorTop": "@canvas",
    "backgroundColorBottom": "@canvas",
    "backgroundTextStyle": "dark",
    "navigationBarTextStyle": "@navText"
  },
  "permission": {
    "scope.userFuzzyLocation": {
      "desc": "用于定位当前城市并展示本地天气"
    }
  },
  "requiredPrivateInfos": [
    "getFuzzyLocation"
  ],
  "darkmode": true,
  "__usePrivacyCheck__": true,
  "themeLocation": "theme.json",
  "renderer": "skyline",
  "componentFramework": "glass-easel",
  "lazyCodeLoading": "requiredComponents",
  "rendererOptions": {
    "skyline": {
      "defaultDisplayBlock": true,
      "defaultContentBox": true,
      "disableABTest": true
    }
  },
  "workers": "workers",
  "sitemapLocation": "sitemap.json"
}

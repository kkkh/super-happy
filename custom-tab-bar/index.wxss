/* ==========================================================================
   custom-tab-bar · 液态玻璃 Dock
   - 删除旧版黑色描边与纯白纸面
   - 半透明玻璃底 + 24px 模糊 + 200% 饱和 + 白色内高光
   ========================================================================== */

/* TabBar 在页面根节点之外，必须在组件内重复声明字号档类 */
.fs-standard {
  --fs-scale: 1;
}

.fs-large {
  --fs-scale: 1.15;
}

.fs-xlarge {
  --fs-scale: 1.3;
}

.dock {
  /* Skyline 自定义 tabBar：根节点必须 absolute + pointer-events:auto */
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: center;
  padding-top: 0;
  padding-right: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  padding-left: 24rpx;
  box-sizing: border-box;
  background-color: transparent;
  pointer-events: auto;
}

.dock__pill {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 660rpx;
  min-height: 108rpx;
  padding-top: 8rpx;
  padding-right: 10rpx;
  padding-bottom: 8rpx;
  padding-left: 10rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.46);
  border-radius: 56rpx;
  background-color: rgba(255, 255, 255, 0.4);
  -webkit-backdrop-filter: blur(30px) saturate(200%);
  backdrop-filter: blur(30px) saturate(200%);
  box-shadow:
    inset 0 1px 2px rgba(255, 255, 255, 0.8),
    0 10px 30px rgba(0, 0, 0, 0.1);
  pointer-events: auto;
  transition:
    background-color 320ms cubic-bezier(0.2, 0.9, 0.25, 1),
    border-color 320ms cubic-bezier(0.2, 0.9, 0.25, 1),
    box-shadow 320ms cubic-bezier(0.2, 0.9, 0.25, 1);

  /* 文字保持深色语义，保证玻璃底上的对比度 */
  --g-ink: #0d0d0f;
  --g-ink-3: #565660;
}

/* ---- 夜航 Dock：深玻璃胶囊，与夜色同源 ---- */
.dock_dark .dock__pill {
  border-color: rgba(255, 255, 255, 0.16);
  background-color: rgba(12, 16, 26, 0.62);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.16),
    0 16px 40px rgba(0, 0, 0, 0.5);
  --g-ink: #f4f6fb;
  --g-ink-3: #a7b0c2;
}

.dock_dark .dock__item {
  color: rgba(214, 220, 235, 0.66);
}

.dock_dark .dock__item--active {
  background-color: rgba(255, 255, 255, 0.12);
  color: #b9c0ff;
  text-shadow: 0 0 16rpx rgba(140, 150, 255, 0.45);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.2),
    0 0 22rpx rgba(120, 130, 255, 0.25);
}

.dock_dark .dock__item--active .dock__dot {
  background-color: rgba(185, 192, 255, 0.9);
}

.dock__item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 88rpx;
  border-radius: 44rpx;
  background-color: transparent;
  color: #565660;
  font-size: 22rpx;
  font-size: calc(22rpx * var(--fs-scale, 1));
  font-weight: 600;
  letter-spacing: 1rpx;
  pointer-events: auto;
  transition:
    transform 0.18s cubic-bezier(0.2, 0.9, 0.25, 1),
    opacity 0.18s cubic-bezier(0.2, 0.9, 0.25, 1),
    background-color 0.18s cubic-bezier(0.2, 0.9, 0.25, 1),
    color 0.18s cubic-bezier(0.2, 0.9, 0.25, 1);
}

.dock__item--active {
  background-color: rgba(255, 255, 255, 0.5);
  color: rgba(94, 92, 230, 0.95);
  text-shadow: 0 0 16rpx rgba(120, 110, 255, 0.35);
  box-shadow:
    inset 0 1px 2px rgba(255, 255, 255, 0.9),
    0 0 18rpx rgba(120, 110, 255, 0.22);
}

.dock__icon--active {
  filter: drop-shadow(0 0 8rpx rgba(120, 110, 255, 0.45));
}

.dock__item--press {
  opacity: 0.72;
  transform: scale(0.97);
}

.dock__text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 22rpx;
  font-size: calc(22rpx * var(--fs-scale, 1));
  font-weight: 600;
  letter-spacing: 1rpx;
  /* Skyline 下 <text> 不继承父级 color，必须显式给出 */
  color: #565660;
}

.dock__item--active .dock__text {
  color: rgba(94, 92, 230, 0.95);
}

.dock_dark .dock__text {
  color: rgba(214, 220, 235, 0.66);
}

.dock_dark .dock__item--active .dock__text {
  color: #b9c0ff;
}

.dock__dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background-color: transparent;
}

.dock__item--active .dock__dot {
  background-color: rgba(80, 70, 200, 0.65);
}

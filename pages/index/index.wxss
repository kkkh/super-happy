/* ==========================================================================
   pages/index · 液态玻璃首页
   - 页面级重写材质变量：低不透明度 + 强模糊 + 强饱和
   - 顶部主卡为独立液态玻璃面，不再使用 3D 倾斜
   - 所有卡片统一白色内高光 + 悬浮投影
   ========================================================================== */

.home-page {
  position: relative;
  height: 100vh;
  box-sizing: border-box;
  color: var(--glass-text);
  font-family: var(--glass-font-sans);
  overflow: hidden;
  background-color: var(--glass-canvas);
}

/* 页面级材质：昼为通透白玻璃，夜为吸光黑曜玻璃 —— 不允许固定成浅色 */
.home-page.theme-light {
  --glass-bg: rgba(255, 255, 255, 0.18);
  --glass-bg-soft: rgba(255, 255, 255, 0.12);
  --glass-bg-strong: rgba(255, 255, 255, 0.26);
  --glass-border: rgba(255, 255, 255, 0.42);
  --glass-blur: 24px;
  --glass-saturate: 200%;
  --glass-shadow-soft: inset 0 1px 2px rgba(255, 255, 255, 0.8),
    0 10px 30px rgba(0, 0, 0, 0.1);
}

.home-page.theme-dark {
  --glass-bg: rgba(13, 17, 26, 0.56);
  --glass-bg-soft: rgba(13, 17, 26, 0.36);
  --glass-bg-strong: rgba(20, 25, 38, 0.76);
  --glass-border: rgba(255, 255, 255, 0.14);
  --glass-highlight: rgba(255, 255, 255, 0.2);
  --glass-blur: 28px;
  --glass-saturate: 180%;
  --glass-shadow-soft: inset 0 1px 0 rgba(255, 255, 255, 0.18),
    0 16px 40px rgba(0, 0, 0, 0.42);
}

/* Skyline 页面本身不滚动，必须由 scroll-view 接管滚动 */
.home-scroll {
  position: relative;
  z-index: 1;
  height: 100vh;
}

.home-scroll__inner {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding-top: calc(env(safe-area-inset-top) + 56rpx);
  padding-left: 32rpx;
  padding-right: 32rpx;
  /* Dock 高约 54px：120px 兜底，保证最后一项绝不遮挡 */
  padding-bottom: calc(120px + env(safe-area-inset-bottom));
}

/* ---- 底层彩色高光：亮紫 / 亮蓝 / 品红，80px 高斯散开 ---- */
.home-aurora {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}

.home-aurora__a {
  position: absolute;
  top: -18%;
  left: -30%;
  width: 104%;
  height: 62%;
}

.home-aurora__b {
  position: absolute;
  top: 2%;
  right: -34%;
  width: 100%;
  height: 60%;
}

.home-aurora__c {
  position: absolute;
  bottom: -22%;
  left: -10%;
  width: 110%;
  height: 64%;
}

.home-top {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  margin-bottom: 30rpx;
}

.home-title {
  margin-top: 0;
  color: var(--glass-text);
  font-size: 56rpx;
  font-size: calc(56rpx * var(--fs-scale, 1));
  font-weight: 700;
  line-height: 1.12;
}

.home-desc {
  margin-top: 14rpx;
  color: var(--glass-text-2);
  font-size: 25rpx;
  font-size: calc(25rpx * var(--fs-scale, 1));
  line-height: 1.55;
}

/* ---- 顶部液态玻璃主卡 ---- */
.home-hero-card {
  position: relative;
  z-index: 1;
  overflow: hidden;
  box-sizing: border-box;
  margin-bottom: 30rpx;
  padding-top: 40rpx;
  padding-right: 36rpx;
  padding-bottom: 36rpx;
  padding-left: 36rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: 40rpx;
  background-color: var(--glass-bg);
  -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
  backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
  box-shadow: var(--glass-shadow-soft);
}

.home-hero-glow {
  position: absolute;
  top: -46%;
  left: -18%;
  width: 82%;
  height: 128%;
  border-radius: 50%;
  background-color: rgba(168, 120, 255, 0.45);
  filter: blur(80px);
  pointer-events: none;
}

/* 夜航：主卡内紫光收一档，避免深底上发灰 */
.home-page.theme-dark .home-hero-glow {
  background-color: rgba(148, 116, 255, 0.28);
}

.home-hero-copy {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
}

.home-hero-title {
  margin-top: 0;
  color: var(--glass-text);
  font-size: 44rpx;
  font-size: calc(44rpx * var(--fs-scale, 1));
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: 0.01em;
}

/* ---- 首页数据看板：左主右辅的 Bento 错落布局 ---- */
.home-hero-bento {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 28rpx;
  margin-top: 30rpx;
}

/* 主数据：去框化，让数字直接悬浮在毛玻璃上 */
.home-hero-primary {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  align-items: flex-start;
  animation: home-stat-in 520ms var(--glass-ease-spring) both;
}

.home-hero-primary__value {
  color: var(--glass-text);
  font-size: 148rpx;
  font-weight: 700;
  line-height: 0.82;
  letter-spacing: -0.04em;
  font-variant-numeric: proportional-nums;
}

.home-hero-primary__label {
  margin-top: 16rpx;
  color: var(--glass-text-3);
  font-size: 21rpx;
  font-size: calc(21rpx * var(--fs-scale, 1));
  font-weight: 500;
  line-height: 1.2;
  letter-spacing: 0.24em;
}

/* 副数据：右侧紧凑收拢，只做层级衬托 */
.home-hero-secondary {
  display: flex;
  flex-shrink: 0;
  flex-direction: column;
  align-items: flex-end;
  gap: 22rpx;
  min-width: 148rpx;
  padding-bottom: 4rpx;
  animation: home-stat-in 520ms var(--glass-ease-spring) 80ms both;
}

.home-hero-mini {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.home-hero-mini__value {
  color: var(--glass-text-2);
  font-family: var(--glass-font-sans);
  font-size: 46rpx;
  font-weight: 600;
  line-height: 1;
  letter-spacing: -0.01em;
  font-variant-numeric: tabular-nums;
}

.home-hero-mini__label {
  margin-top: 7rpx;
  color: var(--glass-text-3);
  font-size: 19rpx;
  font-size: calc(19rpx * var(--fs-scale, 1));
  font-weight: 500;
  line-height: 1.2;
  letter-spacing: 0.08em;
}

/* 累计打开：保留机械滚轮，尺寸收窄到副数据尺度 */
.home-hero-mini__value_roll {
  display: flex;
  align-items: flex-start;
  transform-origin: right center;
}

.home-roll-stage {
  display: flex;
  align-items: flex-start;
  height: 48rpx;
  overflow: hidden;
}

/* 数字跳变时轻微弹性缩放，和滚轮同一节奏 */
.home-hero-mini__value_bounce {
  animation: home-number-bounce 620ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes home-number-bounce {
  0% {
    transform: scale(1, 1);
  }

  28% {
    transform: scale(1.06, 0.985);
  }

  56% {
    transform: scale(0.99, 1.012);
  }

  100% {
    transform: scale(1, 1);
  }
}

.home-roll-digit {
  position: relative;
  width: 0.62em;
  height: 48rpx;
  overflow: hidden;
  text-align: center;
  letter-spacing: 0;
}

.home-roll-digit__track {
  display: flex;
  flex-direction: column;
  transition: transform 620ms cubic-bezier(0.22, 1, 0.36, 1);
  will-change: transform;
}

.home-roll-digit__num {
  display: block;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
}

@keyframes home-stat-in {
  0% {
    opacity: 0;
    transform: translateY(14rpx) scale(0.96);
  }

  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* 底部按钮：收缩为小胶囊，贴底留白 */
.home-hero-actions {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 14rpx;
  margin-top: 38rpx;
}

.home-hero-action {
  flex: 0 0 auto;
  width: auto;
  min-width: 184rpx;
}

/* ---- 搜索：单层玻璃药丸，外层即输入容器 ---- */
.home-search {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  margin-bottom: 34rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
  border-radius: 999rpx;
  background-color: var(--glass-bg-soft);
  -webkit-backdrop-filter: blur(var(--glass-blur));
  backdrop-filter: blur(var(--glass-blur));
  box-shadow: var(--glass-shadow-soft);
  transition:
    transform 180ms cubic-bezier(0.2, 0.9, 0.25, 1),
    background-color 180ms cubic-bezier(0.2, 0.9, 0.25, 1),
    box-shadow 180ms cubic-bezier(0.2, 0.9, 0.25, 1);
}

/* 点击 / 聚焦：液态玻璃高光扫过，模糊与饱和保持不变 */
.home-search_pressed,
.home-search_focused {
  transform: scale(0.994);
  background-color: rgba(255, 255, 255, 0.18);
  background-image: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.58) 0%,
    rgba(255, 255, 255, 0.2) 34%,
    rgba(255, 255, 255, 0) 62%
  );
  box-shadow:
    inset 0 1px 2px rgba(255, 255, 255, 0.94),
    inset 0 0 0 1px rgba(255, 255, 255, 0.4),
    0 6px 16px rgba(0, 0, 0, 0.06);
}

/* 夜航按压只提一点白光，避免整条搜索框被点亮 */
.home-page.theme-dark .home-search_pressed,
.home-page.theme-dark .home-search_focused {
  background-color: rgba(255, 255, 255, 0.1);
  background-image: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.24) 0%,
    rgba(255, 255, 255, 0.08) 34%,
    rgba(255, 255, 255, 0) 62%
  );
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.5),
    inset 0 0 0 1px rgba(255, 255, 255, 0.22),
    0 8px 18px rgba(0, 0, 0, 0.28);
}

.home-search__icon {
  flex-shrink: 0;
  margin-right: 16rpx;
}

.home-search__input {
  flex: 1;
  min-width: 0;
  height: 100%;
  background-color: transparent;
  border: none;
  color: var(--glass-text);
  font-size: 26rpx;
  font-size: calc(26rpx * var(--fs-scale, 1));
  font-family: var(--glass-font-sans);
}

/* 搜索框内一键清空：命中区占满整条高度，图标保持 16px */
.home-search__clear {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 100%;
  margin-left: 6rpx;
}

.home-search__placeholder {
  color: var(--glass-text-3);
}

/* ---- 首次使用指南横幅 ---- */
.home-help-banner {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 14rpx;
  padding: 20rpx 22rpx;
  border-radius: 26rpx;
  background: var(--glass-bg-soft);
  border: 1rpx solid var(--glass-border);
}

.home-help-banner__copy {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.home-help-banner__title {
  font-size: 25rpx;
  font-size: calc(25rpx * var(--fs-scale, 1));
  font-weight: 600;
  color: var(--glass-text-2);
}

.home-help-banner__sub {
  margin-top: 6rpx;
  font-size: 21rpx;
  font-size: calc(21rpx * var(--fs-scale, 1));
  color: var(--glass-text-3);
}

.home-help-banner__close {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 30rpx;
  line-height: 1;
  color: var(--glass-text-3);
  background: var(--glass-bg);
}

/* ---- 搜索历史：玻璃胶囊 chips ---- */
.home-history {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  margin-top: 14rpx;
  padding: 18rpx 20rpx 20rpx;
  border-radius: 28rpx;
  background: var(--glass-bg-soft);
  border: 1rpx solid var(--glass-border);
}

.home-history__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.home-history__title {
  font-size: 21rpx;
  font-size: calc(21rpx * var(--fs-scale, 1));
  letter-spacing: 2rpx;
  color: var(--glass-text-3);
}

.home-history__clear {
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-size: calc(21rpx * var(--fs-scale, 1));
  color: var(--glass-text-3);
}

.home-history__clear:active {
  background: var(--glass-bg);
}

.home-history__chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.home-history__chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 54rpx;
  padding: 0 12rpx 0 18rpx;
  border-radius: 999rpx;
  background: var(--glass-bg);
  border: 1rpx solid var(--glass-border);
  transition: transform 140ms var(--glass-ease-out);
}

.home-history__chip--press {
  transform: scale(0.96);
  background: var(--glass-bg-strong);
}

.home-history__chip-text {
  max-width: 260rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 23rpx;
  font-size: calc(23rpx * var(--fs-scale, 1));
  color: var(--glass-text-2);
}

.home-history__chip-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  font-size: 24rpx;
  line-height: 1;
  color: var(--glass-text-3);
  background: var(--glass-bg-soft);
}

/* ---- 搜索空结果 ---- */
.home-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 46rpx 0 36rpx;
}

.home-empty__title {
  font-size: 26rpx;
  font-size: calc(26rpx * var(--fs-scale, 1));
  color: var(--glass-text-2);
}

.home-empty__sub {
  font-size: 22rpx;
  font-size: calc(22rpx * var(--fs-scale, 1));
  color: var(--glass-text-3);
}

.home-empty__chips {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
  margin-top: 10rpx;
}

.home-empty__chip {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: var(--glass-bg);
  border: 1rpx solid var(--glass-border);
  font-size: 23rpx;
  font-size: calc(23rpx * var(--fs-scale, 1));
  color: var(--glass-text-2);
}

.home-empty__chip:active {
  background: var(--glass-bg-strong);
}

.home-empty__web {
  margin-top: 14rpx;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--glass-accent);
  background: var(--glass-accent-soft);
  color: var(--glass-accent-text);
  font-size: 22rpx;
  font-size: calc(22rpx * var(--fs-scale, 1));
  font-weight: 600;
}

/* ---- 全网结果 ---- */
.home-web {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 8rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--glass-border);
}

.home-web__head {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
}

.home-web__copy {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.home-web__title {
  color: var(--glass-text);
  font-size: 28rpx;
  font-size: calc(28rpx * var(--fs-scale, 1));
  font-weight: 700;
}

.home-web__sub {
  color: var(--glass-text-3);
  font-size: 19rpx;
  font-size: calc(19rpx * var(--fs-scale, 1));
}

.home-web__all {
  flex: none;
  color: var(--glass-accent-text);
  font-size: 21rpx;
  font-size: calc(21rpx * var(--fs-scale, 1));
  font-weight: 600;
}

.home-web__loading,
.home-web__error,
.home-web__empty {
  padding: 22rpx 20rpx;
  border-radius: 16rpx;
  background: var(--glass-bg);
  border: 1rpx solid var(--glass-border);
  color: var(--glass-text-3);
  font-size: 21rpx;
  font-size: calc(21rpx * var(--fs-scale, 1));
  line-height: 1.5;
}

.home-web__error {
  border-color: var(--glass-danger);
  color: var(--glass-danger-text);
}

.home-web__card {
  display: flex;
  flex-direction: row;
  gap: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  border: 1rpx solid var(--glass-border);
  background: var(--glass-bg-soft);
}

.home-web__index {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--glass-bg-strong);
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 18rpx;
}

.home-web__body {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
  flex: 1;
}

.home-web__card-title {
  color: var(--glass-text);
  font-size: 24rpx;
  font-size: calc(24rpx * var(--fs-scale, 1));
  font-weight: 600;
  line-height: 1.4;
}

.home-web__meta {
  color: var(--glass-text-3);
  font-size: 18rpx;
  font-size: calc(18rpx * var(--fs-scale, 1));
}

.home-web__passage {
  color: var(--glass-text-2);
  font-size: 21rpx;
  font-size: calc(21rpx * var(--fs-scale, 1));
  line-height: 1.55;
}

.home-web__note {
  color: var(--glass-text-3);
  font-size: 17rpx;
  font-size: calc(17rpx * var(--fs-scale, 1));
  line-height: 1.5;
  text-align: center;
}

.home-sections {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
}

.home-section {
  display: flex;
  flex-direction: column;
  margin-bottom: 38rpx;
}

.home-section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 18rpx;
  padding: 0 4rpx;
}

.home-section-title-wrap {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.home-section-title {
  color: var(--glass-text);
  font-size: 32rpx;
  font-size: calc(32rpx * var(--fs-scale, 1));
  font-weight: 700;
  line-height: 1.3;
}

.home-section-hint {
  margin-top: 6rpx;
  color: var(--glass-text-3);
  font-size: 20rpx;
  font-size: calc(20rpx * var(--fs-scale, 1));
  line-height: 1.4;
}

.home-section-count {
  flex-shrink: 0;
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 20rpx;
  font-size: calc(20rpx * var(--fs-scale, 1));
}

.home-tool-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

/* ---- 工具列表项：液态玻璃切片 ---- */
.tool-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  padding-top: 26rpx;
  padding-right: 26rpx;
  padding-bottom: 26rpx;
  padding-left: 26rpx;
  border: 1px solid var(--glass-border);
  border-radius: 20px;
  background-color: var(--glass-bg);
  -webkit-backdrop-filter: blur(16px);
  backdrop-filter: blur(16px);
  box-shadow:
    inset 0 1px 0 var(--glass-highlight),
    inset 0 0 0 1px var(--glass-border),
    0 4px 12px rgba(0, 0, 0, 0.05);
  transition:
    transform 180ms cubic-bezier(0.2, 0.9, 0.25, 1),
    background-color 180ms cubic-bezier(0.2, 0.9, 0.25, 1),
    box-shadow 180ms cubic-bezier(0.2, 0.9, 0.25, 1);
}

.tool-item_pressed {
  transform: scale(0.984);
  background-color: rgba(255, 255, 255, 0.3);
  background-image: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.62) 0%,
    rgba(255, 255, 255, 0.24) 34%,
    rgba(255, 255, 255, 0) 62%
  );
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.92),
    inset 0 0 0 1px rgba(255, 255, 255, 0.42),
    0 2px 8px rgba(0, 0, 0, 0.06);
}

/* 夜航按压：只加一层薄镜面，不整块提亮 */
.home-page.theme-dark .tool-item_pressed {
  background-color: rgba(255, 255, 255, 0.12);
  background-image: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.28) 0%,
    rgba(255, 255, 255, 0.1) 34%,
    rgba(255, 255, 255, 0) 62%
  );
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.6),
    inset 0 0 0 1px rgba(255, 255, 255, 0.24),
    0 2px 8px rgba(0, 0, 0, 0.24);
}

.tool-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  box-sizing: border-box;
  border: 1px solid var(--glass-border);
  border-radius: 20rpx;
  background-color: var(--glass-bg-soft);
  box-shadow: inset 0 1px 2px var(--glass-highlight);
}

.tool-icon-text {
  color: var(--glass-text-2);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1;
}

/* 按压时图标切片同步提亮，形成整块玻璃被点亮的效果 */
.tool-item_pressed .tool-icon {
  border-color: var(--glass-border);
  background-color: var(--glass-bg-strong);
  box-shadow:
    inset 0 2px 6px var(--glass-highlight),
    0 1px 2px rgba(0, 0, 0, 0.04);
}

.tool-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.tool-name {
  color: var(--glass-text);
  font-size: 32rpx;
  font-size: calc(32rpx * var(--fs-scale, 1));
  font-weight: 700;
  line-height: 1.25;
}

.tool-desc {
  margin-top: 6rpx;
  color: var(--glass-text-2);
  font-size: 22rpx;
  font-size: calc(22rpx * var(--fs-scale, 1));
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tool-fav {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: transparent;
  transition:
    transform 320ms var(--glass-ease-spring),
    background-color 220ms var(--glass-ease-out);
}

.tool-fav_on {
  background-color: rgba(255, 214, 132, 0.2);
}

.tool-fav-glyph {
  color: var(--glass-text-3);
  font-size: 34rpx;
  font-weight: 400;
  line-height: 1;
  text-shadow: 0 0 10rpx rgba(255, 214, 140, 0.35);
}

.tool-fav_on .tool-fav-glyph {
  color: var(--glass-accent-warm);
  text-shadow: 0 0 14rpx rgba(255, 198, 92, 0.6);
}

.home-empty {
  display: block;
  color: var(--glass-text-2);
  font-size: 24rpx;
  font-size: calc(24rpx * var(--fs-scale, 1));
  line-height: 1.5;
  text-align: center;
}

.home-foot {
  position: relative;
  z-index: 1;
  margin-top: 18rpx;
  padding: 24rpx 0 8rpx;
  text-align: center;
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 18rpx;
  font-size: calc(18rpx * var(--fs-scale, 1));
  letter-spacing: 0.08em;
}

/* ---- 最近使用 · 横向玻璃胶囊 ---- */
.home-recent {
  position: relative;
  z-index: 1;
  margin-top: 26rpx;
  margin-bottom: 8rpx;
}

.home-recent__head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx 12rpx;
}

.home-recent__kicker {
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 18rpx;
  font-size: calc(18rpx * var(--fs-scale, 1));
  letter-spacing: 0.12em;
}

.home-recent__count {
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 18rpx;
  font-size: calc(18rpx * var(--fs-scale, 1));
}

.home-recent__scroll {
  width: 100%;
  /* Skyline 的 scroll-view 不会按内容自适应高度；固定为胶囊 68 + 上下留白 10 */
  height: 78rpx;
  white-space: nowrap;
}

.home-recent__track {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  padding: 2rpx 2rpx 8rpx;
}

.recent-pill {
  flex: 0 0 auto;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
  height: 68rpx;
  padding: 0 22rpx 0 10rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--glass-border);
  border-radius: 999rpx;
  background-color: var(--glass-bg-soft);
  -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
  backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
  box-shadow:
    inset 0 1rpx 0 var(--glass-highlight),
    var(--glass-shadow-soft);
  transition:
    transform 180ms ease,
    background-color 180ms ease,
    opacity 180ms ease;
}

.recent-pill--press {
  transform: scale(0.96);
  background-color: var(--glass-bg-strong);
  opacity: 0.9;
}

.recent-pill__icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1rpx solid var(--glass-border);
  border-radius: 999rpx;
  background-color: var(--glass-bg-strong);
}

.recent-pill__glyph {
  color: var(--glass-text);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
}

.recent-pill__name {
  color: var(--glass-text);
  font-size: 24rpx;
  font-size: calc(24rpx * var(--fs-scale, 1));
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
}

.recent-empty-card {
  display: block;
}

.recent-empty {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.recent-empty__icon {
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1rpx solid var(--glass-border);
  border-radius: 999rpx;
  background-color: var(--glass-bg-soft);
}

.recent-empty__glyph {
  color: var(--glass-text-3);
  font-size: 26rpx;
  line-height: 1;
}

.recent-empty__copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.recent-empty__title {
  color: var(--glass-text);
  font-size: 24rpx;
  font-size: calc(24rpx * var(--fs-scale, 1));
  font-weight: 600;
}

.recent-empty__desc {
  color: var(--glass-text-3);
  font-size: 21rpx;
  font-size: calc(21rpx * var(--fs-scale, 1));
  line-height: 1.5;
}

@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .recent-pill {
    background-color: var(--glass-bg-strong);
  }
}

/* ==========================================================================
   原有搜索逻辑未变，此处为新增的魔法棒代码
   - 安全区定位：top = 状态栏安全区 + 44px，完全避开微信胶囊
   - 56px 触控热区包裹 44px 半透明玻璃方块，兼顾手感与精致度
   - 内部 SVG 保留蓝紫极光渐变与 drop-shadow 发光
   ========================================================================== */
.magic-wand {
  position: absolute;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56px;
  height: 56px;
  /* 兜底：老版本不识别 env 时也能落在胶囊下方 */
  top: 88px;
  top: calc(env(safe-area-inset-top, 0px) + 44px);
  right: 16px;
  box-sizing: border-box;
}

/* 44x44 玻璃主按钮：外层 1px 渐变高光边框 + 内层毛玻璃 */
.magic-wand__glass {
  width: 44px;
  height: 44px;
  padding: 1px;
  box-sizing: border-box;
  border-radius: 14px;
  background-image: linear-gradient(
    135deg,
    rgba(56, 189, 248, 0.78) 0%,
    rgba(139, 92, 246, 0.72) 48%,
    rgba(217, 70, 239, 0.78) 100%
  );
  box-shadow:
    0 0 26px rgba(139, 92, 246, 0.52),
    0 10px 24px rgba(4, 6, 20, 0.34),
    0 0 0 1px rgba(255, 255, 255, 0.08);
  transition:
    transform 160ms var(--glass-ease-spring),
    box-shadow 240ms var(--glass-ease-out);
}

.magic-wand--pressed .magic-wand__glass {
  transform: scale(0.9);
  box-shadow:
    0 0 16px rgba(139, 92, 246, 0.42),
    0 6px 16px rgba(4, 6, 20, 0.28),
    0 0 0 1px rgba(255, 255, 255, 0.06);
}

.magic-wand__surface {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: 13px;
  /* 去掉深灰底板：只保留通透的极光玻璃面 */
  background-color: rgba(255, 255, 255, 0.16);
  background-image: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.3) 0%,
    rgba(186, 230, 253, 0.1) 42%,
    rgba(240, 171, 252, 0.14) 100%
  );
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.55),
    inset 0 -1px 0 rgba(255, 255, 255, 0.12);
  -webkit-backdrop-filter: blur(18px) saturate(190%);
  backdrop-filter: blur(18px) saturate(190%);
}

.home-page.theme-dark .magic-wand__surface {
  background-color: rgba(255, 255, 255, 0.08);
  background-image: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.2) 0%,
    rgba(186, 230, 253, 0.06) 42%,
    rgba(240, 171, 252, 0.1) 100%
  );
}

/* 蓝紫极光呼吸层：只在玻璃内部，不遮挡任何页面元素 */
.magic-wand__aura {
  position: absolute;
  top: -18%;
  right: -18%;
  bottom: -18%;
  left: -18%;
  pointer-events: none;
  background-image:
    radial-gradient(circle at 24% 22%, rgba(56, 189, 248, 0.82), transparent 58%),
    radial-gradient(circle at 78% 76%, rgba(217, 70, 239, 0.78), transparent 60%),
    radial-gradient(circle at 50% 50%, rgba(139, 92, 246, 0.34), transparent 70%);
  opacity: 0.86;
  animation: magic-wand-breathe 3.6s ease-in-out infinite;
}

.magic-wand__icon {
  position: relative;
  z-index: 2;
  width: 30px;
  height: 30px;
  filter: drop-shadow(0 0 8px rgba(167, 139, 250, 0.95)) saturate(1.2);
}

/* 左上角斜向高光，增加玻璃厚度感 */
.magic-wand__glint {
  position: absolute;
  top: -34%;
  left: -26%;
  width: 86%;
  height: 86%;
  pointer-events: none;
  background-image: linear-gradient(
    120deg,
    rgba(255, 255, 255, 0.36) 0%,
    rgba(255, 255, 255, 0.08) 38%,
    transparent 66%
  );
  transform: rotate(-18deg);
  z-index: 1;
}

@keyframes magic-wand-breathe {
  0% {
    transform: scale(1) rotate(0deg);
    opacity: 0.72;
  }

  50% {
    transform: scale(1.16) rotate(8deg);
    opacity: 1;
  }

  100% {
    transform: scale(1) rotate(0deg);
    opacity: 0.72;
  }
}

@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .magic-wand__surface {
    background-color: var(--glass-bg-strong);
  }
}

/* 省电 / 关闭光效时静止，避免持续重绘 */
.motion-saver .magic-wand__aura,
.light-off .magic-wand__aura {
  animation: none;
}

/* 省电模式：数字直接落定，不做滚轮过渡与回弹 */
.motion-saver .home-roll-digit__track,
.motion-saver .home-hero-mini__value_bounce {
  transition: none;
  animation: none;
}

.light-off .magic-wand__aura {
  opacity: 0.3;
}

@media (prefers-reduced-motion: reduce) {
  .magic-wand__glass {
    transition-duration: 1ms;
  }

  .magic-wand__aura {
    animation: none;
  }

  .home-hero-primary,
  .home-hero-secondary {
    animation: none;
  }

  .home-roll-digit__track {
    transition: none;
  }

  .home-hero-mini__value_bounce {
    animation: none;
  }
}

/* ---- 离线：联网工具置灰，只降透明度不改布局 ---- */
.tool-item_offline,
.recent-pill_offline,
.home-empty__chip_offline {
  opacity: 0.45;
}

.tool-offline-tag {
  align-self: flex-start;
  margin-top: 4rpx;
  padding: 2rpx 10rpx;
  border: 1rpx solid var(--glass-accent-warm);
  border-radius: 999rpx;
  color: var(--glass-accent-warm-text);
  font-size: 18rpx;
  line-height: 1.4;
}

/* 可离线使用、仅刷新需要联网：不降透明度，只做轻提示 */
.tool-net-tag {
  align-self: flex-start;
  margin-top: 4rpx;
  padding: 2rpx 10rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: 999rpx;
  color: var(--glass-text-3);
  font-size: 18rpx;
  line-height: 1.4;
}

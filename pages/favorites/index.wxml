<view class="fav-page sg-ambient-surface sg-ambient-iris {{themeClass}} {{fsClass}} {{themeSwitching ? 'theme-breathing' : ''}} {{manageMode ? 'fav-page--manage' : ''}}">
  <view class="fav-aurora" aria-hidden="true">
    <view class="sg-aurora-a fav-aurora__a"></view>
    <view class="sg-aurora-b fav-aurora__b"></view>
    <view class="sg-aurora-c fav-aurora__c"></view>
  </view>

  <scroll-view
    class="fav-scroll"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    bounces="{{false}}"
    type="list"
  >
    <view class="fav-inner">
      <view class="fav-head">
        <text class="fav-kicker">COLLECTION / 本机</text>
        <view class="fav-title-line">
          <text class="fav-title">收藏</text>
          <text class="fav-count" aria-role="status" aria-label="已收藏 {{tools.length}} 个工具">{{tools.length}} SAVED</text>
        </view>
        <text wx:if="{{tools.length}}" class="fav-sub">只收藏工具本身，不保存任何输入与结果。当前 {{tools.length}} 个常用工具。</text>
        <text wx:else class="fav-sub">还没有收藏，先把顺手的那个工具留下。</text>

        <view wx:if="{{tools.length}}" class="fav-toolbar">
          <view class="fav-sorts" aria-role="tablist" aria-label="收藏排序">
            <view
              wx:for="{{sortOptions}}"
              wx:key="key"
              class="fav-sort {{sort === item.key ? 'fav-sort--on' : ''}}"
              data-key="{{item.key}}"
              bindtap="onSort"
              aria-role="tab"
              aria-selected="{{sort === item.key}}"
            >{{item.label}}</view>
          </view>
          <view class="fav-head-actions">
            <text
              wx:if="{{manageMode}}"
              class="fav-clear"
              bindtap="onAskClear"
              aria-role="button"
              aria-label="清空全部收藏"
            >清空</text>
            <text
              class="fav-manage"
              bindtap="onToggleManage"
              aria-role="button"
              aria-label="{{manageMode ? '退出管理' : '管理收藏'}}"
            >{{manageMode ? '完成' : '管理'}}</text>
          </view>
        </view>
      </view>

      <block wx:if="{{tools.length}}">
        <view class="fav-list">
          <view
            wx:for="{{tools}}"
            wx:key="id"
            class="fav-item {{manageMode ? 'fav-item--manage' : ''}} {{selectedMap[item.id] ? 'fav-item--selected' : ''}} {{offline && item.network === 'required' ? 'fav-item--offline' : ''}}"
            hover-class="{{!manageMode && offline && item.network === 'required' ? 'none' : 'fav-item--press'}}"
            hover-start-time="0"
            hover-stay-time="120"
            data-route="{{item.route}}"
            data-id="{{item.id}}"
            aria-role="{{manageMode ? 'checkbox' : 'button'}}"
            aria-checked="{{selectedMap[item.id] ? true : false}}"
            aria-disabled="{{!manageMode && offline && item.network === 'required'}}"
            aria-label="{{manageMode ? '选择' + item.name : item.name + '，' + item.desc}}"
            bindtap="onRowTap"
          >
            <text class="fav-index">{{index + 1 < 10 ? '0' + (index + 1) : index + 1}}</text>

            <view class="fav-icon" aria-hidden="true">
              <text class="fav-icon__text">{{item.icon}}</text>
            </view>

            <view class="fav-copy">
              <text class="fav-name">{{item.name}}</text>
              <text class="fav-meta">{{item.desc}}</text>
              <text wx:if="{{offline && item.network === 'required'}}" class="fav-offline-tag">离线不可用</text>
              <text wx:elif="{{offline && item.network === 'refresh'}}" class="fav-net-tag">需联网更新</text>
            </view>

            <view
              wx:if="{{manageMode}}"
              class="fav-check {{selectedMap[item.id] ? 'fav-check--on' : ''}}"
              aria-hidden="true"
            >
              <text wx:if="{{selectedMap[item.id]}}" class="fav-check__glyph">✓</text>
            </view>
            <view
              wx:else
              class="fav-mark"
              hover-class="fav-mark--press"
              hover-stay-time="80"
              aria-role="button"
              aria-label="取消收藏{{item.name}}"
              data-id="{{item.id}}"
              catchtap="onUnfavorite"
            >
              <text class="fav-mark__glyph">★</text>
            </view>
          </view>
        </view>
        <view class="fav-hint">
          <text wx:if="{{manageMode}}">点击行选择工具，底部可全选或批量移除</text>
          <text wx:else>点击行进入工具，点击右侧星标取消收藏</text>
        </view>
      </block>

      <glass-card
        wx:else
        tone="iris"
        radius="xl"
        padding="lg"
        depth="deep"
        card-class="fav-empty"
      >
        <view class="fav-empty__inner">
          <text class="fav-empty__glyph" aria-hidden="true">☆</text>
          <text class="fav-empty__title">还没有收藏。</text>
          <text class="fav-empty__copy">在工具页右上角点一下星标，<br />它会像一张胶片一样留在这里。</text>

          <view class="fav-empty__cta">
            <glass-button
              variant="tint"
              size="md"
              block
              bind:tap="onGoHome"
            >
              去工具台
            </glass-button>
          </view>

          <text class="fav-empty__note">COLLECTED LOCALLY / 不上传</text>
        </view>
      </glass-card>

      <view class="fav-foot">收藏只存本机 · 最多 100 个</view>
    </view>
  </scroll-view>

  <view wx:if="{{manageMode}}" class="fav-managebar">
    <text class="fav-managebar__count" aria-role="status">已选 {{selectedCount}} 项</text>
    <view class="fav-managebar__actions">
      <text
        class="fav-managebar__action"
        bindtap="onSelectAll"
        aria-role="button"
        aria-label="{{allSelected ? '取消全选' : '全选'}}"
      >{{allSelected ? '取消全选' : '全选'}}</text>
      <text
        class="fav-managebar__action {{selectedCount ? '' : 'fav-managebar__action--disabled'}}"
        bindtap="onRemoveSelected"
        aria-role="button"
        aria-label="移除已选收藏"
      >移除</text>
      <text
        class="fav-managebar__action"
        bindtap="onToggleManage"
        aria-role="button"
        aria-label="退出管理"
      >取消</text>
    </view>
  </view>

  <glass-modal
    show="{{showClearConfirm}}"
    title="清空收藏"
    description="将移除全部 {{tools.length}} 个收藏，此操作不可撤销"
    confirm-text="清空"
    cancel-text="取消"
    danger
    bind:confirm="onConfirmClear"
    bind:cancel="onCancelClear"
    bind:close="onCancelClear"
  />

  <glass-toast />
  <update-guard />
  <meeting-timer-hud />
  <offline-banner variant="tab" />
</view>

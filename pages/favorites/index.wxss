/* ==========================================================================
   pages/favorites · 液态玻璃收藏页
   - 列表项为半透明玻璃切片，按压叠加镜面高光
   - 空状态使用 glass-card + 极光按钮，无虚线框
   ========================================================================== */

.fav-page {
  position: relative;
  height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
  background-color: var(--glass-canvas);
  color: var(--glass-text);
  font-family: var(--glass-font-sans);
}

/* 昼夜两套页面材质，夜航是吸光黑曜玻璃 */
.fav-page.theme-light {
  --glass-bg: rgba(255, 255, 255, 0.18);
  --glass-bg-soft: rgba(255, 255, 255, 0.12);
  --glass-bg-strong: rgba(255, 255, 255, 0.26);
  --glass-border: rgba(255, 255, 255, 0.42);
  --glass-blur: 24px;
  --glass-saturate: 200%;
}

.fav-page.theme-dark {
  --glass-bg: rgba(13, 17, 26, 0.56);
  --glass-bg-soft: rgba(13, 17, 26, 0.36);
  --glass-bg-strong: rgba(20, 25, 38, 0.76);
  --glass-border: rgba(255, 255, 255, 0.14);
  --glass-highlight: rgba(255, 255, 255, 0.2);
  --glass-blur: 28px;
  --glass-saturate: 180%;
}

.fav-aurora {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}

.fav-aurora__a {
  position: absolute;
  top: -20%;
  left: -30%;
  width: 104%;
  height: 62%;
}

.fav-aurora__b {
  position: absolute;
  top: 10%;
  right: -32%;
  width: 96%;
  height: 58%;
}

.fav-aurora__c {
  position: absolute;
  bottom: -26%;
  left: -10%;
  width: 110%;
  height: 64%;
}

.fav-scroll {
  position: relative;
  z-index: 1;
  height: 100vh;
}

.fav-inner {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding-top: calc(env(safe-area-inset-top) + 56rpx);
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: calc(120px + env(safe-area-inset-bottom));
}

.fav-head {
  display: flex;
  flex-direction: column;
  margin-bottom: 30rpx;
}

.fav-kicker {
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 19rpx;
  font-size: calc(19rpx * var(--fs-scale, 1));
  letter-spacing: 0.14em;
}

.fav-title-line {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 12rpx;
}

.fav-title {
  color: var(--glass-text);
  font-size: 56rpx;
  font-size: calc(56rpx * var(--fs-scale, 1));
  font-weight: 700;
  line-height: 1.12;
}

.fav-count {
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 20rpx;
  font-size: calc(20rpx * var(--fs-scale, 1));
  letter-spacing: 0.08em;
}

.fav-sub {
  margin-top: 12rpx;
  color: var(--glass-text-2);
  font-size: 24rpx;
  font-size: calc(24rpx * var(--fs-scale, 1));
  line-height: 1.55;
}

/* ---- 排序与管理入口 ---- */
.fav-toolbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 22rpx;
}

.fav-sorts {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 10rpx;
  min-width: 0;
}

.fav-sort {
  padding: 10rpx 20rpx;
  border: 1px solid var(--glass-border);
  border-radius: 999rpx;
  background-color: var(--glass-bg-soft);
  color: var(--glass-text-2);
  font-size: 21rpx;
  font-size: calc(21rpx * var(--fs-scale, 1));
  line-height: 1.3;
}

.fav-sort--on {
  border-color: var(--glass-accent);
  background-color: var(--glass-accent-soft);
  color: var(--glass-accent-text);
  font-weight: 600;
}

.fav-head-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  gap: 18rpx;
}

.fav-manage,
.fav-clear {
  color: var(--glass-accent-text);
  font-size: 22rpx;
  font-size: calc(22rpx * var(--fs-scale, 1));
  font-weight: 600;
}

.fav-clear {
  color: var(--glass-danger-text);
}

/* ---- 收藏列表 ---- */
.fav-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.fav-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 18rpx;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  padding-top: 24rpx;
  padding-right: 24rpx;
  padding-bottom: 24rpx;
  padding-left: 24rpx;
  border: 1px solid var(--glass-border);
  border-radius: 20px;
  background-color: var(--glass-bg);
  -webkit-backdrop-filter: blur(16px);
  backdrop-filter: blur(16px);
  box-shadow:
    inset 0 1px 0 var(--glass-highlight),
    inset 0 0 0 1px var(--glass-border),
    0 4px 12px rgba(0, 0, 0, 0.05);
  transition:
    transform 180ms cubic-bezier(0.2, 0.9, 0.25, 1),
    background-color 180ms cubic-bezier(0.2, 0.9, 0.25, 1),
    box-shadow 180ms cubic-bezier(0.2, 0.9, 0.25, 1);
}

.fav-item--press {
  transform: scale(0.984);
  background-color: rgba(255, 255, 255, 0.3);
  background-image: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.62) 0%,
    rgba(255, 255, 255, 0.24) 34%,
    rgba(255, 255, 255, 0) 62%
  );
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.92),
    inset 0 0 0 1px rgba(255, 255, 255, 0.42),
    0 2px 8px rgba(0, 0, 0, 0.06);
}

.fav-item--selected {
  border-color: var(--glass-accent);
  background-color: var(--glass-accent-soft);
  box-shadow:
    inset 0 1px 0 var(--glass-highlight),
    inset 0 0 0 1px var(--glass-accent),
    0 4px 14px rgba(0, 0, 0, 0.08);
}

.fav-check {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  box-sizing: border-box;
  border: 2rpx solid var(--glass-border);
  border-radius: 50%;
  background-color: var(--glass-bg-soft);
}

.fav-check--on {
  border-color: var(--glass-accent);
  background-color: var(--glass-accent);
}

.fav-check__glyph {
  color: var(--glass-on-accent);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

/* 夜航按压：薄镜面，不整块提亮 */
.fav-page.theme-dark .fav-item--press {
  background-color: rgba(255, 255, 255, 0.12);
  background-image: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.28) 0%,
    rgba(255, 255, 255, 0.1) 34%,
    rgba(255, 255, 255, 0) 62%
  );
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.6),
    inset 0 0 0 1px rgba(255, 255, 255, 0.24),
    0 2px 8px rgba(0, 0, 0, 0.24);
}

.fav-index {
  flex-shrink: 0;
  width: 36rpx;
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 18rpx;
  text-align: center;
}

.fav-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  box-sizing: border-box;
  border: 1px solid var(--glass-border);
  border-radius: 20rpx;
  background-color: var(--glass-bg-soft);
  box-shadow: inset 0 1px 2px var(--glass-highlight);
}

.fav-icon__text {
  color: var(--glass-text-2);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1;
}

.fav-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.fav-name {
  color: var(--glass-text);
  font-size: 30rpx;
  font-size: calc(30rpx * var(--fs-scale, 1));
  font-weight: 700;
  line-height: 1.3;
}

.fav-meta {
  margin-top: 6rpx;
  color: var(--glass-text-2);
  font-size: 21rpx;
  font-size: calc(21rpx * var(--fs-scale, 1));
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fav-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background-color: rgba(255, 214, 132, 0.18);
  transition:
    transform 160ms cubic-bezier(0.2, 0.9, 0.25, 1),
    background-color 160ms cubic-bezier(0.2, 0.9, 0.25, 1),
    box-shadow 160ms cubic-bezier(0.2, 0.9, 0.25, 1);
}

.fav-mark--press {
  transform: scale(0.94);
  background-color: rgba(255, 214, 132, 0.34);
  background-image: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.55) 0%,
    rgba(255, 255, 255, 0.1) 42%,
    rgba(255, 255, 255, 0) 68%
  );
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.82),
    0 0 12rpx rgba(255, 198, 92, 0.3);
}

.fav-mark__glyph {
  color: var(--glass-accent-warm);
  font-size: 30rpx;
  line-height: 1;
  text-shadow: 0 0 14rpx rgba(255, 198, 92, 0.55);
}

.fav-hint {
  margin-top: 18rpx;
  padding: 0 8rpx;
  color: var(--glass-text-3);
  font-size: 20rpx;
  font-size: calc(20rpx * var(--fs-scale, 1));
  line-height: 1.5;
  text-align: center;
}

/* ---- 空状态 ---- */
.fav-empty {
  display: block;
  margin-top: 8rpx;
  box-sizing: border-box;
  box-shadow:
    inset 0 1px 2px var(--glass-highlight),
    var(--glass-shadow-soft);
}

.fav-empty__inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding-top: 28rpx;
  padding-bottom: 12rpx;
}

.fav-empty__glyph {
  color: var(--glass-text-3);
  font-size: 64rpx;
  line-height: 1;
  text-shadow: 0 0 20rpx rgba(140, 120, 255, 0.35);
}

.fav-empty__title {
  margin-top: 18rpx;
  color: var(--glass-text);
  font-size: 34rpx;
  font-size: calc(34rpx * var(--fs-scale, 1));
  font-weight: 700;
}

.fav-empty__copy {
  margin-top: 12rpx;
  color: var(--glass-text-2);
  font-size: 23rpx;
  font-size: calc(23rpx * var(--fs-scale, 1));
  line-height: 1.6;
}

.fav-empty__cta {
  width: 100%;
  margin-top: 28rpx;
}

.fav-empty__note {
  margin-top: 20rpx;
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 17rpx;
  font-size: calc(17rpx * var(--fs-scale, 1));
  letter-spacing: 0.08em;
}

/* ---- 页脚 ---- */
.fav-foot {
  margin-top: 26rpx;
  padding: 8rpx 0 12rpx;
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 17rpx;
  font-size: calc(17rpx * var(--fs-scale, 1));
  letter-spacing: 0.06em;
  text-align: center;
}

/* ---- 管理模式底部操作条 ---- */
.fav-page--manage .fav-inner {
  padding-bottom: calc(200px + env(safe-area-inset-bottom));
}

.fav-managebar {
  position: fixed;
  right: 24rpx;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  z-index: 20;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 18rpx 24rpx;
  border: 1px solid var(--glass-border);
  border-radius: 24rpx;
  background-color: var(--glass-bg-strong);
  -webkit-backdrop-filter: blur(var(--glass-blur));
  backdrop-filter: blur(var(--glass-blur));
  box-shadow:
    inset 0 1px 0 var(--glass-highlight),
    0 12px 32px rgba(0, 0, 0, 0.18);
}

.fav-managebar__count {
  color: var(--glass-text);
  font-size: 23rpx;
  font-size: calc(23rpx * var(--fs-scale, 1));
  font-weight: 600;
}

.fav-managebar__actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 22rpx;
}

.fav-managebar__action {
  color: var(--glass-accent-text);
  font-size: 23rpx;
  font-size: calc(23rpx * var(--fs-scale, 1));
  font-weight: 600;
}

.fav-managebar__action--disabled {
  color: var(--glass-text-3);
}

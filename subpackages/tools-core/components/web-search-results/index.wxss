/* 元宝搜索结果区 · 只消费 glass 令牌；字号统一「原值 + calc」 */
.wr {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.wr__head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
}

.wr__head-copy {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.wr__count {
  color: var(--glass-text);
  font-size: 28rpx;
  font-size: calc(28rpx * var(--fs-scale, 1));
  font-weight: 700;
}

.wr__meta {
  color: var(--glass-text-3);
  font-size: 20rpx;
  font-size: calc(20rpx * var(--fs-scale, 1));
}

.wr__action {
  flex: none;
  color: var(--glass-accent-text);
  font-size: 22rpx;
  font-size: calc(22rpx * var(--fs-scale, 1));
  font-weight: 600;
}

.wr__message,
.wr__hint {
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  background: var(--glass-bg);
  border: 1rpx solid var(--glass-border);
  color: var(--glass-text-2);
  font-size: 20rpx;
  font-size: calc(20rpx * var(--fs-scale, 1));
  line-height: 1.55;
}

.wr__hint {
  border-color: var(--glass-accent);
  color: var(--glass-accent-text);
}

.wr__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 56rpx 0;
}

.wr__empty-title {
  color: var(--glass-text-2);
  font-size: 26rpx;
  font-size: calc(26rpx * var(--fs-scale, 1));
}

.wr__empty-sub {
  color: var(--glass-text-3);
  font-size: 22rpx;
  font-size: calc(22rpx * var(--fs-scale, 1));
  line-height: 1.5;
}

.wr__list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.wr__card {
  display: flex;
  flex-direction: row;
  gap: 14rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--glass-border);
  background: var(--glass-bg-soft);
}

.wr__index {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--glass-bg-strong);
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 20rpx;
  font-size: calc(20rpx * var(--fs-scale, 1));
}

.wr__body {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
  flex: 1;
}

.wr__title {
  color: var(--glass-text);
  font-size: 26rpx;
  font-size: calc(26rpx * var(--fs-scale, 1));
  font-weight: 600;
  line-height: 1.4;
}

.wr__meta-line {
  color: var(--glass-text-3);
  font-size: 20rpx;
  font-size: calc(20rpx * var(--fs-scale, 1));
}

.wr__badges,
.wr-detail__badges {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.wr__badge,
.wr-detail__badge {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: var(--glass-accent-soft);
  color: var(--glass-accent-text);
  font-size: 18rpx;
  font-size: calc(18rpx * var(--fs-scale, 1));
  font-weight: 600;
}

.wr__badge--ghost,
.wr-detail__badge--ghost {
  background: var(--glass-bg);
  color: var(--glass-text-3);
  border: 1rpx solid var(--glass-border);
}

.wr__passage {
  color: var(--glass-text-2);
  font-size: 22rpx;
  font-size: calc(22rpx * var(--fs-scale, 1));
  line-height: 1.6;
}

.wr__card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 4rpx;
}

.wr__copy-link {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--glass-accent);
  background: var(--glass-accent-soft);
  color: var(--glass-accent-text);
  font-size: 20rpx;
  font-size: calc(20rpx * var(--fs-scale, 1));
  font-weight: 600;
}

.wr__hint-text {
  color: var(--glass-text-3);
  font-size: 18rpx;
  font-size: calc(18rpx * var(--fs-scale, 1));
}

.wr__foot {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 8rpx 0 4rpx;
  text-align: center;
}

.wr__foot-line,
.wr__rid {
  color: var(--glass-text-3);
  font-size: 18rpx;
  font-size: calc(18rpx * var(--fs-scale, 1));
  line-height: 1.5;
}

.wr__rid {
  color: var(--glass-text-2);
  word-break: break-all;
}

/* ---- 详情抽屉 ---- */
.wr-detail__scroll {
  height: 58vh;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.wr-detail__title {
  display: block;
  color: var(--glass-text);
  font-size: 30rpx;
  font-size: calc(30rpx * var(--fs-scale, 1));
  font-weight: 700;
  line-height: 1.4;
}

.wr-detail__meta {
  display: block;
  margin-top: 8rpx;
  color: var(--glass-text-3);
  font-size: 20rpx;
  font-size: calc(20rpx * var(--fs-scale, 1));
}

.wr-detail__badges {
  margin-top: 10rpx;
}

.wr-detail__passage {
  display: block;
  margin-top: 18rpx;
  color: var(--glass-text-2);
  font-size: 24rpx;
  font-size: calc(24rpx * var(--fs-scale, 1));
  line-height: 1.65;
}

.wr-detail__content {
  display: block;
  margin-top: 14rpx;
  color: var(--glass-text-2);
  font-size: 23rpx;
  font-size: calc(23rpx * var(--fs-scale, 1));
  line-height: 1.65;
}

.wr-detail__rows {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 18rpx;
}

.wr-detail__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 14rpx;
  background: var(--glass-bg);
  border: 1rpx solid var(--glass-border);
}

.wr-detail__row-k {
  color: var(--glass-text-3);
  font-size: 20rpx;
  font-size: calc(20rpx * var(--fs-scale, 1));
}

.wr-detail__row-v {
  color: var(--glass-accent-text);
  font-size: 20rpx;
  font-size: calc(20rpx * var(--fs-scale, 1));
  font-weight: 600;
}

.wr-detail__section {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 20rpx;
}

.wr-detail__label {
  color: var(--glass-text-3);
  font-size: 20rpx;
  font-size: calc(20rpx * var(--fs-scale, 1));
  letter-spacing: 1rpx;
}

.wr-detail__item {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: var(--glass-bg-soft);
  border: 1rpx solid var(--glass-border);
}

.wr-detail__item-title {
  color: var(--glass-text-2);
  font-size: 21rpx;
  font-size: calc(21rpx * var(--fs-scale, 1));
  line-height: 1.55;
  word-break: break-all;
}

.wr-detail__item-action {
  align-self: flex-start;
  color: var(--glass-accent-text);
  font-size: 19rpx;
  font-size: calc(19rpx * var(--fs-scale, 1));
  font-weight: 600;
}

.wr-detail__note {
  color: var(--glass-text-3);
  font-size: 18rpx;
  font-size: calc(18rpx * var(--fs-scale, 1));
  line-height: 1.5;
}

.wr-detail__url {
  display: block;
  margin-top: 18rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: var(--glass-bg);
  border: 1rpx solid var(--glass-border);
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 20rpx;
  font-size: calc(20rpx * var(--fs-scale, 1));
  line-height: 1.5;
  word-break: break-all;
}

.wr-detail__footer {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  padding: 0 28rpx calc(var(--glass-safe-bottom) + 24rpx);
  box-sizing: border-box;
}

.wr-detail__button {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  padding: 16rpx 12rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
  font-size: calc(24rpx * var(--fs-scale, 1));
  box-sizing: border-box;
}

.wr-detail__button--primary {
  background: var(--glass-bg-strong);
  color: var(--glass-text);
  border: 1rpx solid var(--glass-border-strong);
  font-weight: 600;
}

.wr-detail__button--ghost {
  background: var(--glass-bg);
  color: var(--glass-text-2);
  border: 1rpx solid var(--glass-border);
}

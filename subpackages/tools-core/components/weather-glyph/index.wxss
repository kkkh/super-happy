/* ==========================================================================
   weather-glyph · 尺寸与布局
   - 纯 SVG 资产，不再用 CSS 几何拼接绘制天气形态
   - 视觉尺寸由 size 控制，色值由 tone 选择，主题切换无需重绘
   ========================================================================== */
.wg {
  display: block;
  flex: none;
  width: 96rpx;
  height: 96rpx;
}

.wg--sm {
  width: 64rpx;
  height: 64rpx;
}

.wg--lg {
  width: 168rpx;
  height: 168rpx;
}

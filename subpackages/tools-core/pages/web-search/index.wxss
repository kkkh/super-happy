/* 元宝搜索 · 页面样式：只消费 glass 令牌；字号统一「原值 + calc」 */
.ws-fields {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.ws-filter {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.ws-filter__label {
  font-size: 20rpx;
  font-size: calc(20rpx * var(--fs-scale, 1));
  letter-spacing: 1rpx;
  color: var(--glass-text-3);
}

.ws-chips {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 10rpx;
}

.ws-chip {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--glass-border);
  background: var(--glass-bg-soft);
  color: var(--glass-text-2);
  font-size: 22rpx;
  font-size: calc(22rpx * var(--fs-scale, 1));
  line-height: 1.3;
}

.ws-chip--on {
  border-color: var(--glass-accent);
  background: var(--glass-accent-soft);
  color: var(--glass-accent-text);
  font-weight: 600;
}

.ws-advanced-toggle {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 4rpx;
  border-top: 1rpx solid var(--glass-border);
}

.ws-advanced-toggle__text {
  color: var(--glass-text-2);
  font-size: 22rpx;
  font-size: calc(22rpx * var(--fs-scale, 1));
}

.ws-advanced {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.ws-notice {
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: var(--glass-bg);
  border: 1rpx solid var(--glass-border);
}

.ws-notice__text {
  color: var(--glass-text-3);
  font-size: 20rpx;
  font-size: calc(20rpx * var(--fs-scale, 1));
  line-height: 1.55;
}

.ws-warning {
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--glass-danger);
  background: var(--glass-bg);
}

.ws-warning__text {
  color: var(--glass-danger-text);
  font-size: 20rpx;
  font-size: calc(20rpx * var(--fs-scale, 1));
  line-height: 1.55;
}

/* ---- 结果区 ---- */
.ws-result {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.ws-result__head {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
}

.ws-result__copy {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.ws-result__count {
  color: var(--glass-text);
  font-size: 28rpx;
  font-size: calc(28rpx * var(--fs-scale, 1));
  font-weight: 700;
}

.ws-result__meta {
  color: var(--glass-text-3);
  font-size: 20rpx;
  font-size: calc(20rpx * var(--fs-scale, 1));
}

.ws-result__action {
  flex: none;
  color: var(--glass-accent-text);
  font-size: 22rpx;
  font-size: calc(22rpx * var(--fs-scale, 1));
  font-weight: 600;
}

.ws-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 60rpx 0;
}

.ws-empty__title {
  color: var(--glass-text-2);
  font-size: 26rpx;
  font-size: calc(26rpx * var(--fs-scale, 1));
}

.ws-empty__sub {
  color: var(--glass-text-3);
  font-size: 22rpx;
  font-size: calc(22rpx * var(--fs-scale, 1));
  line-height: 1.5;
}

.ws-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.ws-card {
  display: flex;
  flex-direction: row;
  gap: 14rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--glass-border);
  background: var(--glass-bg-soft);
}

.ws-card__index {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--glass-bg-strong);
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 20rpx;
}

.ws-card__body {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
  flex: 1;
}

.ws-card__title {
  color: var(--glass-text);
  font-size: 26rpx;
  font-size: calc(26rpx * var(--fs-scale, 1));
  font-weight: 600;
  line-height: 1.4;
}

.ws-card__meta {
  color: var(--glass-text-3);
  font-size: 20rpx;
  font-size: calc(20rpx * var(--fs-scale, 1));
}

.ws-card__passage {
  color: var(--glass-text-2);
  font-size: 22rpx;
  font-size: calc(22rpx * var(--fs-scale, 1));
  line-height: 1.6;
}

.ws-card__actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 4rpx;
}

.ws-card__action {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--glass-accent);
  background: var(--glass-accent-soft);
  color: var(--glass-accent-text);
  font-size: 20rpx;
  font-size: calc(20rpx * var(--fs-scale, 1));
  font-weight: 600;
}

.ws-card__hint {
  color: var(--glass-text-3);
  font-size: 18rpx;
  font-size: calc(18rpx * var(--fs-scale, 1));
}

.ws-foot {
  padding: 8rpx 0 4rpx;
  color: var(--glass-text-3);
  font-size: 18rpx;
  font-size: calc(18rpx * var(--fs-scale, 1));
  line-height: 1.5;
  text-align: center;
}

/* ---- 详情抽屉 ---- */
.ws-detail__scroll {
  height: 56vh;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.ws-detail__title {
  display: block;
  color: var(--glass-text);
  font-size: 30rpx;
  font-size: calc(30rpx * var(--fs-scale, 1));
  font-weight: 700;
  line-height: 1.4;
}

.ws-detail__meta {
  display: block;
  margin-top: 8rpx;
  color: var(--glass-text-3);
  font-size: 20rpx;
  font-size: calc(20rpx * var(--fs-scale, 1));
}

.ws-detail__passage {
  display: block;
  margin-top: 18rpx;
  color: var(--glass-text-2);
  font-size: 24rpx;
  font-size: calc(24rpx * var(--fs-scale, 1));
  line-height: 1.65;
}

.ws-detail__content {
  display: block;
  margin-top: 14rpx;
  color: var(--glass-text-2);
  font-size: 23rpx;
  font-size: calc(23rpx * var(--fs-scale, 1));
  line-height: 1.65;
}

.ws-detail__url {
  display: block;
  margin-top: 18rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: var(--glass-bg);
  border: 1rpx solid var(--glass-border);
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 20rpx;
  font-size: calc(20rpx * var(--fs-scale, 1));
  line-height: 1.5;
  word-break: break-all;
}

.ws-detail__footer {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  padding: 0 28rpx calc(var(--glass-safe-bottom) + 24rpx);
  box-sizing: border-box;
}

.ws-detail__button {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  padding: 16rpx 12rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
  font-size: calc(24rpx * var(--fs-scale, 1));
  box-sizing: border-box;
}

.ws-detail__button--primary {
  background: var(--glass-bg-strong);
  color: var(--glass-text);
  border: 1rpx solid var(--glass-border-strong);
  font-weight: 600;
}

.ws-detail__button--ghost {
  background: var(--glass-bg);
  color: var(--glass-text-2);
  border: 1rpx solid var(--glass-border);
}

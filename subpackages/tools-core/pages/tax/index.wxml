<glass-tool-shell
  tool-id="tax"
  title="{{toolName}}"
  kicker="{{kicker}}"
  desc="{{desc}}"
  poster-data="{{posterData}}"
  sensitive="finance"
  state="{{shellState}}"
  run-label="计算个税"
  has-result="{{hasResult}}"
  error="{{error}}"
  empty-title="填入收入与扣除，点击计算"
  empty-sub="金额只在本机计算，不会上传"
  bind:run="onRun"
  bind:example="onExample"
  bind:reset="onReset"
>
  <view slot="input" class="sg-tool-fields">
    <view class="tool-seg">
      <glass-button
        variant="{{mode === 'monthly' ? 'primary' : 'ghost'}}"
        size="sm"
        haptic="none"
        data-mode="monthly"
        aria-label="月度个税试算"
        bind:tap="onMode"
      >
        月度
      </glass-button>
      <glass-button
        variant="{{mode === 'annual' ? 'primary' : 'ghost'}}"
        size="sm"
        haptic="none"
        data-mode="annual"
        aria-label="年度个税试算"
        bind:tap="onMode"
      >
        年度
      </glass-button>
    </view>

    <glass-input
      label="{{mode === 'monthly' ? '月收入' : '年收入'}}"
      hint="税前金额，最多两位小数"
      type="digit"
      maxlength="{{16}}"
      value="{{income}}"
      placeholder="{{mode === 'monthly' ? '例如 15000' : '例如 180000'}}"
      data-field="income"
      aria-label="{{mode === 'monthly' ? '月收入' : '年收入'}}"
      bind:input="onInput"
      bind:confirm="onInput"
    >
      <text slot="suffix" class="sg-tool-unit">元</text>
    </glass-input>

    <glass-input
      label="五险一金"
      hint="个人缴纳部分，可留空"
      type="digit"
      maxlength="{{16}}"
      value="{{insurance}}"
      placeholder="例如 2000"
      data-field="insurance"
      aria-label="五险一金个人缴纳金额"
      bind:input="onInput"
      bind:confirm="onInput"
    >
      <text slot="suffix" class="sg-tool-unit">元</text>
    </glass-input>

    <glass-input
      label="专项附加扣除"
      hint="子女教育、房贷、赡养等，可留空"
      type="digit"
      maxlength="{{16}}"
      value="{{special}}"
      placeholder="例如 1000"
      data-field="special"
      aria-label="专项附加扣除金额"
      bind:input="onInput"
      bind:confirm="onInput"
    >
      <text slot="suffix" class="sg-tool-unit">元</text>
    </glass-input>

    <glass-input
      label="其他扣除"
      hint="可留空"
      type="digit"
      maxlength="{{16}}"
      value="{{other}}"
      placeholder="例如 0"
      data-field="other"
      aria-label="其他扣除金额"
      bind:input="onInput"
      bind:confirm="onInput"
    >
      <text slot="suffix" class="sg-tool-unit">元</text>
    </glass-input>
  </view>

  <view slot="result" class="sg-tool-result">
    <view class="sg-tool-result__head">
      <text class="sg-tool-result__label">{{mode === 'monthly' ? '本月应纳税额' : '本年应纳税额'}}</text>
      <text class="sg-tool-result__meta">{{mode === 'monthly' ? 'MONTHLY / 2026' : 'ANNUAL / 2026'}}</text>
    </view>

    <view class="sg-tool-result__main">
      <animated-number
        value="{{taxValue}}"
        decimals="2"
        prefix="¥"
        size="xl"
        tone="aurora"
      />
    </view>

    <view wx:if="{{bracketIndex >= 0}}" class="tool-scale">
      <view
        wx:for="{{bracketSteps}}"
        wx:key="*this"
        class="tool-scale__step {{index === bracketIndex ? 'tool-scale__step_on' : ''}}"
      ></view>
    </view>

    <view class="sg-tool-rows">
      <view class="sg-tool-row">
        <text class="sg-tool-row__k">应纳税所得额</text>
        <text class="sg-tool-row__v">{{taxableText}}</text>
      </view>
      <view class="sg-tool-row">
        <text class="sg-tool-row__k">{{mode === 'monthly' ? '税后收入' : '税后年收入'}}</text>
        <text class="sg-tool-row__v">{{netText}}</text>
      </view>
      <view class="sg-tool-row">
        <text class="sg-tool-row__k">实际税率</text>
        <text class="sg-tool-row__v">{{rateText}}</text>
      </view>
      <view class="sg-tool-row">
        <text class="sg-tool-row__k">适用级距</text>
        <text class="sg-tool-row__v">{{bracketLabel}}</text>
      </view>
      <view class="sg-tool-row">
        <text class="sg-tool-row__k">速算扣除数</text>
        <text class="sg-tool-row__v">{{quickText}}</text>
      </view>
    </view>

    <view class="sg-tool-result__actions">
      <glass-button variant="ghost" size="md" block bind:tap="onCopy">
        复制结果
      </glass-button>
    </view>
  </view>

  <view slot="note">
    <glass-card tone="amber" radius="lg" padding="md" depth="soft">
      <view class="sg-tool-note">
        <text class="sg-tool-note__title">试算口径</text>
        <text class="sg-tool-note__text">
          按 2026 年现行综合所得口径试算：月度起征点 5,000 元，年度起征点 60,000 元；
          专项附加扣除按输入值直接扣减。结果仅供参考，实际税额以税务部门口径为准。
        </text>
      </view>
    </glass-card>
  </view>
</glass-tool-shell>

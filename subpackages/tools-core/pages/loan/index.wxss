/* ==========================================================================
   房贷试算 · 空间玻璃页面样式
   - 只使用 --glass-* / --sg-* 令牌，无硬编码色值
   ========================================================================== */

/* ---- 还款方式切换 ---- */
.tool-seg {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  box-sizing: border-box;
  padding-bottom: 2rpx;
}

/* ---- 结果 ---- */
/* ---- 明细行 ---- */
/* ---- 还款计划 ---- */
.tool-block {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  box-sizing: border-box;
  padding-top: 6rpx;
}

.tool-period {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  box-sizing: border-box;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--glass-border);
}

.tool-period__top {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
}

.tool-period__index {
  color: var(--glass-text-2);
  font-size: 24rpx;
}

.tool-period__pay {
  color: var(--glass-text);
  font-family: var(--glass-font-mono);
  font-size: 27rpx;
  font-weight: 700;
}

.tool-period__sub {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 18rpx;
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 20rpx;
}

/* ---- 注释 ---- */
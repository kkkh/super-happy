<glass-tool-shell
  tool-id="bmi"
  title="{{toolName}}"
  kicker="{{kicker}}"
  desc="{{desc}}"
  poster-data="{{posterData}}"
  export-enabled="{{true}}"
  export-name="{{toolName}}"
  state="{{shellState}}"
  run-label="计算 BMI"
  has-result="{{hasResult}}"
  error="{{error}}"
  empty-title="填入身高体重，计算 BMI"
  empty-sub="采用中国成人区间标准"
  bind:run="onRun"
  bind:example="onExample"
  bind:reset="onReset"
>
  <view slot="input" class="sg-tool-fields">
    <glass-input
      label="身高"
      hint="100–250 厘米"
      type="digit"
      maxlength="{{6}}"
      value="{{height}}"
      placeholder="例如 175"
      clearable
      data-field="height"
      bind:input="onInput"
      bind:confirm="onInput"
      aria-label="身高厘米"
    >
      <text slot="suffix" class="sg-tool-unit">厘米</text>
    </glass-input>

    <glass-input
      label="体重"
      hint="20–300 公斤"
      type="digit"
      maxlength="{{6}}"
      value="{{weight}}"
      placeholder="例如 70"
      clearable
      data-field="weight"
      bind:input="onInput"
      bind:confirm="onInput"
      aria-label="体重公斤"
    >
      <text slot="suffix" class="sg-tool-unit">公斤</text>
    </glass-input>
  </view>

  <view slot="result" class="sg-tool-result">
    <view class="sg-tool-result__head">
      <text class="sg-tool-result__label">BMI 指数</text>
      <text class="sg-tool-result__meta">中国成人标准</text>
    </view>

    <view class="sg-tool-result__main">
      <animated-number
        value="{{bmiValue}}"
        decimals="1"
        size="xl"
        tone="aurora"
      />
      <text class="tool-result__badge">{{categoryText}}</text>
    </view>

    <text class="sg-tool-result__caption">{{categoryHint}}</text>

    <view class="tool-scale">
      <view class="tool-scale__track">
        <view class="tool-scale__seg tool-scale__seg-1"></view>
        <view class="tool-scale__seg tool-scale__seg-2"></view>
        <view class="tool-scale__seg tool-scale__seg-3"></view>
        <view class="tool-scale__seg tool-scale__seg-4"></view>
        <view class="tool-scale__marker" style="left: {{markerPercent}}%;"></view>
      </view>
      <view class="tool-scale__labels">
        <text>18.5</text>
        <text>24</text>
        <text>28</text>
      </view>
    </view>

    <view class="sg-tool-rows">
      <view class="sg-tool-row">
        <text class="sg-tool-row__k">参考体重区间</text>
        <text class="sg-tool-row__v">{{idealText}}</text>
      </view>
      <view class="sg-tool-row">
        <text class="sg-tool-row__k">身高 / 体重</text>
        <text class="sg-tool-row__v">{{height}} cm · {{weight}} kg</text>
      </view>
    </view>

    <view class="sg-tool-result__actions">
      <glass-button variant="ghost" size="md" block bind:tap="onCopy">
        复制结果
      </glass-button>
    </view>
  </view>

  <view slot="note">
    <glass-card tone="amber" radius="lg" padding="md" depth="soft">
      <view class="sg-tool-note">
        <text class="sg-tool-note__title">健康提示</text>
        <text class="sg-tool-note__text">
          BMI 只依据身高与体重估算，不能区分肌肉与脂肪，也不适用于未成年人、孕妇、运动员与老年人。结果仅供参考，不构成医疗诊断或健康建议；如有健康问题请咨询专业医生。
        </text>
      </view>
    </glass-card>
  </view>
</glass-tool-shell>

/* ==========================================================================
   随机密码 · 空间玻璃页面样式
   - 只使用 --glass-* / --sg-* 令牌，无硬编码色值
   ========================================================================== */

.tool-field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding-bottom: 8rpx;
}

.tool-field__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.tool-field__label {
  color: var(--glass-text-2);
  font-size: 24rpx;
  font-weight: 600;
}

.tool-field__hint {
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 20rpx;
}

.tool-slider {
  margin: 8rpx 6rpx 0;
}

.tool-scale {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 6rpx;
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 19rpx;
}

.tool-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--glass-border);
  box-sizing: border-box;
}

.tool-switch-row:last-child {
  border-bottom: none;
}

.tool-switch-row__text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.tool-switch-row__title {
  color: var(--glass-text);
  font-size: 25rpx;
  font-weight: 600;
}

.tool-switch-row__sub {
  color: var(--glass-text-3);
  font-size: 20rpx;
  line-height: 1.4;
}

.tool-switch {
  flex: none;
  transform: scale(0.82);
  transform-origin: right center;
}

.tool-password {
  display: block;
  padding: 26rpx 24rpx;
  border: 1rpx solid var(--glass-border-strong);
  border-radius: var(--glass-radius-sm);
  background-color: var(--glass-bg-soft);
  color: var(--glass-text);
  font-family: var(--glass-font-mono);
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.5;
  letter-spacing: 2rpx;
  word-break: break-all;
  box-shadow: inset 0 0 24rpx var(--glass-accent-soft);
  box-sizing: border-box;
}

.tool-meter {
  height: 12rpx;
  border-radius: 999rpx;
  background-color: var(--glass-bg-soft);
  overflow: hidden;
}

.tool-meter__fill {
  height: 100%;
  border-radius: 999rpx;
  background-image: linear-gradient(90deg, var(--sg-ambient-cold), var(--sg-ambient-mint));
  transition: width var(--glass-duration-base) var(--glass-ease-out);
}

.tool-meter__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: -6rpx;
}

.tool-meter__value {
  color: var(--glass-accent-2);
  font-size: 22rpx;
  font-weight: 700;
}

.tool-meter__note {
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 20rpx;
}

.tool-actions {
  padding-top: 6rpx;
}

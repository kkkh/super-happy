/* ==========================================================================
   pages/lab · Spatial Glass 组件样板间
   - 只消费 --sg-* / --glass-* 令牌，不使用旧主页类名
   - 用于真机验证表单、数字、抽屉与 3D 视差
   ========================================================================== */

.lab-page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  padding-top: calc(env(safe-area-inset-top) + 64rpx);
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 180rpx);
  background-color: var(--glass-canvas);
  color: var(--glass-text);
  font-family: var(--glass-font-sans);
  overflow-x: hidden;
}

/* ---- 极光氛围：与主页同源的三片模糊光斑 ---- */
.lab-aurora {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}

.lab-aurora__a {
  position: absolute;
  top: -14%;
  left: -24%;
  width: 98%;
  height: 58%;
}

.lab-aurora__b {
  position: absolute;
  top: 12%;
  right: -30%;
  width: 92%;
  height: 52%;
}

.lab-aurora__c {
  position: absolute;
  bottom: -20%;
  left: -6%;
  width: 104%;
  height: 60%;
}

.lab-head {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  margin-bottom: 44rpx;
}

.lab-kicker {
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 20rpx;
  letter-spacing: 0.14em;
}

.lab-title {
  margin-top: 18rpx;
  color: var(--glass-text);
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.18;
}

.lab-desc {
  margin-top: 16rpx;
  color: var(--glass-text-2);
  font-size: 25rpx;
  line-height: 1.6;
}

.lab-hero {
  position: relative;
  z-index: 1;
  display: block;
  margin-bottom: 36rpx;
}

.lab-hero-copy {
  display: flex;
  flex-direction: column;
  padding: 24rpx 8rpx;
}

.lab-hero-title {
  margin-top: 20rpx;
  color: var(--glass-text);
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.2;
}

.lab-hero-desc {
  margin-top: 16rpx;
  color: var(--glass-text-2);
  font-size: 24rpx;
  line-height: 1.6;
}

.lab-hero-orb {
  position: absolute;
  top: -100rpx;
  right: -70rpx;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background-image: radial-gradient(
    circle at 42% 38%,
    var(--sg-ambient-a-soft) 0%,
    transparent 68%
  );
}

.lab-hero-chip {
  position: absolute;
  right: 28rpx;
  bottom: 28rpx;
  padding: 10rpx 18rpx;
  border: 1rpx solid var(--sg-glass-border);
  border-radius: 999rpx;
  background-color: var(--sg-glass-bg-strong);
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 18rpx;
  letter-spacing: 0.1em;
}

.lab-section {
  position: relative;
  z-index: 1;
  display: block;
  margin-bottom: 28rpx;
}

.lab-section-head {
  display: flex;
  flex-direction: column;
  margin-bottom: 26rpx;
}

.lab-note {
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 18rpx;
  letter-spacing: 0.12em;
}

.lab-section-title {
  margin-top: 10rpx;
  color: var(--glass-text);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.3;
}

.lab-result {
  display: flex;
  flex-direction: column;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--sg-glass-border);
}

.lab-result-label {
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 18rpx;
  letter-spacing: 0.12em;
}

.lab-result-text {
  margin-top: 10rpx;
  color: var(--glass-text);
  font-size: 26rpx;
  line-height: 1.55;
  word-break: break-all;
}

.lab-sheet {
  display: flex;
  flex-direction: column;
  padding: 8rpx 0 24rpx;
}

.lab-sheet-footer {
  padding-top: 8rpx;
}

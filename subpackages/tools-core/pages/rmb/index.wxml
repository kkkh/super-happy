<glass-tool-shell
  tool-id="rmb"
  title="{{toolName}}"
  kicker="{{kicker}}"
  desc="{{desc}}"
  poster-data="{{posterData}}"
  show-run="{{false}}"
  show-example
  has-result="{{hasResult}}"
  error="{{error}}"
  empty-title="输入金额，立即转中文大写"
  empty-sub="支持角、分与整位规则"
  bind:example="onExample"
  bind:reset="onReset"
>
  <view slot="input" class="sg-tool-fields">
    <glass-input
      label="金额"
      hint="0–1 万亿元 · 两位小数"
      type="digit"
      maxlength="{{16}}"
      value="{{amount}}"
      placeholder="例如 12345.67"
      cursor-spacing="{{120}}"
      aria-label="人民币金额"
      bind:input="onInput"
    >
      <text slot="suffix" class="sg-tool-unit">元</text>
    </glass-input>

    <view class="tool-chips">
      <view class="tool-chip">
        <glass-button
          variant="ghost"
          size="sm"
          block
          data-value="100"
          aria-label="填入示例 100"
          bind:tap="onQuick"
        >
          100
        </glass-button>
      </view>
      <view class="tool-chip">
        <glass-button
          variant="ghost"
          size="sm"
          block
          data-value="12345.67"
          aria-label="填入示例 12345.67"
          bind:tap="onQuick"
        >
          12,345.67
        </glass-button>
      </view>
      <view class="tool-chip">
        <glass-button
          variant="ghost"
          size="sm"
          block
          data-value="100000000"
          aria-label="填入示例一亿元"
          bind:tap="onQuick"
        >
          1 亿
        </glass-button>
      </view>
    </view>
  </view>

  <view slot="result" class="sg-tool-result">
    <view class="sg-tool-result__head">
      <text class="sg-tool-result__label">人民币大写</text>
      <text class="sg-tool-result__meta">RMB / UPPER</text>
    </view>

    <text class="tool-result__hero">{{upperText}}</text>

    <view class="sg-tool-rows">
      <view class="sg-tool-row">
        <text class="sg-tool-row__k">小写金额</text>
        <text class="sg-tool-row__v">{{amountText}}</text>
      </view>
      <view class="sg-tool-row">
        <text class="sg-tool-row__k">角分位</text>
        <text class="sg-tool-row__v">{{unitText}}</text>
      </view>
    </view>

    <view class="sg-tool-result__actions">
      <glass-button variant="ghost" size="md" block aria-label="复制大写金额" bind:tap="onCopy">
        复制大写
      </glass-button>
    </view>
  </view>

  <view slot="note">
    <glass-card tone="amber" radius="lg" padding="md" depth="soft">
      <view class="sg-tool-note">
        <text class="sg-tool-note__title">财务写法</text>
        <text class="sg-tool-note__text">
          采用财务规范：零元零壹分、壹元壹角整、壹亿零壹万元整；有角无分时末尾加「整」。
          金额上限为 1 万亿元，不含负号。
        </text>
      </view>
    </glass-card>
  </view>
</glass-tool-shell>

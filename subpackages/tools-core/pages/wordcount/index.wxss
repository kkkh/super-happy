/* ==========================================================================
   字数统计 · 空间玻璃页面样式
   - 只使用 --glass-* / --sg-* 令牌，无硬编码色值
   ========================================================================== */

.tool-stats {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
  padding-top: 4rpx;
  padding-right: 0;
  padding-bottom: 0;
  padding-left: 0;
  box-sizing: border-box;
}

.tool-stat {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  width: calc((100% - 12rpx) / 2);
  padding-top: 20rpx;
  padding-right: 22rpx;
  padding-bottom: 20rpx;
  padding-left: 22rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: var(--glass-radius-sm);
  background-color: var(--glass-bg-soft);
  box-sizing: border-box;
}

.tool-stat__k {
  color: var(--glass-text-3);
  font-size: 21rpx;
}

.tool-stat__v {
  color: var(--glass-text);
  font-family: var(--glass-font-mono);
  font-size: 26rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  word-break: break-all;
}

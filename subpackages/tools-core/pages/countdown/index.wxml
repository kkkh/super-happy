<glass-tool-shell
  tool-id="countdown"
  title="{{toolName}}"
  kicker="{{kicker}}"
  desc="{{desc}}"
  poster-data="{{posterData}}"
  export-enabled="{{true}}"
  export-name="{{toolName}}"
  show-run="{{false}}"
  show-example
  has-result="{{hasResult}}"
  error="{{error}}"
  empty-title="选择目标日，开始倒数"
  empty-sub="目标日默认为今天后 30 天"
  bind:example="onExample"
  bind:reset="onReset"
>
  <view slot="input" class="sg-tool-fields">
    <glass-input
      label="事件名称"
      hint="可留空"
      type="text"
      maxlength="{{20}}"
      value="{{title}}"
      placeholder="例如 新年、考试、纪念日"
      cursor-spacing="{{120}}"
      aria-label="倒数事件名称"
      bind:input="onTitleInput"
    />

    <view class="tool-field">
      <text class="tool-field__label">目标日</text>
      <picker mode="date" value="{{target}}" start="1900-01-01" end="2100-12-31" bindchange="onTargetChange">
        <view
          class="tool-picker"
          hover-class="tool-picker_pressed"
          hover-stay-time="80"
          aria-role="button"
          aria-label="目标日期，当前 {{targetLabel || target}}"
        >
          <text class="tool-picker__text">{{targetLabel || target}}</text>
          <g-icon name="chevron" size="{{24}}" tone="ink4" />
        </view>
      </picker>

      <view class="tool-chips">
        <view class="tool-chip">
          <glass-button variant="ghost" size="sm" block data-days="7" aria-label="目标日设为 7 天后" bind:tap="onQuick">
            7 天后
          </glass-button>
        </view>
        <view class="tool-chip">
          <glass-button variant="ghost" size="sm" block data-days="30" aria-label="目标日设为 30 天后" bind:tap="onQuick">
            30 天后
          </glass-button>
        </view>
        <view class="tool-chip">
          <glass-button variant="ghost" size="sm" block data-days="100" aria-label="目标日设为 100 天后" bind:tap="onQuick">
            100 天后
          </glass-button>
        </view>
      </view>
    </view>
  </view>

  <view slot="result" class="sg-tool-result">
    <view class="sg-tool-result__head">
      <text class="sg-tool-result__label">{{heroLabel}}</text>
      <text class="sg-tool-result__meta">{{title || 'COUNTDOWN'}}</text>
    </view>

    <view class="sg-tool-result__main">
      <animated-number value="{{daysValue}}" size="xl" tone="aurora" />
      <text class="sg-tool-result__unit">天</text>
    </view>

    <text class="sg-tool-result__caption">{{stateText}}</text>

    <view class="sg-tool-rows">
      <view class="sg-tool-row">
        <text class="sg-tool-row__k">目标日</text>
        <text class="sg-tool-row__v">{{targetLabel}}</text>
      </view>
      <view class="sg-tool-row">
        <text class="sg-tool-row__k">星期</text>
        <text class="sg-tool-row__v">{{weekdayText}}</text>
      </view>
      <view class="sg-tool-row">
        <text class="sg-tool-row__k">约合</text>
        <text class="sg-tool-row__v">{{weeksText}}</text>
      </view>
    </view>

    <view class="sg-tool-result__actions">
      <glass-button variant="ghost" size="md" block aria-label="复制倒数日结果" bind:tap="onCopy">
        复制结果
      </glass-button>
    </view>
  </view>

  <view slot="note">
    <glass-card tone="amber" radius="lg" padding="md" depth="soft">
      <view class="sg-tool-note">
        <text class="sg-tool-note__title">只在打开页面时计算</text>
        <text class="sg-tool-note__text">
          倒数日不做后台提醒，不申请订阅消息，也不读取日历或通讯录。打开页面时按本机日期实时计算，关闭即停止。
        </text>
      </view>
    </glass-card>
  </view>
</glass-tool-shell>

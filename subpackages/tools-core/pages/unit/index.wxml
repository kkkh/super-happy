<glass-tool-shell
  tool-id="unit"
  title="{{toolName}}"
  kicker="{{kicker}}"
  desc="{{desc}}"
  poster-data="{{posterData}}"
  show-run="{{false}}"
  show-example
  has-result="{{hasResult}}"
  error="{{error}}"
  empty-title="输入数值，立即换算"
  empty-sub="覆盖长度、数据、时间、压力、能量、功率、角度、频率等 13 类"
  bind:example="onExample"
  bind:reset="onReset"
>
  <view slot="input" class="sg-tool-fields">
    <view class="tool-seg">
      <glass-button
        wx:for="{{categories}}"
        wx:key="*this"
        variant="{{activeCategory === index ? 'primary' : 'ghost'}}"
        size="sm"
        haptic="none"
        data-index="{{index}}"
        aria-label="切换到{{item}}"
        bind:tap="onCategory"
      >
        {{item}}
      </glass-button>
    </view>

    <view class="tool-picks">
      <view class="tool-pick">
        <text class="tool-pick__label">从</text>
        <picker mode="selector" range="{{unitNames}}" value="{{fromIndex}}" bindchange="onFromChange">
          <view
            class="tool-pick__trigger"
            hover-class="tool-pick__trigger_pressed"
            hover-stay-time="80"
            aria-role="button"
            aria-label="从，当前 {{fromName}}，点击切换单位"
          >
            <text class="tool-pick__text">{{fromName}}</text>
            <g-icon name="chevron" size="{{24}}" tone="ink4" />
          </view>
        </picker>
      </view>

      <view class="tool-swap">
        <glass-button
          variant="ghost"
          size="sm"
          shape="rounded"
          haptic="none"
          aria-label="交换单位"
          bind:tap="onSwap"
        >
          ⇄
        </glass-button>
      </view>

      <view class="tool-pick">
        <text class="tool-pick__label">到</text>
        <picker mode="selector" range="{{unitNames}}" value="{{toIndex}}" bindchange="onToChange">
          <view
            class="tool-pick__trigger"
            hover-class="tool-pick__trigger_pressed"
            hover-stay-time="80"
            aria-role="button"
            aria-label="到，当前 {{toName}}，点击切换单位"
          >
            <text class="tool-pick__text">{{toName}}</text>
            <g-icon name="chevron" size="{{24}}" tone="ink4" />
          </view>
        </picker>
      </view>
    </view>

    <glass-input
      label="数值"
      hint="最多 6 位小数"
      type="{{inputType}}"
      maxlength="{{32}}"
      value="{{value}}"
      placeholder="例如 1"
      aria-label="待换算数值"
      bind:input="onInput"
      bind:confirm="onInput"
    />
  </view>

  <view slot="result" class="sg-tool-result">
    <view class="sg-tool-result__head">
      <text class="sg-tool-result__label">换算结果</text>
      <text class="sg-tool-result__meta">{{fromName}} → {{toName}}</text>
    </view>

    <view class="sg-tool-result__main">
      <text class="tool-result__big">{{result}}</text>
      <text class="sg-tool-result__unit">{{toName}}</text>
    </view>

    <text class="sg-tool-result__caption">{{formula}}</text>

    <view class="sg-tool-result__actions">
      <glass-button variant="ghost" size="md" block bind:tap="onCopy">
        复制结果
      </glass-button>
    </view>

    <view wx:if="{{values.length}}" class="tool-block">
      <view class="sg-tool-result__head">
        <text class="sg-tool-result__label">全部单位</text>
        <text class="sg-tool-result__meta">{{values.length}} UNITS</text>
      </view>
      <view class="sg-tool-rows">
        <view wx:for="{{values}}" wx:key="key" class="sg-tool-row">
          <text class="sg-tool-row__k {{item.active ? 'tool-row__k_on' : ''}}">{{item.name}}</text>
          <text class="sg-tool-row__v {{item.active ? 'tool-row__v_on' : ''}}">{{item.value}}</text>
        </view>
      </view>
    </view>
  </view>

  <view slot="note">
    <glass-card tone="amber" radius="lg" padding="md" depth="soft">
      <view class="sg-tool-note">
        <text class="sg-tool-note__title">换算口径</text>
        <text class="sg-tool-note__text">市制单位按中国大陆标准：1 斤 = 500 克，1 市尺 = 1/3 米，1 亩 ≈ 666.67 平方米。温度按摄氏度、华氏度、开尔文标准公式换算；数据按 1024 进制，时间不含月 / 年，马力按公制 735.49875 W。</text>
      </view>
    </glass-card>
  </view>
</glass-tool-shell>

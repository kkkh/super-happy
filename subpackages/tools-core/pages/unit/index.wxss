/* ==========================================================================
   单位换算 · 空间玻璃页面样式
   - 只使用 --glass-* / --sg-* 令牌，无硬编码色值
   ========================================================================== */

/* ---- 分类胶囊 ---- */
.tool-seg {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

/* ---- 单位选择 ---- */
.tool-picks {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  gap: 14rpx;
}

.tool-pick {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.tool-pick__label {
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 19rpx;
  letter-spacing: 0.08em;
}

.tool-pick__trigger {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  box-sizing: border-box;
  padding: 20rpx 22rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: var(--glass-radius-md);
  background-color: var(--glass-bg-soft);
  box-shadow: inset 0 1rpx 0 var(--glass-highlight);
  transition:
    border-color var(--glass-duration-fast) var(--glass-ease-out),
    background-color var(--glass-duration-fast) var(--glass-ease-out);
}

.tool-pick__trigger_pressed {
  border-color: var(--glass-border-strong);
  background-color: var(--glass-bg-strong);
}

.tool-pick__text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--glass-text);
  font-size: 26rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tool-swap {
  flex: 0 0 auto;
  box-sizing: border-box;
  padding-bottom: 2rpx;
}

/* ---- 结果 ---- */
.tool-result__big {
  color: var(--glass-text);
  font-family: var(--glass-font-mono);
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.16;
  letter-spacing: -0.01em;
  word-break: break-all;
}

/* ---- 全部单位 ---- */
.tool-block {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  box-sizing: border-box;
  padding-top: 6rpx;
}

.tool-row__k_on {
  color: var(--glass-accent);
  font-weight: 600;
}

.tool-row__v_on {
  color: var(--glass-accent-2);
  font-weight: 700;
}

/* ---- 注释 ---- */
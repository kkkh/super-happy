/* ==========================================================================
   Hash 与加密计算 · 极客控制台
   - 白昼 / 夜航全部使用 --glass-* 令牌
   - Hash 长字符串强制折行，任何宽度都不撑破屏幕
   ========================================================================== */

.hash-page {
  min-height: 100vh;
  background-color: var(--glass-canvas);
}

.hash-inputs,
.hash-result {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

/* ---- 算法分段 ---- */
.hash-control {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 20rpx 22rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--glass-border);
  border-radius: var(--glass-radius-md);
  background-color: var(--glass-bg);
}

.hash-control__label {
  color: var(--glass-text);
  font-size: 24rpx;
  font-weight: 600;
}

.hash-seg {
  display: flex;
  gap: 6rpx;
  padding: 6rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: 999rpx;
  background-color: var(--glass-bg-soft);
}

.hash-seg_algorithm {
  flex-wrap: nowrap;
}

.hash-seg_case {
  width: 300rpx;
}

.hash-seg__item {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  min-width: 0;
  padding: 0 12rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  color: var(--glass-text-2);
  font-size: 22rpx;
  font-weight: 500;
  text-align: center;
  transition: background-color 180ms var(--glass-ease-out), color 180ms var(--glass-ease-out);
}

.hash-seg__item_active {
  background-color: var(--glass-accent-soft);
  color: var(--glass-accent);
  font-weight: 700;
}

.hash-seg__item_disabled {
  pointer-events: none;
  opacity: 0.5;
}

.hash-seg_algorithm .hash-seg__item {
  flex: 1 1 0;
  padding: 0 6rpx;
  font-size: 20rpx;
}

.hash-pressed {
  opacity: 0.72;
}

/* ---- HMAC Toggle ---- */
.hash-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 88rpx;
  padding: 18rpx 22rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--glass-border);
  border-radius: var(--glass-radius-sm);
  background-color: var(--glass-bg);
}

.hash-switch-row__text {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 6rpx;
}

.hash-switch-row__title {
  color: var(--glass-text);
  font-size: 25rpx;
  font-weight: 500;
}

.hash-switch-row__sub {
  color: var(--glass-text-3);
  font-size: 20rpx;
  line-height: 1.35;
}

.hash-secret {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 20rpx 22rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--glass-border-strong);
  border-radius: var(--glass-radius-sm);
  background-color: var(--glass-accent-soft);
}

.hash-secret__input {
  width: 100%;
  height: 76rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--glass-border);
  border-radius: 16rpx;
  background-color: var(--glass-bg-strong);
  color: var(--glass-text);
  font-size: 25rpx;
}

/* ---- 输入 ---- */
.hash-editor {
  padding: 20rpx 22rpx 18rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--glass-border);
  border-radius: var(--glass-radius-md);
  background-color: var(--glass-bg);
  box-shadow: inset 0 1rpx 0 var(--glass-highlight);
}

.hash-editor__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  padding-bottom: 12rpx;
}

.hash-editor__label {
  color: var(--glass-text);
  font-size: 26rpx;
  font-weight: 600;
}

.hash-editor__count {
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 20rpx;
}

.hash-editor__area {
  width: 100%;
  height: 260rpx;
  padding: 0;
  box-sizing: border-box;
  color: var(--glass-text);
  font-size: 26rpx;
  line-height: 1.7;
  background-color: transparent;
  word-break: break-all;
}

.hash-placeholder {
  color: var(--glass-text-3);
  font-size: 25rpx;
}

/* ---- Loading ---- */
.hash-loading {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
  border: 1rpx solid var(--glass-border-strong);
  border-radius: var(--glass-radius-md);
  background-color: var(--glass-accent-soft);
  animation: hash-fade-in 260ms var(--glass-ease-out);
}

.hash-loading__spinner {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  box-sizing: border-box;
  border: 2rpx solid var(--glass-accent);
  border-top-color: transparent;
  border-radius: 50%;
  animation: hash-spin 720ms linear infinite;
}

.hash-loading__copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 6rpx;
}

.hash-loading__title {
  color: var(--glass-text);
  font-size: 25rpx;
  font-weight: 600;
}

.hash-loading__sub {
  color: var(--glass-text-2);
  font-size: 21rpx;
  line-height: 1.35;
}

/* ---- 结果 ---- */
.hash-summary {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid var(--glass-border-strong);
  border-radius: var(--glass-radius-md);
  background-image: var(--glass-sheen);
  background-color: var(--glass-bg-strong);
  box-shadow: var(--glass-shadow-soft);
}

.hash-summary__left {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 8rpx;
}

.hash-summary__kicker {
  color: var(--glass-accent);
  font-family: var(--glass-font-mono);
  font-size: 19rpx;
  letter-spacing: 0.14em;
}

.hash-summary__title {
  color: var(--glass-text);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.4;
}

.hash-summary__meta {
  flex-shrink: 0;
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 19rpx;
  line-height: 1.5;
  text-align: right;
}

.hash-output {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.hash-output__label {
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 19rpx;
  letter-spacing: 0.1em;
}

.hash-output__value {
  display: block;
  color: var(--glass-text);
  font-family: var(--glass-font-mono);
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1.75;
  letter-spacing: 0.02em;
  word-break: break-all;
  white-space: pre-wrap;
}

.hash-case-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 18rpx 22rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--glass-border);
  border-radius: var(--glass-radius-sm);
  background-color: var(--glass-bg);
}

.hash-actions {
  display: flex;
  gap: 16rpx;
}

.hash-flow-hint {
  color: var(--glass-text-3);
  font-size: 20rpx;
  line-height: 1.4;
  text-align: center;
}

@keyframes hash-spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

@keyframes hash-fade-in {
  from {
    opacity: 0;
    transform: translate3d(0, 8rpx, 0);
  }

  to {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
}

@media (prefers-reduced-motion: reduce) {
  .hash-loading {
    animation-duration: 1ms;
  }

  .hash-loading__spinner {
    animation: none;
  }

  .hash-seg__item {
    transition-duration: 1ms;
  }
}

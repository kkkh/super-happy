/* ==========================================================================
   工期排期 · 日期 / 开关 / 逐日清单
   - 只使用 --glass-* 令牌，无硬编码色值
   ========================================================================== */

.tool-date {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.tool-date__label {
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 19rpx;
  letter-spacing: 0.08em;
}

.tool-date__trigger {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  box-sizing: border-box;
  padding: 20rpx 18rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: var(--glass-radius-md);
  background-color: var(--glass-bg-soft);
  box-shadow: inset 0 1rpx 0 var(--glass-highlight);
  transition:
    border-color var(--glass-duration-fast) var(--glass-ease-out),
    background-color var(--glass-duration-fast) var(--glass-ease-out);
}

.tool-date__trigger_pressed {
  border-color: var(--glass-border-strong);
  background-color: var(--glass-bg-strong);
}

.tool-date__text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--glass-text);
  font-family: var(--glass-font-mono);
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sched-switch {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 4rpx 0;
}

.sched-switch__text {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 4rpx;
}

.sched-switch__title {
  color: var(--glass-text);
  font-size: 22rpx;
}

.sched-switch__sub {
  color: var(--glass-text-3);
  font-size: 18rpx;
}

.sched-list-block {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.sched-list-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  padding: 16rpx 18rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: var(--glass-radius-md);
  background-color: var(--glass-bg-soft);
}

.sched-list-head__title {
  color: var(--glass-text);
  font-size: 21rpx;
}

.sched-list-head__meta {
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 19rpx;
}

.sched-list {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border: 1rpx solid var(--glass-border);
  border-radius: var(--glass-radius-md);
}

.sched-list__row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 13rpx 18rpx;
  border-bottom: 1rpx solid var(--glass-border);
}

.sched-list__date {
  color: var(--glass-text);
  font-family: var(--glass-font-mono);
  font-size: 21rpx;
}

.sched-list__kind {
  color: var(--glass-text-3);
  font-size: 19rpx;
}

.sched-list__note {
  color: var(--glass-text-3);
  font-size: 18rpx;
}

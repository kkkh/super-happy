<glass-tool-shell
  tool-id="url"
  title="{{toolName}}"
  kicker="{{kicker}}"
  desc="{{desc}}"
  poster-data="{{posterData}}"
  export-enabled="{{true}}"
  export-name="{{toolName}}"
  export-content="{{outputText}}"
  show-run="{{false}}"
  show-example
  has-result="{{hasResult}}"
  error="{{error}}"
  empty-title="输入链接或文本，立即编解码"
  empty-sub="支持组件级与完整 URL 两种范围"
  bind:example="onExample"
  bind:reset="onReset"
>
  <view slot="input" class="sg-tool-fields">
    <view class="tool-seg">
      <view
        class="tool-seg__item {{mode === 'encode' ? 'tool-seg__item--active' : ''}}"
        hover-class="tool-press"
        hover-stay-time="80"
        data-mode="encode"
        aria-role="button"
        aria-label="URL 编码"
        bindtap="onMode"
      >
        编码
      </view>
      <view
        class="tool-seg__item {{mode === 'decode' ? 'tool-seg__item--active' : ''}}"
        hover-class="tool-press"
        hover-stay-time="80"
        data-mode="decode"
        aria-role="button"
        aria-label="URL 解码"
        bindtap="onMode"
      >
        解码
      </view>
    </view>

    <view class="tool-seg tool-seg--sub">
      <view
        class="tool-seg__item {{scope === 'component' ? 'tool-seg__item--active' : ''}}"
        hover-class="tool-press"
        hover-stay-time="80"
        data-scope="component"
        aria-role="button"
        aria-label="组件级编码"
        bindtap="onScope"
      >
        encodeURIComponent
      </view>
      <view
        class="tool-seg__item {{scope === 'full' ? 'tool-seg__item--active' : ''}}"
        hover-class="tool-press"
        hover-stay-time="80"
        data-scope="full"
        aria-role="button"
        aria-label="完整 URL 编码"
        bindtap="onScope"
      >
        encodeURI
      </view>
    </view>

    <glass-input
      label="{{mode === 'encode' ? '原始文本' : '已编码文本'}}"
      multiline
      auto-height
      show-count
      value="{{input}}"
      maxlength="{{maxText}}"
      placeholder="粘贴链接或需要编解码的文本"
      cursor-spacing="{{120}}"
      aria-label="{{mode === 'encode' ? '原始文本' : '已编码文本'}}"
      bind:input="onInput"
    />

    <view wx:if="{{mode === 'decode'}}" class="tool-switch-row">
      <view class="tool-switch-row__text">
        <text class="tool-switch-row__title">把 + 当作空格</text>
        <text class="tool-switch-row__sub">表单查询串常见规则</text>
      </view>
      <view class="tool-switch">
        <switch
          checked="{{plusAsSpace}}"
          color="var(--glass-accent)"
          aria-label="把加号当作空格"
          bindchange="onPlus"
        />
      </view>
    </view>
  </view>

  <view slot="result" class="sg-tool-result">
    <view class="sg-tool-result__head">
      <text class="sg-tool-result__label">{{mode === 'encode' ? '编码结果' : '解码结果'}}</text>
      <text class="sg-tool-result__meta">{{inputLengthText}} → {{outputLengthText}}</text>
    </view>

    <text class="tool-output" selectable>{{outputText}}</text>
    <text class="tool-result__note">{{scope === 'component' ? 'encodeURIComponent / 参数值' : 'encodeURI / 完整链接'}}</text>

    <view class="tool-actions">
      <glass-button variant="ghost" size="md" block bind:tap="onCopy">
        复制结果
      </glass-button>
    </view>
  </view>

  <view slot="note">
    <glass-card tone="amber" radius="lg" padding="md" depth="soft">
      <view class="sg-tool-note">
        <text class="sg-tool-note__title">两种范围</text>
        <text class="sg-tool-note__text">
          encodeURIComponent 会编码 : / ? & = 等分隔符，适合参数值；encodeURI 保留 URL 结构，适合整条链接。
          解码失败通常意味着百分号转义不完整。所有内容只在本机处理。
        </text>
      </view>
    </glass-card>
  </view>
</glass-tool-shell>

/* ==========================================================================
   文本对比 · 双栏输入 + 双栏差异阅读
   - 全部使用 --glass-* 令牌，白昼 / 夜航自动切换
   - 输入区固定高度，差异区固定高度 + 双向同步滚动
   ========================================================================== */

.td-page {
  min-height: 100vh;
  background-color: var(--glass-canvas);
}

.td-inputs {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.td-editor {
  padding: 20rpx 22rpx 18rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--glass-border);
  border-radius: var(--glass-radius-md);
  background-color: var(--glass-bg);
  box-shadow: inset 0 1rpx 0 var(--glass-highlight);
}

.td-editor__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  padding-bottom: 12rpx;
}

.td-editor__label {
  color: var(--glass-text);
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 0.02em;
}

.td-editor__count {
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 20rpx;
}

.td-editor__area {
  width: 100%;
  height: 240rpx;
  padding: 0;
  box-sizing: border-box;
  color: var(--glass-text);
  font-size: 26rpx;
  line-height: 1.7;
  background-color: transparent;
  word-break: break-all;
}

.td-placeholder {
  color: var(--glass-text-3);
  font-size: 25rpx;
}

/* ---- Toggle 行 ---- */
.td-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 88rpx;
  padding: 18rpx 22rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--glass-border);
  border-radius: var(--glass-radius-sm);
  background-color: var(--glass-bg);
}

.td-switch-row__text {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 6rpx;
}

.td-switch-row__title {
  color: var(--glass-text);
  font-size: 25rpx;
  font-weight: 500;
}

.td-switch-row__sub {
  color: var(--glass-text-3);
  font-size: 20rpx;
  line-height: 1.35;
}

/* ---- Loading ---- */
.td-loading {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
  border: 1rpx solid var(--glass-border-strong);
  border-radius: var(--glass-radius-md);
  background-color: var(--glass-accent-soft);
  animation: td-fade-in 260ms var(--glass-ease-out);
}

.td-loading__spinner {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  box-sizing: border-box;
  border: 2rpx solid var(--glass-accent);
  border-top-color: transparent;
  border-radius: 50%;
  animation: td-spin 720ms linear infinite;
}

.td-loading__copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 6rpx;
}

.td-loading__title {
  color: var(--glass-text);
  font-size: 25rpx;
  font-weight: 600;
}

.td-loading__sub {
  color: var(--glass-text-2);
  font-size: 21rpx;
  line-height: 1.35;
}

/* ---- 结果统计 ---- */
.td-result {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.td-summary {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid var(--glass-border-strong);
  border-radius: var(--glass-radius-md);
  background-image: var(--glass-sheen);
  background-color: var(--glass-bg-strong);
  box-shadow: var(--glass-shadow-soft);
}

.td-summary__label {
  color: var(--glass-accent);
  font-family: var(--glass-font-mono);
  font-size: 19rpx;
  letter-spacing: 0.12em;
}

.td-summary__text {
  color: var(--glass-text);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.5;
}

.td-stats {
  display: flex;
  gap: 12rpx;
  padding-top: 4rpx;
}

.td-stat {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background-color: var(--glass-bg);
}

.td-stat__k {
  color: var(--glass-text-3);
  font-size: 20rpx;
}

.td-stat__v {
  color: var(--glass-text);
  font-family: var(--glass-font-mono);
  font-size: 28rpx;
  font-weight: 700;
}

.td-stat_insert .td-stat__v {
  color: var(--glass-accent-2);
}

.td-stat_delete .td-stat__v {
  color: var(--glass-danger);
}

.td-note {
  padding: 16rpx 20rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: 18rpx;
  background-color: var(--glass-accent-warm-soft);
  color: var(--glass-text-2);
  font-size: 21rpx;
  line-height: 1.5;
}

/* ---- 双栏差异 ---- */
.td-diff {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.td-diff__card {
  overflow: hidden;
  border: 1rpx solid var(--glass-border);
  border-radius: var(--glass-radius-md);
  background-color: var(--glass-bg);
}

.td-diff__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid var(--glass-border);
  background-color: var(--glass-bg-strong);
}

.td-diff__title {
  color: var(--glass-text);
  font-size: 24rpx;
  font-weight: 600;
}

.td-diff__legend {
  font-family: var(--glass-font-mono);
  font-size: 19rpx;
  letter-spacing: 0.04em;
}

.td-diff__legend_delete {
  color: var(--glass-danger);
}

.td-diff__legend_insert {
  color: var(--glass-accent-2);
}

.td-diff__scroll {
  height: 340rpx;
}

.td-rich {
  display: block;
  padding: 18rpx 22rpx 24rpx;
  box-sizing: border-box;
  color: var(--glass-text);
  font-size: 26rpx;
  line-height: 1.8;
}

/* ---- 流转内容选择 ---- */
.td-result-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.td-flow-mode {
  display: flex;
  gap: 6rpx;
  padding: 6rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: 999rpx;
  background-color: var(--glass-bg);
}

.td-seg {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 14rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  color: var(--glass-text-2);
  font-size: 23rpx;
  font-weight: 500;
  text-align: center;
  transition: background-color 180ms var(--glass-ease-out), color 180ms var(--glass-ease-out);
}

.td-seg_active {
  background-color: var(--glass-accent-soft);
  color: var(--glass-accent);
  font-weight: 600;
}

.td-pressed {
  opacity: 0.72;
}

.td-copy-row {
  display: flex;
  gap: 16rpx;
}

.td-copy-row glass-button {
  flex: 1;
  min-width: 0;
}

.td-flow-hint {
  color: var(--glass-text-3);
  font-size: 20rpx;
  line-height: 1.4;
  text-align: center;
}

/* ---- 动画 ---- */
@keyframes td-spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

@keyframes td-fade-in {
  from {
    opacity: 0;
    transform: translate3d(0, 8rpx, 0);
  }

  to {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
}

@media (prefers-reduced-motion: reduce) {
  .td-loading {
    animation-duration: 1ms;
  }

  .td-loading__spinner {
    animation: none;
  }

  .td-seg {
    transition-duration: 1ms;
  }
}

/* ==========================================================================
   时区换算 · 日期 / 时间 / 时区选择
   - 只使用 --glass-* 令牌，无硬编码色值
   ========================================================================== */
@import "../../styles/tool-seg.wxss";

.tz-grid {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.tz-col {
  flex: 1;
  min-width: 0;
}

.tool-date {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.tool-date__label {
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 19rpx;
  letter-spacing: 0.08em;
}

.tool-date__trigger {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  box-sizing: border-box;
  padding: 20rpx 18rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: var(--glass-radius-md);
  background-color: var(--glass-bg-soft);
  box-shadow: inset 0 1rpx 0 var(--glass-highlight);
  transition:
    border-color var(--glass-duration-fast) var(--glass-ease-out),
    background-color var(--glass-duration-fast) var(--glass-ease-out);
}

.tool-date__trigger_pressed {
  border-color: var(--glass-border-strong);
  background-color: var(--glass-bg-strong);
}

.tool-date__text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--glass-text);
  font-family: var(--glass-font-mono);
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tool-date__hint {
  color: var(--glass-text-3);
  font-size: 19rpx;
}

.tz-dst {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding-top: 2rpx;
}

.tz-dst__text {
  color: var(--glass-text-3);
  font-size: 19rpx;
}

/* ---- 世界时钟 · 城市列表 ---- */
.tz-world {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tz-row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: var(--glass-radius-md);
  background-color: var(--glass-bg-soft);
  box-sizing: border-box;
}

.tz-row__top {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.tz-row__city-wrap {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.tz-row__city {
  color: var(--glass-text);
  font-size: 24rpx;
  font-weight: 700;
}

.tz-row__badge {
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background-color: var(--glass-accent-soft);
  color: var(--glass-accent);
  font-family: var(--glass-font-mono);
  font-size: 17rpx;
  letter-spacing: 0.06em;
}

.tz-row__time {
  color: var(--glass-text);
  font-family: var(--glass-font-mono);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.1;
}

.tz-row__bottom {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.tz-row__meta {
  flex: 1;
  min-width: 0;
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 18rpx;
}

.tz-row__dst {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
}

.tz-row__dst-label {
  color: var(--glass-text-3);
  font-size: 18rpx;
}

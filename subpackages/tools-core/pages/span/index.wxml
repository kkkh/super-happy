<glass-tool-shell
  tool-id="span"
  title="{{toolName}}"
  kicker="{{kicker}}"
  desc="{{desc}}"
  poster-data="{{posterData}}"
  show-run="{{false}}"
  show-example
  has-result="{{hasResult}}"
  error="{{error}}"
  empty-title="选择起止日期，立即计算"
  empty-sub="可选是否包含开始日与排除周末"
  bind:example="onExample"
  bind:reset="onReset"
>
  <view slot="input" class="sg-tool-fields">
    <view class="tool-dates">
      <view class="tool-date">
        <text class="tool-date__label">开始日</text>
        <picker mode="date" value="{{start}}" start="1900-01-01" end="2100-12-31" bindchange="onStartChange">
          <view
            class="tool-date__trigger"
            hover-class="tool-date__trigger_pressed"
            hover-stay-time="80"
            aria-role="button"
            aria-label="开始日期，当前 {{startLabel || start}}"
          >
            <text class="tool-date__text">{{startLabel || start}}</text>
            <g-icon name="chevron" size="{{24}}" tone="ink4" />
          </view>
        </picker>
        <text class="tool-date__hint">{{startWeek}}</text>
      </view>

      <view class="tool-dates__arrow" aria-hidden="true">→</view>

      <view class="tool-date">
        <text class="tool-date__label">结束日</text>
        <picker mode="date" value="{{end}}" start="1900-01-01" end="2100-12-31" bindchange="onEndChange">
          <view
            class="tool-date__trigger"
            hover-class="tool-date__trigger_pressed"
            hover-stay-time="80"
            aria-role="button"
            aria-label="结束日期，当前 {{endLabel || end}}"
          >
            <text class="tool-date__text">{{endLabel || end}}</text>
            <g-icon name="chevron" size="{{24}}" tone="ink4" />
          </view>
        </picker>
        <text class="tool-date__hint">{{endWeek}}</text>
      </view>
    </view>

    <view class="tool-seg">
      <glass-button
        variant="ghost"
        size="sm"
        haptic="none"
        data-days="7"
        aria-label="结束日设为开始日后 7 天"
        bind:tap="onQuick"
      >
        +7 天
      </glass-button>
      <glass-button
        variant="ghost"
        size="sm"
        haptic="none"
        data-days="30"
        aria-label="结束日设为开始日后 30 天"
        bind:tap="onQuick"
      >
        +30 天
      </glass-button>
      <glass-button
        variant="ghost"
        size="sm"
        haptic="none"
        data-days="90"
        aria-label="结束日设为开始日后 90 天"
        bind:tap="onQuick"
      >
        +90 天
      </glass-button>
    </view>

    <view class="tool-switch">
      <view class="tool-switch__text">
        <text class="tool-switch__title">包含开始日</text>
        <text class="tool-switch__sub">开启后，开始日当天也计入</text>
      </view>
      <switch checked="{{includeStart}}" color="var(--glass-accent)" aria-label="包含开始日" bindchange="onIncludeStart" />
    </view>

    <view class="tool-switch">
      <view class="tool-switch__text">
        <text class="tool-switch__title">排除周末</text>
        <text class="tool-switch__sub">工作日只排除周六与周日</text>
      </view>
      <switch checked="{{excludeWeekend}}" color="var(--glass-accent)" aria-label="排除周末" bindchange="onExcludeWeekend" />
    </view>
  </view>

  <view slot="result" class="sg-tool-result">
    <view class="sg-tool-result__head">
      <text class="sg-tool-result__label">自然日</text>
      <text class="sg-tool-result__meta">{{startLabel}} → {{endLabel}}</text>
    </view>

    <view class="sg-tool-result__main">
      <animated-number
        value="{{calendarDays}}"
        decimals="0"
        suffix=" 天"
        size="xl"
        tone="aurora"
      />
    </view>

    <text class="sg-tool-result__caption">{{includeStart ? '含开始日' : '不含开始日'}} · {{excludeWeekend ? '排除周末' : '不排除周末'}}</text>

    <view class="tool-span">
      <view class="tool-span__dates">
        <view class="tool-span__point">
          <text class="tool-span__k">START</text>
          <text class="tool-span__v">{{startLabel}}</text>
        </view>
        <view class="tool-span__point tool-span__point_right">
          <text class="tool-span__k">END</text>
          <text class="tool-span__v">{{endLabel}}</text>
        </view>
      </view>
      <view class="tool-span__track">
        <view class="tool-span__dot"></view>
        <view class="tool-span__line"></view>
        <view class="tool-span__dot"></view>
      </view>
    </view>

    <view class="sg-tool-rows">
      <view class="sg-tool-row">
        <text class="sg-tool-row__k">工作日</text>
        <text class="sg-tool-row__v">{{workText}}</text>
      </view>
      <view class="sg-tool-row">
        <text class="sg-tool-row__k">周末</text>
        <text class="sg-tool-row__v">{{weekendText}}</text>
      </view>
      <view class="sg-tool-row">
        <text class="sg-tool-row__k">约合</text>
        <text class="sg-tool-row__v">{{weekText}}</text>
      </view>
    </view>

    <view class="sg-tool-result__actions">
      <glass-button variant="ghost" size="md" block bind:tap="onCopy">
        复制结果
      </glass-button>
    </view>
  </view>

  <view slot="note">
    <glass-card tone="amber" radius="lg" padding="md" depth="soft">
      <view class="sg-tool-note">
        <text class="sg-tool-note__title">计算口径</text>
        <text class="sg-tool-note__text">
          自然日按本地日期零点计算；工作日只排除周六、周日，不含法定节假日与调休。
          跨时区、系统时间异常或官方调休变化时，请以权威日历为准。
        </text>
      </view>
    </glass-card>
  </view>
</glass-tool-shell>

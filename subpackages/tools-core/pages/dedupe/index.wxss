/* ==========================================================================
   去重排序 · 空间玻璃页面样式
   - 只使用 --glass-* / --sg-* 令牌，无硬编码色值
   ========================================================================== */

.tool-field {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.tool-field__label {
  color: var(--glass-text-2);
  font-size: 24rpx;
  font-weight: 600;
}

.tool-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--glass-border);
  box-sizing: border-box;
}

.tool-switch-row:last-child {
  border-bottom: none;
}

.tool-switch-row__text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.tool-switch-row__title {
  color: var(--glass-text);
  font-size: 25rpx;
  font-weight: 600;
}

.tool-switch-row__sub {
  color: var(--glass-text-3);
  font-size: 20rpx;
  line-height: 1.4;
}

.tool-switch {
  flex: none;
  transform: scale(0.82);
  transform-origin: right center;
}

.tool-seg {
  display: flex;
  gap: 6rpx;
  padding: 6rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: 999rpx;
  background-color: var(--glass-bg-soft);
  box-sizing: border-box;
}

.tool-seg__item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 62rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: var(--glass-text-2);
  font-size: 23rpx;
  font-weight: 600;
  text-align: center;
  box-sizing: border-box;
  transition:
    color var(--glass-duration-fast) var(--glass-ease-out),
    background-color var(--glass-duration-fast) var(--glass-ease-out);
}

.tool-seg__item--active {
  background-color: var(--glass-accent-soft);
  color: var(--glass-accent);
  box-shadow: var(--glass-shadow-soft);
}

.tool-press {
  opacity: 0.86;
  transform: scale(0.97);
}

.tool-result__count {
  display: flex;
  align-items: baseline;
}

.tool-output {
  display: block;
  padding: 22rpx 24rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: var(--glass-radius-sm);
  background-color: var(--glass-bg-soft);
  color: var(--glass-text);
  font-family: var(--glass-font-mono);
  font-size: 25rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
  box-sizing: border-box;
}

.tool-output--empty {
  padding: 40rpx 24rpx;
  border-style: dashed;
  border-color: var(--glass-border-strong);
  color: var(--glass-text-3);
  font-size: 24rpx;
  text-align: center;
}

.tool-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.tool-stat {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: var(--glass-radius-sm);
  background-color: var(--glass-bg-soft);
  box-sizing: border-box;
}

.tool-stat__k {
  color: var(--glass-text-3);
  font-size: 20rpx;
}

.tool-stat__v {
  color: var(--glass-text);
  font-family: var(--glass-font-mono);
  font-size: 28rpx;
  font-weight: 700;
}

.tool-actions {
  padding-top: 6rpx;
}

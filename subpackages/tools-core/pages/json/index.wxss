/* ==========================================================================
   JSON 格式化 · 空间玻璃页面样式
   - 只使用 --glass-* / --sg-* 令牌，无硬编码色值
   ========================================================================== */

.tool-seg {
  display: flex;
  gap: 6rpx;
  padding: 6rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: 999rpx;
  background-color: var(--glass-bg-soft);
  box-sizing: border-box;
}

.tool-seg--sub {
  border-radius: var(--glass-radius-sm);
}

.tool-seg__item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 62rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: var(--glass-text-2);
  font-size: 23rpx;
  font-weight: 600;
  text-align: center;
  box-sizing: border-box;
  transition:
    color var(--glass-duration-fast) var(--glass-ease-out),
    background-color var(--glass-duration-fast) var(--glass-ease-out);
}

.tool-seg--sub .tool-seg__item {
  border-radius: var(--glass-radius-sm);
}

.tool-seg__item--active {
  background-color: var(--glass-accent-soft);
  color: var(--glass-accent);
  box-shadow: var(--glass-shadow-soft);
}

.tool-press {
  opacity: 0.86;
  transform: scale(0.97);
}

.tool-output {
  display: block;
  padding: 24rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: var(--glass-radius-sm);
  background-color: var(--glass-bg-soft);
  color: var(--glass-text);
  font-family: var(--glass-font-mono);
  font-size: 24rpx;
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-all;
  box-sizing: border-box;
}

.tool-result__note {
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 20rpx;
}

.tool-actions {
  padding-top: 6rpx;
}

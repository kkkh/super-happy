/* ==========================================================================
   Base64 · 空间玻璃页面样式
   - 只使用 --glass-* / --sg-* 令牌，无硬编码色值
   ========================================================================== */

.tool-seg {
  display: flex;
  gap: 6rpx;
  padding: 6rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: 999rpx;
  background-color: var(--glass-bg-soft);
  box-sizing: border-box;
}

.tool-seg__item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 62rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: var(--glass-text-2);
  font-size: 23rpx;
  font-weight: 600;
  text-align: center;
  box-sizing: border-box;
  transition:
    color var(--glass-duration-fast) var(--glass-ease-out),
    background-color var(--glass-duration-fast) var(--glass-ease-out);
}

.tool-seg__item--active {
  background-color: var(--glass-accent-soft);
  color: var(--glass-accent);
  box-shadow: var(--glass-shadow-soft);
}

.tool-press {
  opacity: 0.86;
  transform: scale(0.97);
}

.tool-output {
  display: block;
  padding: 24rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: var(--glass-radius-sm);
  background-color: var(--glass-bg-soft);
  color: var(--glass-text);
  font-family: var(--glass-font-mono);
  font-size: 25rpx;
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-all;
  box-sizing: border-box;
}

.tool-result__note {
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 20rpx;
}

.tool-actions {
  padding-top: 6rpx;
}

/* ---- 图片模式 ---- */
.b64-blank {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-sizing: border-box;
  padding: 56rpx 24rpx;
  border: 1rpx dashed var(--glass-border-strong);
  border-radius: var(--glass-radius-md);
  background-color: var(--glass-bg-soft);
}

.b64-blank__title {
  color: var(--glass-text);
  font-size: 27rpx;
  font-weight: 700;
}

.b64-blank__sub {
  color: var(--glass-text-3);
  font-size: 21rpx;
  line-height: 1.5;
  text-align: center;
}

.b64-source {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  box-sizing: border-box;
  padding: 14rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: var(--glass-radius-md);
  background-color: var(--glass-bg-soft);
}

.b64-source__img {
  display: block;
  width: 100%;
  height: 320rpx;
  border-radius: var(--glass-radius-xs);
  background-color: var(--glass-bg);
}

.b64-source__meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.b64-source__name {
  color: var(--glass-text);
  font-size: 24rpx;
  font-weight: 600;
  word-break: break-all;
}

.b64-source__sub {
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 19rpx;
}

.b64-switch-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  box-sizing: border-box;
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: var(--glass-radius-sm);
  background-color: var(--glass-bg-soft);
}

.b64-switch-row__text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.b64-switch-row__title {
  color: var(--glass-text);
  font-size: 24rpx;
  font-weight: 600;
}

.b64-switch-row__sub {
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 18rpx;
}

.b64-hint {
  color: var(--glass-text-3);
  font-size: 20rpx;
  line-height: 1.6;
}

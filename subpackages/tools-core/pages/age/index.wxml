<glass-tool-shell
  tool-id="age"
  title="{{toolName}}"
  kicker="{{kicker}}"
  desc="{{desc}}"
  poster-data="{{posterData}}"
  export-enabled="{{true}}"
  export-name="{{toolName}}"
  show-run="{{false}}"
  show-example
  has-result="{{hasResult}}"
  error="{{error}}"
  empty-title="选择生日，立即计算周岁"
  empty-sub="基准日默认今天，可自由调整"
  bind:example="onExample"
  bind:reset="onReset"
>
  <view slot="input" class="sg-tool-fields">
    <view class="tool-field">
      <text class="tool-field__label">生日</text>
      <picker
        mode="date"
        value="{{birth || '2000-01-01'}}"
        start="1900-01-01"
        end="{{ref}}"
        bindchange="onBirthChange"
      >
        <view
          class="tool-picker"
          hover-class="tool-picker_pressed"
          hover-stay-time="80"
          aria-role="button"
          aria-label="生日，当前 {{birthLabel || '未选择'}}"
        >
          <text class="tool-picker__text{{birthLabel ? '' : ' tool-picker__text_placeholder'}}">{{birthLabel || '选择生日'}}</text>
          <g-icon name="chevron" size="{{24}}" tone="ink4" />
        </view>
      </picker>
    </view>

    <view class="tool-field">
      <view class="tool-field__head">
        <text class="tool-field__label">基准日</text>
        <glass-button
          variant="ghost"
          size="sm"
          aria-label="基准日设为今天"
          bind:tap="onToday"
        >
          回到今天
        </glass-button>
      </view>
      <picker mode="date" value="{{ref}}" start="1900-01-01" end="2100-12-31" bindchange="onRefChange">
        <view
          class="tool-picker"
          hover-class="tool-picker_pressed"
          hover-stay-time="80"
          aria-role="button"
          aria-label="参考日期，当前 {{refLabel}}"
        >
          <text class="tool-picker__text">{{refLabel}}</text>
          <g-icon name="chevron" size="{{24}}" tone="ink4" />
        </view>
      </picker>
    </view>
  </view>

  <view slot="result" class="sg-tool-result">
    <view class="sg-tool-result__head">
      <text class="sg-tool-result__label">周岁</text>
      <text class="sg-tool-result__meta">{{birthLabel}} / {{refLabel}}</text>
    </view>

    <view class="sg-tool-result__main">
      <animated-number value="{{ageValue}}" size="xl" tone="aurora" />
      <text class="sg-tool-result__unit">岁</text>
    </view>

    <text class="sg-tool-result__caption">{{ageSub}}</text>

    <view class="sg-tool-rows">
      <view class="sg-tool-row">
        <text class="sg-tool-row__k">累计月龄</text>
        <text class="sg-tool-row__v">{{totalMonthsText}}</text>
      </view>
      <view class="sg-tool-row">
        <text class="sg-tool-row__k">总天数</text>
        <text class="sg-tool-row__v">{{totalDaysText}}</text>
      </view>
      <view class="sg-tool-row">
        <text class="sg-tool-row__k">虚岁（按年份）</text>
        <text class="sg-tool-row__v">{{virtualText}}</text>
      </view>
      <view class="sg-tool-row">
        <text class="sg-tool-row__k">下次生日</text>
        <text class="sg-tool-row__v">{{nextDaysText}}</text>
      </view>
      <view class="sg-tool-row">
        <text class="sg-tool-row__k">生日日期</text>
        <text class="sg-tool-row__v">{{nextDateText}}</text>
      </view>
    </view>

    <view class="sg-tool-result__actions">
      <glass-button variant="ghost" size="md" block aria-label="复制年龄结果" bind:tap="onCopy">
        复制结果
      </glass-button>
    </view>
  </view>

  <view slot="note">
    <glass-card tone="amber" radius="lg" padding="md" depth="soft">
      <view class="sg-tool-note">
        <text class="sg-tool-note__title">计算口径</text>
        <text class="sg-tool-note__text">
          周岁按公历生日逐月逐日计算；虚岁为「基准年 − 出生年 + 1」的传统计法，仅供参考。
          2 月 29 日生日在平年时，下次生日按 2 月 28 日提示。
        </text>
      </view>
    </glass-card>
  </view>
</glass-tool-shell>

<glass-tool-shell
  tool-id="timestamp"
  title="{{toolName}}"
  kicker="{{kicker}}"
  desc="{{desc}}"
  poster-data="{{posterData}}"
  show-run="{{false}}"
  show-example
  has-result="{{hasResult}}"
  error="{{error}}"
  empty-title="输入时间戳或选择日期时间"
  empty-sub="秒与毫秒可随时切换"
  bind:example="onExample"
  bind:reset="onReset"
>
  <view slot="input" class="sg-tool-fields">
    <view class="tool-seg">
      <view class="tool-seg__item">
        <glass-button
          variant="{{mode === 'to-date' ? 'primary' : 'ghost'}}"
          size="sm"
          block
          data-mode="to-date"
          aria-label="时间戳转日期"
          bind:tap="onMode"
        >
          时间戳 → 日期
        </glass-button>
      </view>
      <view class="tool-seg__item">
        <glass-button
          variant="{{mode === 'to-stamp' ? 'primary' : 'ghost'}}"
          size="sm"
          block
          data-mode="to-stamp"
          aria-label="日期转时间戳"
          bind:tap="onMode"
        >
          日期 → 时间戳
        </glass-button>
      </view>
    </view>

    <view class="tool-seg">
      <view class="tool-seg__item">
        <glass-button
          variant="{{unit === 's' ? 'primary' : 'ghost'}}"
          size="sm"
          block
          data-unit="s"
          aria-label="秒级时间戳"
          bind:tap="onUnit"
        >
          秒（10 位）
        </glass-button>
      </view>
      <view class="tool-seg__item">
        <glass-button
          variant="{{unit === 'ms' ? 'primary' : 'ghost'}}"
          size="sm"
          block
          data-unit="ms"
          aria-label="毫秒级时间戳"
          bind:tap="onUnit"
        >
          毫秒（13 位）
        </glass-button>
      </view>
    </view>

    <block wx:if="{{mode === 'to-date'}}">
      <view class="tool-field">
        <view class="tool-field__head">
          <text class="tool-field__label">时间戳</text>
          <glass-button variant="ghost" size="sm" aria-label="填入当前时间戳" bind:tap="onNow">
            现在
          </glass-button>
        </view>
        <glass-input
          type="number"
          maxlength="{{14}}"
          value="{{stampValue}}"
          placeholder="例如 1700000000"
          cursor-spacing="{{120}}"
          aria-label="时间戳数值"
          bind:input="onStampInput"
        />
      </view>
    </block>

    <block wx:else>
      <view class="tool-field">
        <view class="tool-field__head">
          <text class="tool-field__label">日期与时间</text>
          <glass-button variant="ghost" size="sm" aria-label="填入当前日期时间" bind:tap="onNow">
            现在
          </glass-button>
        </view>
        <view class="tool-picker-row">
          <view class="tool-picker-row__col">
            <picker mode="date" value="{{dateValue}}" start="1900-01-01" end="2100-12-31" bindchange="onDateChange">
              <view
                class="tool-picker"
                hover-class="tool-picker_pressed"
                hover-stay-time="80"
                aria-role="button"
                aria-label="日期，当前 {{dateValue}}"
              >
                <text class="tool-picker__text">{{dateValue}}</text>
                <g-icon name="chevron" size="{{24}}" tone="ink4" />
              </view>
            </picker>
          </view>
          <view class="tool-picker-row__col tool-picker-row__col_time">
            <picker mode="time" value="{{timeValue}}" bindchange="onTimeChange">
              <view
                class="tool-picker"
                hover-class="tool-picker_pressed"
                hover-stay-time="80"
                aria-role="button"
                aria-label="时间，当前 {{timeValue}}"
              >
                <text class="tool-picker__text">{{timeValue}}</text>
                <g-icon name="chevron" size="{{24}}" tone="ink4" />
              </view>
            </picker>
          </view>
        </view>
      </view>
    </block>
  </view>

  <view slot="result" class="sg-tool-result">
    <view class="sg-tool-result__head">
      <text class="sg-tool-result__label">{{heroLabel}}</text>
      <text class="sg-tool-result__meta">{{unit === 's' ? 'SECONDS / 秒' : 'MILLISECONDS / 毫秒'}}</text>
    </view>

    <view class="sg-tool-result__main">
      <text wx:if="{{mode === 'to-date'}}" class="tool-result__hero">{{localText}}</text>
      <animated-number wx:else value="{{stampNumber}}" size="lg" tone="aurora" separator="" />
    </view>

    <text class="sg-tool-result__caption">{{weekdayText}} · UTC+8 / LOCAL</text>

    <view wx:if="{{mode === 'to-date'}}" class="sg-tool-rows">
      <view class="sg-tool-row">
        <text class="sg-tool-row__k">UTC 时间</text>
        <text class="sg-tool-row__v">{{utcText}}</text>
      </view>
      <view class="sg-tool-row">
        <text class="sg-tool-row__k">星期</text>
        <text class="sg-tool-row__v">{{weekdayText}}</text>
      </view>
      <view class="sg-tool-row">
        <text class="sg-tool-row__k">中文日期</text>
        <text class="sg-tool-row__v">{{cnText}}</text>
      </view>
      <view class="sg-tool-row">
        <text class="sg-tool-row__k">原始时间戳</text>
        <text class="sg-tool-row__v">{{stampValue}} · {{unit === 's' ? '秒' : '毫秒'}}</text>
      </view>
    </view>

    <view wx:else class="sg-tool-rows">
      <view class="sg-tool-row">
        <text class="sg-tool-row__k">本地时间</text>
        <text class="sg-tool-row__v">{{localText}}</text>
      </view>
      <view class="sg-tool-row">
        <text class="sg-tool-row__k">UTC 时间</text>
        <text class="sg-tool-row__v">{{utcText}}</text>
      </view>
      <view class="sg-tool-row">
        <text class="sg-tool-row__k">星期</text>
        <text class="sg-tool-row__v">{{weekdayText}}</text>
      </view>
      <view class="sg-tool-row">
        <text class="sg-tool-row__k">中文日期</text>
        <text class="sg-tool-row__v">{{cnText}}</text>
      </view>
    </view>

    <view class="sg-tool-result__actions">
      <glass-button variant="ghost" size="md" block aria-label="复制时间戳结果" bind:tap="onCopy">
        复制结果
      </glass-button>
    </view>
  </view>

  <view slot="note">
    <glass-card tone="amber" radius="lg" padding="md" depth="soft">
      <view class="sg-tool-note">
        <text class="sg-tool-note__title">时区说明</text>
        <text class="sg-tool-note__text">
          本地时间按设备时区显示，同时附 UTC 对照，避免跨时区误读。时间戳只表示绝对时刻，不包含时区信息。
          有效范围为 1900–2100 年。
        </text>
      </view>
    </glass-card>
  </view>
</glass-tool-shell>

@import "../../styles/qweather.wxss";

.qw-page {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: var(--glass-canvas);
  color: var(--glass-text);
}

/* 晨瓷主题：白色 SVG 图标反相为深色 */
.qw-page.theme-light {
  --qw-icon-filter: invert(1);
  /* 大面积实心图标在浅色底上过重，略降不透明度 */
  --qw-icon-opacity: 0.8;
  /* AQI 官方色在浅色底上对比度不足，文字改用主墨色，颜色保留在边框与圆点上 */
  --qw-aqi-text: var(--glass-text);
}

.qw-page__aurora {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
  z-index: 0;
}

.qw-page__blob {
  position: absolute;
  width: 720rpx;
  height: 720rpx;
  border-radius: 50%;
  filter: blur(90rpx);
  opacity: 0.7;
}

.qw-page__blob--a {
  top: -320rpx;
  left: -220rpx;
  background: radial-gradient(circle, var(--glass-aurora-1), transparent 68%);
  animation: qw-drift-a 16s ease-in-out infinite alternate;
}

.qw-page__blob--b {
  top: 240rpx;
  right: -320rpx;
  background: radial-gradient(circle, var(--glass-aurora-2), transparent 70%);
  animation: qw-drift-b 20s ease-in-out infinite alternate;
}

.qw-page__grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(var(--glass-border) 1rpx, transparent 1rpx),
    linear-gradient(90deg, var(--glass-border) 1rpx, transparent 1rpx);
  background-size: 120rpx 120rpx;
  opacity: 0.12;
  mask-image: radial-gradient(120% 70% at 50% 0%, #000 20%, transparent 78%);
}

@keyframes qw-drift-a {
  from { transform: translate3d(0, 0, 0) scale(1); }
  to { transform: translate3d(40rpx, 30rpx, 0) scale(1.08); }
}

@keyframes qw-drift-b {
  from { transform: translate3d(0, 0, 0) scale(1.04); }
  to { transform: translate3d(-46rpx, 24rpx, 0) scale(1); }
}

@media (prefers-reduced-motion: reduce) {
  .qw-page__blob {
    animation: none;
  }
}

/* ---- 导航 ---- */

.qw-nav {
  position: relative;
  z-index: 4;
  flex-shrink: 0;
  padding-left: 24rpx;
}

.qw-nav__row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14rpx;
}

.qw-nav__back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  flex-shrink: 0;
  border-radius: 50%;
  border: 1rpx solid var(--glass-border);
  background: var(--glass-bg);
  color: var(--glass-text);
  font-size: 42rpx;
  line-height: 1;
  padding-bottom: 6rpx;
  box-sizing: border-box;
}

.qw-nav__back--press {
  opacity: 0.72;
}

.qw-nav__title-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 2rpx;
}

.qw-nav__title {
  color: var(--glass-text);
  font-size: 32rpx;
  font-size: calc(32rpx * var(--fs-scale, 1));
  font-weight: 700;
  line-height: 1.2;
}

.qw-nav__sub {
  overflow: hidden;
  color: var(--glass-text-3);
  font-size: 18rpx;
  font-size: calc(18rpx * var(--fs-scale, 1));
  line-height: 1.3;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.qw-nav__action {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 22rpx;
  flex-shrink: 0;
  border-radius: 999rpx;
  border: 1rpx solid var(--glass-border);
  background: var(--glass-bg);
  color: var(--glass-accent-text);
  font-family: var(--glass-font-mono, monospace);
  font-size: 19rpx;
  font-size: calc(19rpx * var(--fs-scale, 1));
  letter-spacing: 1rpx;
}

.qw-nav__action--press {
  opacity: 0.72;
}

/* ---- Tab ---- */

.qw-tabs {
  position: relative;
  z-index: 3;
  flex-shrink: 0;
  padding: 10rpx 24rpx 12rpx;
}

.qw-tabs__inner {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 8rpx;
}

.qw-tab {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 62rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  flex: none;
  border: 1rpx solid var(--glass-border);
  border-radius: 999rpx;
  background: var(--glass-bg-soft);
  color: var(--glass-text-2);
  font-size: 21rpx;
  font-size: calc(21rpx * var(--fs-scale, 1));
  line-height: 1.2;
  white-space: nowrap;
}

.qw-tab--active {
  border-color: var(--glass-accent-glow);
  background: var(--glass-accent-soft);
  color: var(--glass-text);
  font-weight: 600;
  box-shadow: 0 0 24rpx rgba(143, 155, 255, 0.18);
}

.qw-tab__dot {
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  width: 6rpx;
  height: 6rpx;
  margin-left: -3rpx;
  border-radius: 50%;
  background: var(--glass-accent-text);
}

/* ---- 内容 ---- */

.qw-scroll {
  position: relative;
  z-index: 2;
  flex: 1;
  min-height: 0;
}

.qw-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 10rpx 24rpx 0;
  box-sizing: border-box;
}

.qw-location {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid var(--glass-accent-glow);
  border-radius: var(--glass-radius-md, 24rpx);
  background: var(--glass-accent-soft);
}

.qw-location__text {
  flex: 1;
  min-width: 0;
  color: var(--glass-text-2);
  font-size: 20rpx;
  font-size: calc(20rpx * var(--fs-scale, 1));
  line-height: 1.5;
}

.qw-location__action {
  flex-shrink: 0;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--glass-accent-glow);
  background: var(--glass-bg);
  color: var(--glass-text);
  font-size: 19rpx;
  font-size: calc(19rpx * var(--fs-scale, 1));
}

.qw-location__action--press {
  opacity: 0.72;
}

.qw-hint {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: var(--glass-radius-md, 24rpx);
  background: var(--glass-bg-soft);
}

.qw-hint__kicker {
  color: var(--glass-accent-text);
  font-family: var(--glass-font-mono, monospace);
  font-size: 17rpx;
  font-size: calc(17rpx * var(--fs-scale, 1));
  letter-spacing: 1rpx;
}

.qw-hint__text {
  color: var(--glass-text-3);
  font-size: 19rpx;
  font-size: calc(19rpx * var(--fs-scale, 1));
  line-height: 1.6;
}

/* ---- API 入口 ---- */

.qw-entry {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 26rpx;
  border: 1rpx solid var(--glass-border-strong);
  border-radius: var(--glass-radius-lg, 32rpx);
  background:
    radial-gradient(120% 120% at 0% 0%, rgba(109, 120, 255, 0.2), transparent 62%),
    radial-gradient(100% 120% at 100% 100%, rgba(95, 220, 199, 0.14), transparent 64%),
    var(--glass-bg);
}

.qw-entry--press {
  opacity: 0.86;
}

.qw-entry__copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.qw-entry__title {
  color: var(--glass-text);
  font-size: 27rpx;
  font-size: calc(27rpx * var(--fs-scale, 1));
  font-weight: 700;
}

.qw-entry__desc {
  color: var(--glass-text-3);
  font-size: 18rpx;
  font-size: calc(18rpx * var(--fs-scale, 1));
  line-height: 1.6;
}

.qw-entry__go {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--glass-accent-glow);
  background: var(--glass-accent-soft);
  color: var(--glass-text);
  font-size: 21rpx;
  font-size: calc(21rpx * var(--fs-scale, 1));
  font-weight: 600;
}

.qw-page__source {
  margin-top: 2rpx;
  padding: 0 6rpx;
}

.qw-safe {
  height: calc(env(safe-area-inset-bottom) + 48rpx);
}

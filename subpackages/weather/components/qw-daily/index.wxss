@import "../../styles/qweather.wxss";

.qw-daily {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.qw-daily__ranges {
  margin: -6rpx 0 12rpx;
}

.qw-daily__row {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--glass-border);
  border-radius: 24rpx;
  background: var(--glass-bg-soft);
}

.qw-daily__row--today {
  border-color: var(--glass-accent-glow);
  background: var(--glass-accent-soft);
}

.qw-daily__main {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.qw-daily__date {
  display: flex;
  width: 92rpx;
  flex: none;
  flex-direction: column;
  gap: 2rpx;
}

.qw-daily__week {
  color: var(--glass-text);
  font-size: 22rpx;
  font-size: calc(22rpx * var(--fs-scale, 1));
  font-weight: 600;
}

.qw-daily__day {
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono, monospace);
  font-size: 17rpx;
  font-size: calc(17rpx * var(--fs-scale, 1));
}

.qw-daily__icons {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: row;
  gap: 12rpx;
}

.qw-daily__icon-cell {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: row;
  align-items: center;
  gap: 6rpx;
  color: var(--glass-text-2);
  font-size: 18rpx;
  font-size: calc(18rpx * var(--fs-scale, 1));
  line-height: 1.3;
}

.qw-daily__icon-cell text {
  white-space: normal;
}

.qw-daily__icon-cell--night {
  opacity: 0.86;
}

.qw-daily__temps {
  display: flex;
  width: 82rpx;
  flex: none;
  flex-direction: column;
  align-items: flex-end;
  gap: 2rpx;
}

.qw-daily__temp-max {
  color: var(--glass-text);
  font-size: 26rpx;
  font-size: calc(26rpx * var(--fs-scale, 1));
  font-weight: 700;
}

.qw-daily__temp-min {
  color: var(--glass-text-3);
  font-size: 21rpx;
  font-size: calc(21rpx * var(--fs-scale, 1));
}

.qw-daily__chevron {
  width: 24rpx;
  flex: none;
  color: var(--glass-text-3);
  font-size: 22rpx;
  text-align: right;
}

.qw-daily__detail {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--glass-border);
}

.qw-daily__metric {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 12rpx 14rpx;
  border-radius: 14rpx;
  background: var(--glass-bg);
  color: var(--glass-text-2);
  font-size: 18rpx;
  font-size: calc(18rpx * var(--fs-scale, 1));
  line-height: 1.4;
}

.qw-daily__metric text:first-child {
  color: var(--glass-text-3);
  font-size: 16rpx;
  font-size: calc(16rpx * var(--fs-scale, 1));
}

.qw-daily__astro {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
}

.qw-daily__astro-item {
  display: flex;
  width: 48.6%;
  margin-bottom: 12rpx;
  box-sizing: border-box;
  flex-direction: column;
  gap: 4rpx;
  padding: 12rpx 14rpx;
  border-radius: 14rpx;
  background: var(--glass-bg);
}

.qw-daily__astro-label {
  color: var(--glass-text-3);
  font-size: 16rpx;
  font-size: calc(16rpx * var(--fs-scale, 1));
}

.qw-daily__astro-value {
  color: var(--glass-text-2);
  font-size: 18rpx;
  font-size: calc(18rpx * var(--fs-scale, 1));
  line-height: 1.4;
}

.qw-daily__moon {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
}

.qw-daily__skeleton {
  height: 240rpx;
}

.qw-daily__parts {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  margin-top: 12rpx;
}

.qw-daily__part {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 16rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--glass-border);
  border-radius: 18rpx;
  background: var(--glass-bg);
}

.qw-daily__part-title {
  color: var(--glass-accent-text);
  font-family: var(--glass-font-mono, monospace);
  font-size: 18rpx;
  font-size: calc(18rpx * var(--fs-scale, 1));
  letter-spacing: 1rpx;
}

.qw-daily__part-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10rpx;
  color: var(--glass-text-3);
  font-size: 18rpx;
  font-size: calc(18rpx * var(--fs-scale, 1));
  line-height: 1.4;
}

.qw-daily__part-row text:first-child {
  flex: none;
}

.qw-daily__part-row text:last-child {
  flex: 1;
  min-width: 0;
  color: var(--glass-text-2);
  text-align: right;
  /* 允许在「·」空格处换行，但不把 m/s 这类单位拆开 */
  word-break: keep-all;
  overflow-wrap: normal;
}

.qw-daily__total-precip {
  margin-bottom: 12rpx;
  padding: 12rpx 16rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: 16rpx;
  background: var(--glass-bg);
}

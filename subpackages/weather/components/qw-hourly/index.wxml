<view class="qw-card qw-hourly">
  <view class="qw-card__head">
    <view>
      <text class="qw-kicker">HOURLY FORECAST</text>
      <text class="qw-title">逐小时预报</text>
    </view>
    <view class="qw-chip-row">
      <view
        wx:for="{{ranges}}"
        wx:key="*this"
        class="qw-chip {{range === item ? 'qw-chip--active' : ''}}"
        data-range="{{item}}"
        bindtap="onRange"
        aria-role="button"
        aria-label="{{item}} 小时预报"
      >{{item}}h</view>
    </view>
  </view>

  <view wx:if="{{error}}" class="qw-error">{{error}}</view>
  <block wx:elif="{{viewHours.length}}">
    <scroll-view class="qw-scroll-x qw-hourly__scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="qw-scroll-x__inner">
        <view
          wx:for="{{viewHours}}"
          wx:key="time"
          class="qw-hourly__card {{item.selected ? 'qw-hourly__card--active' : ''}}"
          data-index="{{index}}"
          bindtap="onSelect"
          aria-role="button"
          aria-label="{{item.timeText}} {{item.condition}} {{item.tempText}}"
        >
          <text class="qw-hourly__time">{{item.hourText}}</text>
          <qw-icon code="{{item.icon}}" size="{{58}}" alt="{{item.condition}}" />
          <text class="qw-hourly__temp">{{item.tempText}}</text>
          <text class="qw-hourly__condition">{{item.condition}}</text>
          <view class="qw-hourly__bar-wrap" aria-hidden="true">
            <view class="qw-hourly__bar" style="height: {{item.barHeight}}%;"></view>
          </view>
          <text class="qw-hourly__pop">{{item.popText}}</text>
        </view>
      </view>
    </scroll-view>

    <view wx:if="{{viewHours[selectedIndex]}}" class="qw-hourly__detail">
      <view class="qw-hourly__detail-head">
        <view>
          <text class="qw-hourly__detail-time">{{viewHours[selectedIndex].timeText}} · {{viewHours[selectedIndex].condition}}</text>
          <text class="qw-hourly__detail-sub">{{viewHours[selectedIndex].tempText}} · 体感 {{viewHours[selectedIndex].feelsLikeText}} · 降水概率 {{viewHours[selectedIndex].popText}}</text>
        </view>
        <text class="qw-badge">{{viewHours[selectedIndex].humidityText}}</text>
      </view>
      <view class="qw-grid-2">
        <view class="qw-grid__item qw-hourly__metric"><text>风</text><text>{{viewHours[selectedIndex].windText}}</text></view>
        <view class="qw-grid__item qw-hourly__metric"><text>阵风</text><text>{{viewHours[selectedIndex].gustText}}</text></view>
        <view class="qw-grid__item qw-hourly__metric"><text>降水</text><text>{{viewHours[selectedIndex].precipText}}</text></view>
        <view class="qw-grid__item qw-hourly__metric"><text>降水类型</text><text>{{viewHours[selectedIndex].precipTypeText}}</text></view>
        <view class="qw-grid__item qw-hourly__metric"><text>降水强度</text><text>{{viewHours[selectedIndex].precipIntensityText}}</text></view>
        <view class="qw-grid__item qw-hourly__metric"><text>气压</text><text>{{viewHours[selectedIndex].pressureText}}</text></view>
        <view class="qw-grid__item qw-hourly__metric"><text>能见度</text><text>{{viewHours[selectedIndex].visibilityText}}</text></view>
        <view class="qw-grid__item qw-hourly__metric"><text>露点</text><text>{{viewHours[selectedIndex].dewPointText}}</text></view>
        <view class="qw-grid__item qw-hourly__metric"><text>云量</text><text>{{viewHours[selectedIndex].cloudText}}</text></view>
        <view class="qw-grid__item qw-hourly__metric"><text>紫外线</text><text>{{viewHours[selectedIndex].uvText}}</text></view>
      </view>
    </view>
  </block>
  <view wx:elif="{{loading}}" class="qw-skeleton qw-hourly__skeleton"></view>
  <text wx:else class="qw-empty">暂无逐小时预报</text>
</view>

@import "../../styles/qweather.wxss";

.qw-hourly {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.qw-hourly__scroll {
  margin-top: 4rpx;
  /* Skyline 横向 scroll-view 必须显式高度，否则卡片会被压成 0 */
  height: calc(360rpx * var(--fs-scale, 1));
}

.qw-hourly__card {
  display: inline-flex;
  width: 126rpx;
  min-width: 126rpx;
  box-sizing: border-box;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 10rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: 22rpx;
  background: var(--glass-bg-soft);
}

.qw-hourly__card--active {
  border-color: var(--glass-accent-glow);
  background: var(--glass-accent-soft);
  box-shadow: 0 0 20rpx rgba(120, 136, 255, 0.18);
}

.qw-hourly__time {
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono, monospace);
  font-size: 18rpx;
  font-size: calc(18rpx * var(--fs-scale, 1));
}

.qw-hourly__temp {
  color: var(--glass-text);
  font-size: 30rpx;
  font-size: calc(30rpx * var(--fs-scale, 1));
  font-weight: 700;
  line-height: 1;
}

.qw-hourly__condition {
  max-width: 100%;
  color: var(--glass-text-2);
  font-size: 18rpx;
  font-size: calc(18rpx * var(--fs-scale, 1));
  line-height: 1.2;
  text-align: center;
  white-space: normal;
}

.qw-hourly__bar-wrap {
  display: flex;
  align-items: flex-end;
  width: 12rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: var(--glass-bg);
  overflow: hidden;
}

.qw-hourly__bar {
  width: 100%;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #7fe0c8 0%, #6d78ff 100%);
}

.qw-hourly__pop {
  color: var(--glass-text-3);
  font-size: 16rpx;
  font-size: calc(16rpx * var(--fs-scale, 1));
}

.qw-hourly__detail {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 20rpx;
  border: 1rpx solid var(--glass-border-strong);
  border-radius: 24rpx;
  background: var(--glass-bg-soft);
}

.qw-hourly__detail-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.qw-hourly__detail-time {
  display: block;
  color: var(--glass-text);
  font-size: 24rpx;
  font-size: calc(24rpx * var(--fs-scale, 1));
  font-weight: 600;
}

.qw-hourly__detail-sub {
  display: block;
  margin-top: 4rpx;
  color: var(--glass-text-3);
  font-size: 19rpx;
  font-size: calc(19rpx * var(--fs-scale, 1));
  line-height: 1.4;
}

.qw-hourly__metric {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  background: var(--glass-bg);
  color: var(--glass-text-2);
  font-size: 19rpx;
  font-size: calc(19rpx * var(--fs-scale, 1));
  line-height: 1.4;
}

.qw-hourly__metric text:first-child {
  color: var(--glass-text-3);
  font-size: 17rpx;
  font-size: calc(17rpx * var(--fs-scale, 1));
}

.qw-hourly__skeleton {
  height: 260rpx;
}

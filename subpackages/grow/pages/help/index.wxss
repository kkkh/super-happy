/* ==========================================================================
   help · 使用指南
   - 只消费 glass 令牌；无 backdrop-filter；滚动交给 scroll-view
   ========================================================================== */
.help-page {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
  background: var(--glass-canvas);
  color: var(--glass-text);
  font-family: var(--glass-font-sans);
}

.help-search {
  flex: none;
  padding: 8rpx 28rpx 12rpx;
}

.help-search__input {
  width: 100%;
  height: 76rpx;
  padding: 0 26rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: var(--glass-bg);
  border: 1rpx solid var(--glass-border);
  font-size: 26rpx;
  color: var(--glass-text);
}

.help-search__placeholder {
  color: var(--glass-text-3);
}

.help-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

.help-content {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding: 8rpx 28rpx calc(var(--glass-safe-bottom) + 36rpx);
  box-sizing: border-box;
}

.help-block {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.help-block__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 6rpx;
}

.help-block__title {
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: var(--glass-text);
}

.help-block__count {
  font-size: 21rpx;
  color: var(--glass-text-3);
}

.help-card {
  display: flex;
  flex-direction: column;
  padding: 22rpx 24rpx;
  border-radius: 28rpx;
  background: var(--glass-bg-soft);
  border: 1rpx solid var(--glass-border);
  transition: background 160ms var(--glass-ease-out);
}

.help-card__head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.help-card__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  flex: none;
  border-radius: 20rpx;
  background: var(--glass-bg);
  border: 1rpx solid var(--glass-border);
}

.help-card__icon-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--glass-text-2);
}

.help-card__copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1;
}

.help-card__name {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--glass-text);
}

.help-card__summary {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: var(--glass-text-3);
}

.help-card__chevron {
  flex: none;
  width: 40rpx;
  text-align: center;
  font-size: 32rpx;
  line-height: 1;
  color: var(--glass-text-3);
}

.help-card__body {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--glass-border);
}

.help-card__section {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.help-card__label {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--glass-text-3);
}

.help-card__step,
.help-card__tip {
  font-size: 23rpx;
  line-height: 1.55;
  color: var(--glass-text-2);
}

.help-card__faq {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 12rpx 14rpx;
  border-radius: 18rpx;
  background: var(--glass-bg);
}

.help-card__faq-q {
  font-size: 23rpx;
  font-weight: 600;
  color: var(--glass-text-2);
}

.help-card__faq-a {
  font-size: 22rpx;
  line-height: 1.55;
  color: var(--glass-text-3);
}

.help-card__open {
  align-self: flex-start;
  margin-top: 6rpx;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: var(--glass-bg-strong);
  border: 1rpx solid var(--glass-border);
  font-size: 22rpx;
  color: var(--glass-text);
}

.help-card__open:active {
  background: var(--glass-bg);
}

.help-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 60rpx 0;
}

.help-empty__title {
  font-size: 26rpx;
  color: var(--glass-text-2);
}

.help-empty__sub {
  font-size: 22rpx;
  color: var(--glass-text-3);
}

.help-empty__chips {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
  margin-top: 8rpx;
}

.help-empty__chip {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: var(--glass-bg);
  border: 1rpx solid var(--glass-border);
  font-size: 22rpx;
  color: var(--glass-text-2);
}

.help-empty__chip:active {
  background: var(--glass-bg-strong);
}

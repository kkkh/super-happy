/* 主页 · 展馆前厅（布局层；颜色一律语义令牌） */
.home_scroll {
  flex: 1;
  width: 100%;
}

.home_body {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  padding: 20rpx 56rpx calc(40rpx + env(safe-area-inset-bottom));
}

/* ---- 状态行 ---- */
.home_row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.home_status {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.home_dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background-color: var(--g-aurora);
  animation: home-pulse 2.4s ease-in-out infinite;
}

.home_micro {
  font-size: 20rpx;
  letter-spacing: 3rpx;
  font-weight: 600;
}

.home_micro_aurora { color: var(--g-aurora); }
.home_micro_ink { color: var(--g-ink-4); }
.home_micro_ink2 { color: var(--g-ink-3); }
.home_micro_iris { color: var(--g-iris); }

@keyframes home-pulse {
  0%,
  100% {
    opacity: 0.55;
    box-shadow: 0 0 0 0 var(--g-aurora-glow);
  }
  50% {
    opacity: 1;
    box-shadow: 0 0 0 12rpx transparent;
  }
}

/* ---- 英雄层 ---- */
.home_hero {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 64rpx;
}

.home_name {
  font-size: 104rpx;
  font-weight: 800;
  color: var(--g-ink);
  letter-spacing: 8rpx;
  line-height: 1.1;
}

/* ---- 身份行 ---- */
.home_identity {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  margin-top: 44rpx;
}

.home_loc {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
}

.home_loc_text {
  font-size: 24rpx;
  color: var(--g-ink-3);
  letter-spacing: 2rpx;
}

.home_motto {
  display: block;
  margin-top: 40rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--g-ink-2);
  letter-spacing: 4rpx;
}

/* ---- 数字速览带 ---- */
.home_stats {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: 12rpx;
  margin-top: 52rpx;
  padding: 32rpx 20rpx;
  border-radius: 32rpx;
  background-color: var(--g-surface);
  border: 1rpx solid var(--g-stroke);
  box-shadow: var(--g-shadow-glass);
}

/* ---- 索引栏 ---- */
.home_index {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  margin-top: 88rpx;
}

.home_rule {
  flex: 1;
  height: 1rpx;
  background-color: var(--g-stroke-strong);
}

/* ---- 入口星表 ---- */
.home_entries {
  display: flex;
  flex-direction: column;
  margin-top: 28rpx;
}

.home_entry {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  padding: 34rpx 4rpx;
  border-bottom: 1rpx solid var(--g-stroke);
  transition:
    transform 0.18s cubic-bezier(0.2, 0.9, 0.25, 1),
    opacity 0.18s cubic-bezier(0.2, 0.9, 0.25, 1);
}

.home_entry:last-child {
  border-bottom: none;
}

.home_entry_press {
  opacity: 0.88;
}

.home_entry_no {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--g-ink-5);
  letter-spacing: 2rpx;
  width: 44rpx;
}

.home_ring {
  width: 92rpx;
  height: 92rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.home_ring_iris {
  background-color: var(--g-iris-soft);
  border: 1rpx solid var(--g-iris-border);
}

.home_ring_aurora {
  background-color: var(--g-aurora-soft);
  border: 1rpx solid var(--g-aurora-border);
}

.home_ring_amber {
  background-color: var(--g-amber-soft);
  border: 1rpx solid var(--g-amber-border);
}

.home_entry_text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.home_entry_title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--g-ink);
  letter-spacing: 2rpx;
}

.home_entry_sub {
  font-size: 22rpx;
  color: var(--g-ink-3);
  letter-spacing: 1rpx;
}

/* ---- 版记 ---- */
.home_colophon {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin-top: 96rpx;
}

.home_mark {
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background-color: var(--g-iris);
  box-shadow: 0 0 20rpx var(--g-iris-glow);
}

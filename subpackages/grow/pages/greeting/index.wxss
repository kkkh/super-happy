/* 问候序厅 */
.greet_scroll {
  flex: 1;
  width: 100%;
}

.greet_body {
  display: flex;
  flex-direction: column;
  padding: 12rpx 56rpx calc(48rpx + env(safe-area-inset-bottom));
}

/* ---- 徽章（飞跃承接） ---- */
.greet_badge {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0 8rpx;
}

.greet_badge_ring {
  width: 280rpx;
  height: 280rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.greet_badge_ring_iris {
  background-color: var(--g-iris-soft);
  border: 1rpx solid var(--g-iris-border);
  box-shadow: 0 0 64rpx var(--g-iris-glow);
}

/* ---- 开场白 ---- */
.greet_intro {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  margin-top: 36rpx;
}

.greet_title {
  font-size: 44rpx;
  font-size: calc(44rpx * var(--fs-scale, 1));
  font-weight: 800;
  color: var(--g-ink);
  letter-spacing: 6rpx;
}

.greet_sub {
  font-size: 20rpx;
  font-size: calc(20rpx * var(--fs-scale, 1));
  color: var(--g-ink-4);
  letter-spacing: 3rpx;
  font-weight: 600;
}

/* ---- 问候卡 ---- */
.greet_cards {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  margin-top: 48rpx;
}

.greet_card {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 24rpx;
}

.greet_card_icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.greet_card_icon_iris {
  background-color: var(--g-iris-soft);
  border: 1rpx solid var(--g-iris-border);
}

.greet_card_icon_aurora {
  background-color: var(--g-aurora-soft);
  border: 1rpx solid var(--g-aurora-border);
}

.greet_card_icon_amber {
  background-color: var(--g-amber-soft);
  border: 1rpx solid var(--g-amber-border);
}

.greet_card_text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.greet_card_title {
  font-size: 32rpx;
  font-size: calc(32rpx * var(--fs-scale, 1));
  font-weight: 700;
  color: var(--g-ink);
  letter-spacing: 2rpx;
}

.greet_card_body {
  font-size: 24rpx;
  font-size: calc(24rpx * var(--fs-scale, 1));
  color: var(--g-ink-3);
  line-height: 1.7;
}

/* ---- 版记 ---- */
.greet_foot {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 64rpx;
}

.greet_foot_text {
  font-size: 24rpx;
  font-size: calc(24rpx * var(--fs-scale, 1));
  color: var(--g-ink-4);
  letter-spacing: 6rpx;
}

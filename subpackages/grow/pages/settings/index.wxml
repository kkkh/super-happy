      </view>

      <view class="settings-colophon">
        <text>CHAOHUAN · CONTROL CENTER · LOCAL ONLY · V{{version}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 选项抽屉：直接由设置页渲染，size=half 保证滚动区有确定高度 -->
  <glass-bottom-sheet
    show="{{pickerShow}}"
    title="{{pickerTitle}}"
    description="{{pickerDesc}}"
    size="half"
    z-index="{{900}}"
    bind:close="onPickerClose"
    bind:closed="onPickerClose"
  >
    <!-- 这里是选项列表的渲染 -->
    <view class="settings-picker" aria-role="listbox">
      <view
        wx:for="{{pickerOptions}}"
        wx:key="value"
        class="settings-picker__option {{item.active ? 'settings-picker__option--active' : ''}}"
        hover-class="settings-picker__option--press"
        hover-start-time="0"
        hover-stay-time="80"
        data-value="{{item.value}}"
        aria-role="option"
        aria-selected="{{item.active}}"
        bindtap="onPickerOptionTap"
      >
        <view class="settings-picker__radio" aria-hidden="true">
          <view class="settings-picker__dot"></view>
        </view>

        <view class="settings-picker__copy">
          <text class="settings-picker__label">{{item.label}}</text>
          <text class="settings-picker__desc">{{item.desc}}</text>
        </view>

        <text wx:if="{{item.active}}" class="settings-picker__check" aria-hidden="true">✓</text>
      </view>
    </view>
  </glass-bottom-sheet>

  <!-- 清空确认：全部内容放在 footer 槽，避免默认滚动区高度塌陷 -->
  <glass-bottom-sheet
    show="{{confirmShow}}"
    title="清空最近使用"
    size="auto"
    z-index="{{1000}}"
    show-footer="{{true}}"
    bind:close="onConfirmSheetClose"
    bind:closed="onConfirmSheetClose"
  >
    <view slot="footer" class="settings-confirm">
      <view class="settings-confirm__icon" aria-hidden="true">
        <g-icon name="history" size="{{40}}" tone="ink3" />
      </view>
      <text class="settings-confirm__title">确定清空 {{recentCount}} 条记录？</text>
      <text class="settings-confirm__desc">此操作不可恢复，但不会触碰你的收藏与全局偏好。</text>

      <view class="settings-confirm__actions">
        <view class="settings-confirm__action">
          <glass-button variant="ghost" block bind:tap="onConfirmCancel">取消</glass-button>
        </view>
        <view class="settings-confirm__action">
          <glass-button variant="danger" block bind:tap="onConfirmClear">确认清空</glass-button>
        </view>
      </view>
    </view>
  </glass-bottom-sheet>

  <!-- 清空专注数据确认：与最近使用清空共用底部sheet样式 -->
  <glass-bottom-sheet
    show="{{focusClearShow}}"
    title="清空专注数据"
    size="auto"
    z-index="{{1000}}"
    show-footer="{{true}}"
    bind:close="onFocusClearClose"
    bind:closed="onFocusClearClose"
  >
    <view slot="footer" class="settings-confirm">
      <view class="settings-confirm__icon" aria-hidden="true">
        <g-icon name="clock" size="{{40}}" tone="ink3" />
      </view>
      <text class="settings-confirm__title">确定清空？</text>
      <text class="settings-confirm__desc">{{focusClearDesc}}</text>

      <view class="settings-confirm__actions">
        <view class="settings-confirm__action">
          <glass-button variant="ghost" block bind:tap="onFocusClearClose">取消</glass-button>
        </view>
        <view class="settings-confirm__action">
          <glass-button variant="danger" block bind:tap="onFocusClearConfirm">清空</glass-button>
        </view>
      </view>
    </view>
  </glass-bottom-sheet>

  <!-- 备份与恢复：导出 / 导入 / 删除，只操作本机 JSON 备份 -->
  <glass-bottom-sheet
    show="{{backupShow}}"
    title="备份与恢复"
    description="备份只写本机；导入会覆盖收藏、最近、搜索、天气、专注与全局偏好。"
    size="auto"
    z-index="{{1000}}"
    show-footer="{{true}}"
    bind:close="onBackupClose"
    bind:closed="onBackupClose"
  >
    <view slot="footer" class="settings-confirm settings-backup">
      <view class="settings-backup__status">
        <text class="settings-backup__status-label">最近备份</text>
        <text class="settings-backup__status-value">{{backupAtText}}</text>
      </view>

      <view class="settings-backup__rows">
        <view
          class="settings-backup__row"
          hover-class="settings-backup__row--press"
          hover-start-time="0"
          hover-stay-time="80"
          aria-role="button"
          aria-label="导出备份并分享"
          bindtap="onBackupExport"
        >
          <view class="settings-backup__icon">
            <g-icon name="save" size="{{30}}" tone="aurora" />
          </view>
          <view class="settings-backup__copy">
            <text class="settings-backup__title">导出备份</text>
            <text class="settings-backup__desc">{{backupBusy ? '正在生成备份…' : '生成 JSON，通过系统分享保存或发送'}}</text>
          </view>
          <g-icon name="chevron" size="{{22}}" tone="ink4" />
        </view>

        <view
          class="settings-backup__row"
          hover-class="settings-backup__row--press"
          hover-start-time="0"
          hover-stay-time="80"
          aria-role="button"
          aria-label="导入备份"
          bindtap="onBackupImport"
        >
          <view class="settings-backup__icon">
            <g-icon name="stack" size="{{30}}" tone="iris" />
          </view>
          <view class="settings-backup__copy">
            <text class="settings-backup__title">导入备份</text>
            <text class="settings-backup__desc">从聊天文件选择 JSON，校验通过后整体替换</text>
          </view>
          <g-icon name="chevron" size="{{22}}" tone="ink4" />
        </view>

        <view
          wx:if="{{backupHasFile}}"
          class="settings-backup__row settings-backup__row--danger"
          hover-class="settings-backup__row--press"
          hover-start-time="0"
          hover-stay-time="80"
          aria-role="button"
          aria-label="删除备份文件"
          bindtap="onBackupDelete"
        >
          <view class="settings-backup__icon">
            <g-icon name="close" size="{{30}}" tone="ink3" />
          </view>
          <view class="settings-backup__copy">
            <text class="settings-backup__title">删除备份文件</text>
            <text class="settings-backup__desc">只删除本机备份，不影响现有收藏与记录</text>
          </view>
          <g-icon name="chevron" size="{{22}}" tone="ink4" />
        </view>
      </view>

      <view class="settings-confirm__actions">
        <view class="settings-confirm__action">
          <glass-button variant="ghost" block bind:tap="onBackupClose">关闭</glass-button>
        </view>
      </view>
    </view>
  </glass-bottom-sheet>

  <!-- 导入 / 删除备份确认 -->
  <glass-bottom-sheet
    show="{{backupConfirmShow}}"
    title="{{backupConfirmTitle}}"
    size="auto"
    z-index="{{1000}}"
    show-footer="{{true}}"
    bind:close="onBackupConfirmClose"
    bind:closed="onBackupConfirmClose"
  >
    <view slot="footer" class="settings-confirm">
      <view class="settings-confirm__icon" aria-hidden="true">
        <g-icon name="{{backupConfirmKind === 'delete' ? 'close' : 'stack'}}" size="{{40}}" tone="ink3" />
      </view>
      <text class="settings-confirm__title">{{backupConfirmTitle}}</text>
      <text class="settings-confirm__desc">{{backupConfirmDesc}}</text>

      <view class="settings-confirm__actions">
        <view class="settings-confirm__action">
          <glass-button variant="ghost" block bind:tap="onBackupConfirmClose">取消</glass-button>
        </view>
        <view class="settings-confirm__action">
          <glass-button
            variant="{{backupConfirmKind === 'delete' ? 'danger' : 'primary'}}"
            block
            bind:tap="onBackupConfirm"
          >{{backupConfirmKind === 'delete' ? '删除' : '导入'}}</glass-button>
        </view>
      </view>
    </view>
  </glass-bottom-sheet>

  <!-- 隐私中心：清除工具数据 / 重置全部确认 -->
  <glass-bottom-sheet
    show="{{privacyConfirmShow}}"
    title="{{privacyConfirmTitle}}"
    size="auto"
    z-index="{{1000}}"
    show-footer="{{true}}"
    bind:close="onPrivacyConfirmClose"
    bind:closed="onPrivacyConfirmClose"
  >
    <view slot="footer" class="settings-confirm">
      <view class="settings-confirm__icon" aria-hidden="true">
        <g-icon
          name="{{privacyConfirmKind === 'all' ? 'close' : 'stack'}}"
          size="{{40}}"
          tone="ink3"
        />
      </view>
      <text class="settings-confirm__title">{{privacyConfirmTitle}}</text>
      <text class="settings-confirm__desc">{{privacyConfirmDesc}}</text>

      <view class="settings-confirm__actions">
        <view class="settings-confirm__action">
          <glass-button variant="ghost" block bind:tap="onPrivacyConfirmClose">取消</glass-button>
        </view>
        <view class="settings-confirm__action">
          <glass-button variant="danger" block bind:tap="onPrivacyConfirm">确认</glass-button>
        </view>
      </view>
    </view>
  </glass-bottom-sheet>

  <glass-toast z-index="{{1200}}" />

  <!-- 剪贴板属于微信隐私接口：分片复制 / 从剪贴板追加 / 备份码复制前必须能弹出授权 -->
  <privacy-guard />

  <!-- AES 加密 / 时间旅行 / 分片 / Auto-Pilot / 页面抽屉期间，更新弹窗只排队 -->
  <update-guard
    blocked="{{vaultBusy || travelBusy || transportBusy || pilotRunning || pickerShow || confirmShow || focusClearShow || backupShow || backupConfirmShow || backupBusy || privacyConfirmShow}}"
  />
</view>

/* ==========================================================================
   glass-switch · 液态玻璃开关
   - 外层 1rpx 渐变高光边框；内层凹槽与滑块双层材质
   - 弹簧曲线统一使用 cubic-bezier(0.25, 0.8, 0.25, 1)
   - 动效时长继承 --glass-duration-base，省电模式下降为 1ms
   ========================================================================== */

.glass-switch {
  display: inline-flex;
  align-items: center;
  justify-content: flex-end;
  flex-shrink: 0;
  padding: 12rpx 0 12rpx 16rpx;
  box-sizing: border-box;
}

.glass-switch__frame {
  display: block;
  padding: 1rpx;
  border-radius: 36rpx;
  background-image: var(
    --glass-border-gradient,
    linear-gradient(135deg, rgba(255, 255, 255, 0.65), rgba(255, 255, 255, 0.12))
  );
  box-shadow:
    0 10rpx 24rpx rgba(0, 0, 0, 0.16),
    0 0 0 1rpx rgba(255, 255, 255, 0.04);
}

.glass-switch__track {
  position: relative;
  width: 104rpx;
  height: 60rpx;
  border-radius: 35rpx;
  box-sizing: border-box;
  overflow: hidden;
  background-color: var(--glass-bg-soft, rgba(255, 255, 255, 0.08));
  background-image: linear-gradient(
    160deg,
    rgba(255, 255, 255, 0.16) 0%,
    rgba(255, 255, 255, 0.03) 100%
  );
  box-shadow:
    inset 0 3rpx 10rpx rgba(0, 0, 0, 0.22),
    inset 0 1rpx 0 var(--glass-highlight, rgba(255, 255, 255, 0.6));
  transition:
    background-color var(--glass-duration-base, 280ms)
      cubic-bezier(0.25, 0.8, 0.25, 1),
    background-image var(--glass-duration-base, 280ms)
      cubic-bezier(0.25, 0.8, 0.25, 1);
}

.glass-switch--on .glass-switch__track {
  background-color: transparent;
  background-image: linear-gradient(
    118deg,
    var(--sg-iris, #6d78ff) 0%,
    var(--sg-ambient-iris, #9f7cff) 52%,
    var(--sg-mint, #5fdcc7) 100%
  );
  box-shadow:
    inset 0 2rpx 6rpx rgba(255, 255, 255, 0.45),
    inset 0 -4rpx 12rpx rgba(18, 20, 42, 0.24),
    0 0 26rpx var(--sg-chromatic-glow, rgba(120, 136, 255, 0.34));
}

/* 开启态内部极光色散：只在滑块周围呼吸式染色，不做持续动画 */
.glass-switch__glow {
  position: absolute;
  top: -18rpx;
  right: -6rpx;
  width: 78rpx;
  height: 78rpx;
  border-radius: 50%;
  background-image:
    radial-gradient(circle at 30% 35%, rgba(255, 176, 131, 0.5), transparent 58%),
    radial-gradient(circle at 68% 62%, rgba(95, 220, 199, 0.52), transparent 60%),
    radial-gradient(circle at 52% 48%, rgba(159, 124, 255, 0.6), transparent 62%);
  opacity: 0;
  transform: scale(0.72);
  transition:
    opacity var(--glass-duration-base, 280ms) cubic-bezier(0.25, 0.8, 0.25, 1),
    transform var(--glass-duration-base, 280ms) cubic-bezier(0.25, 0.8, 0.25, 1);
}

.glass-switch--on .glass-switch__glow {
  opacity: 0.9;
  transform: scale(1);
}

.glass-switch__thumb {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  display: block;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  transition: transform var(--glass-duration-base, 280ms)
    cubic-bezier(0.25, 0.8, 0.25, 1);
  will-change: transform;
}

.glass-switch--on .glass-switch__thumb {
  transform: translate3d(42rpx, 0, 0);
}

.glass-switch__thumb-core {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: 50%;
  background-image: linear-gradient(
    145deg,
    rgba(255, 255, 255, 0.98) 0%,
    rgba(255, 255, 255, 0.82) 44%,
    rgba(214, 220, 255, 0.72) 100%
  );
  box-shadow:
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.9),
    0 6rpx 16rpx rgba(6, 8, 18, 0.32);
  transition: box-shadow var(--glass-duration-base, 280ms)
    cubic-bezier(0.25, 0.8, 0.25, 1);
}

.glass-switch--on .glass-switch__thumb-core {
  background-image: linear-gradient(
    145deg,
    #ffffff 0%,
    rgba(236, 240, 255, 0.96) 42%,
    rgba(178, 198, 255, 0.9) 100%
  );
  box-shadow:
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.96),
    0 0 22rpx rgba(159, 124, 255, 0.75),
    0 8rpx 18rpx rgba(6, 8, 18, 0.3);
}

.glass-switch__thumb-sheen {
  position: absolute;
  top: 5rpx;
  left: 10rpx;
  width: 28rpx;
  height: 14rpx;
  border-radius: 50%;
  background-image: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.94),
    rgba(255, 255, 255, 0)
  );
  opacity: 0.72;
  transform: rotate(-18deg);
}

.glass-switch--disabled {
  opacity: 0.42;
}

/* ---- 系统减少动态偏好 ---- */
@media (prefers-reduced-motion: reduce) {
  .glass-switch__track,
  .glass-switch__glow,
  .glass-switch__thumb,
  .glass-switch__thumb-core {
    transition-duration: 1ms;
  }
}

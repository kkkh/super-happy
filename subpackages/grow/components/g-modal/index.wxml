<view
  wx:if="{{show}}"
  class="modal_scrim"
  aria-role="button"
  aria-label="关闭弹层"
  catchtap="onScrim"
  catchtouchmove="onStop"
>
  <view class="modal_sheet" catchtap="onStop" aria-role="dialog" aria-label="{{title}}">
    <view class="modal_grip"></view>
    <text wx:if="{{title}}" class="modal_title">{{title}}</text>
    <view
      class="modal_close"
      hover-class="modal_close_press"
      hover-stay-time="80"
      aria-role="button"
      aria-label="关闭"
      bindtap="onClose"
    >
      <g-icon name="close" size="{{30}}" tone="ink3" />
    </view>
    <slot></slot>
  </view>
</view>

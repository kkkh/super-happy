/* g-stat · 数字速览块 */
.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex: 1;
}

.stat_kicker {
  font-size: 18rpx;
  color: var(--g-ink-4);
  letter-spacing: 3rpx;
  font-weight: 600;
}

.stat_value_row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
}

.stat_value {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--g-ink);
  letter-spacing: 2rpx;
  font-variant-numeric: tabular-nums;
}

.stat_suffix {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--g-iris);
  margin-left: 4rpx;
}

.stat_label {
  font-size: 22rpx;
  color: var(--g-ink-3);
  letter-spacing: 2rpx;
}

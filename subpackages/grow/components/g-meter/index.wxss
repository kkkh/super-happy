/* g-meter · 五格量表 */
.meter {
  display: flex;
  flex-direction: row;
  gap: 8rpx;
}

.meter_cell {
  width: 36rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background-color: var(--g-dot-off);
}

/* 动画由父级 meter_run_0 / meter_run_1 切换 animation-name 触发重播 */

/* 奇偶动画名：同构效果、不同名称，用于可靠重启 */
.meter_run_0 .meter_cell_on_iris,
.meter_run_0 .meter_cell_on_aurora,
.meter_run_0 .meter_cell_on_amber {
  animation: meter-pop-a 0.44s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

.meter_run_1 .meter_cell_on_iris,
.meter_run_1 .meter_cell_on_aurora,
.meter_run_1 .meter_cell_on_amber {
  animation: meter-pop-b 0.44s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

.meter_cell_on_iris { background-color: var(--g-iris); box-shadow: 0 0 16rpx var(--g-iris-glow); }
.meter_cell_on_aurora { background-color: var(--g-aurora); box-shadow: 0 0 16rpx var(--g-aurora-glow); }
.meter_cell_on_amber { background-color: var(--g-amber); box-shadow: 0 0 16rpx var(--g-amber-glow); }

@keyframes meter-pop-a {
  from {
    opacity: 0.2;
    transform: scaleX(0.3);
  }
  to {
    opacity: 1;
    transform: scaleX(1);
  }
}

@keyframes meter-pop-b {
  from {
    opacity: 0.2;
    transform: scaleX(0.3);
  }
  to {
    opacity: 1;
    transform: scaleX(1);
  }
}

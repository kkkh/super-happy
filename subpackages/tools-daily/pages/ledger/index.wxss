/* 算账助手 · 模式 chips / 折扣单位 / 满减档位 */
.ledger-modes {
  display: flex;
  gap: 12rpx;
}

.ledger-mode {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: var(--glass-bg);
  border: 1rpx solid var(--glass-border);
  color: var(--glass-text-3);
  font-size: 24rpx;
  transition: transform 140ms var(--glass-ease-out), background 140ms var(--glass-ease-out);
}

.ledger-mode--on {
  background: var(--glass-bg-strong);
  border-color: var(--glass-border-strong);
  color: var(--glass-text);
  font-weight: 600;
}

.ledger-mode:active {
  transform: scale(0.97);
}

.ledger-units {
  display: flex;
  gap: 12rpx;
}

.ledger-unit {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: var(--glass-bg-soft);
  color: var(--glass-text-3);
  font-size: 21rpx;
}

.ledger-unit--on {
  background: var(--glass-bg-strong);
  color: var(--glass-text);
  border: 1rpx solid var(--glass-border-strong);
}

.ledger-tiers {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.ledger-tier {
  display: flex;
  gap: 12rpx;
}

.ledger-tier__threshold {
  flex: 3;
}

.ledger-tier__off {
  flex: 2;
}

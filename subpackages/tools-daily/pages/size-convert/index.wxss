/* ==========================================================================
   尺码换算 · 类型 / 性别 / 地区 / 尺码
   - 只使用 --glass-* 令牌，无硬编码色值
   ========================================================================== */

.sc-modes {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
}

.sc-mode {
  flex: 1;
  min-width: 180rpx;
  box-sizing: border-box;
  padding: 16rpx 20rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: 999rpx;
  background-color: var(--glass-bg-soft);
  color: var(--glass-text-2);
  font-size: 22rpx;
  text-align: center;
  transition:
    border-color var(--glass-duration-fast) var(--glass-ease-out),
    background-color var(--glass-duration-fast) var(--glass-ease-out),
    color var(--glass-duration-fast) var(--glass-ease-out);
}

.sc-mode--on {
  border-color: var(--glass-accent);
  background-color: var(--glass-accent-soft);
  color: var(--glass-text);
}

.sc-field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.sc-label {
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 19rpx;
  letter-spacing: 0.08em;
}

.sc-chips {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
}

.sc-chip {
  min-width: 96rpx;
  box-sizing: border-box;
  padding: 14rpx 24rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: 999rpx;
  background-color: var(--glass-bg-soft);
  color: var(--glass-text-2);
  font-size: 23rpx;
  text-align: center;
  transition:
    border-color var(--glass-duration-fast) var(--glass-ease-out),
    background-color var(--glass-duration-fast) var(--glass-ease-out),
    color var(--glass-duration-fast) var(--glass-ease-out);
}

.sc-chip--on {
  border-color: var(--glass-accent);
  background-color: var(--glass-accent-soft);
  color: var(--glass-text);
}

.sc-hint {
  color: var(--glass-text-3);
  font-size: 19rpx;
  line-height: 1.5;
}

.sc-stage {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.sc-stage__label {
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 19rpx;
  letter-spacing: 0.08em;
}

.sc-stage__main {
  color: var(--glass-text);
  font-family: var(--glass-font-mono);
  font-size: 52rpx;
  font-weight: 600;
  line-height: 1.2;
}

.sc-copy {
  padding: 18rpx 0;
  border-top: 1rpx solid var(--glass-border);
  border-bottom: 1rpx solid var(--glass-border);
  color: var(--glass-text-2);
  font-size: 21rpx;
  text-align: center;
}

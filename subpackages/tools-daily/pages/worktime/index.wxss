/* 工时与请假 · 模式 chips / 日期 / 开关 / 明细 */
.wt-modes{display:flex;gap:12rpx}
.wt-mode{flex:1;height:76rpx;display:flex;align-items:center;justify-content:center;border-radius:20rpx;background:var(--glass-bg);border:1rpx solid var(--glass-border);color:var(--glass-text-3);font-size:24rpx;transition:transform 140ms var(--glass-ease-out),background 140ms var(--glass-ease-out)}
.wt-mode--on{background:var(--glass-bg-strong);border-color:var(--glass-border-strong);color:var(--glass-text);font-weight:600}
.wt-mode:active{transform:scale(.97)}
.wt-dates{display:flex;gap:12rpx}
.wt-date{flex:1;min-width:0;display:flex;flex-direction:column;gap:10rpx}
.wt-date__label{color:var(--glass-text-3);font-family:var(--glass-font-mono);font-size:19rpx;letter-spacing:.08em}
.wt-date__trigger{display:flex;align-items:center;justify-content:space-between;gap:8rpx;box-sizing:border-box;padding:20rpx 18rpx;border:1rpx solid var(--glass-border);border-radius:var(--glass-radius-md);background-color:var(--glass-bg-soft);box-shadow:inset 0 1rpx 0 var(--glass-highlight)}
.wt-date__trigger_pressed{border-color:var(--glass-border-strong);background-color:var(--glass-bg-strong)}
.wt-date__text{flex:1;min-width:0;overflow:hidden;color:var(--glass-text);font-family:var(--glass-font-mono);font-size:23rpx;text-overflow:ellipsis;white-space:nowrap}
.wt-switch-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:14rpx 0;border-bottom:1rpx solid var(--glass-border)}
.wt-switch-row:last-child{border-bottom:0}
.wt-switch-row__text{display:flex;flex-direction:column;gap:4rpx}
.wt-switch-row__title{color:var(--glass-text);font-size:23rpx}
.wt-switch-row__sub{color:var(--glass-text-3);font-size:19rpx}
.wt-details{display:flex;flex-direction:column;gap:6rpx;box-sizing:border-box;padding:16rpx 18rpx;border:1rpx solid var(--glass-border);border-radius:var(--glass-radius-md);background-color:var(--glass-bg-soft)}
.wt-detail{color:var(--glass-text-3);font-family:var(--glass-font-mono);font-size:19rpx}
.wt-wage-note{color:var(--glass-warn,#d97706);font-size:19rpx}

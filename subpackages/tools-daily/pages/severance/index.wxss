/* ==========================================================================
   离职补偿 · 方案 / 年限 / 封顶 / 年假
   - 只使用 --glass-* 令牌，无硬编码色值
   ========================================================================== */

.sv-field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.sv-label {
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 19rpx;
  letter-spacing: 0.08em;
}

.sv-chips {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
}

.sv-chip {
  min-width: 120rpx;
  box-sizing: border-box;
  padding: 14rpx 24rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: 999rpx;
  background-color: var(--glass-bg-soft);
  color: var(--glass-text-2);
  font-size: 23rpx;
  text-align: center;
  transition:
    border-color var(--glass-duration-fast) var(--glass-ease-out),
    background-color var(--glass-duration-fast) var(--glass-ease-out),
    color var(--glass-duration-fast) var(--glass-ease-out);
}

.sv-chip--on {
  border-color: var(--glass-accent);
  background-color: var(--glass-accent-soft);
  color: var(--glass-text);
}

.sv-grid {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.sv-col {
  flex: 1;
  min-width: 0;
}

.sv-stage {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.sv-stage__label {
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 19rpx;
  letter-spacing: 0.08em;
}

.sv-stage__main {
  color: var(--glass-text);
  font-family: var(--glass-font-mono);
  font-size: 52rpx;
  font-weight: 600;
  line-height: 1.2;
}

.sv-copy {
  padding: 18rpx 0;
  border-top: 1rpx solid var(--glass-border);
  border-bottom: 1rpx solid var(--glass-border);
  color: var(--glass-text-2);
  font-size: 21rpx;
  text-align: center;
}

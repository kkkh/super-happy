/* ==========================================================================
   圆角头像 · 选图舞台 / 形状与尺寸 chips / 结果预览
   - 只使用 --glass-* 令牌，无裸伪类
   ========================================================================== */

.av-notice {
  box-sizing: border-box;
  padding: 16rpx 20rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: var(--glass-radius-sm);
  background-color: var(--glass-accent-warm-soft);
}

.av-notice__text {
  color: var(--glass-text-2);
  font-size: 21rpx;
  line-height: 1.6;
}

.av-stage {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 340rpx;
  overflow: hidden;
  box-sizing: border-box;
  padding: 24rpx;
  border: 1rpx dashed var(--glass-border-strong);
  border-radius: var(--glass-radius-lg);
  background-color: var(--glass-bg-soft);
}

.av-stage__img {
  width: 100%;
  height: 300rpx;
}

.av-stage__blank {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.av-stage__title {
  color: var(--glass-text);
  font-size: 26rpx;
  font-weight: 600;
}

.av-stage__sub {
  color: var(--glass-text-3);
  font-size: 20rpx;
  text-align: center;
}

.av-stage__mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--glass-scrim, rgba(0, 0, 0, 0.35));
}

.av-stage__mask-text {
  color: var(--glass-text-inverse, #fff);
  font-size: 24rpx;
}

.av-meta-row {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.av-meta {
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 19rpx;
}

.av-meta--warn {
  color: var(--glass-warn, #d97706);
}

.av-section {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.av-label {
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 19rpx;
  letter-spacing: 0.08em;
}

.av-chips {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
}

.av-chip {
  flex: 1;
  min-width: 120rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0 18rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: 999rpx;
  background-color: var(--glass-bg-soft);
  color: var(--glass-text-3);
  font-size: 21rpx;
}

.av-chip.is-active {
  border-color: var(--glass-border-strong);
  background-color: var(--glass-bg-strong);
  color: var(--glass-text);
  font-weight: 600;
}

.av-hint {
  color: var(--glass-text-3);
  font-size: 19rpx;
  line-height: 1.6;
}

.av-output {
  width: 100%;
  height: 320rpx;
  border-radius: var(--glass-radius-md);
  background-color: var(--glass-bg-soft);
}

.av-actions {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 10rpx;
}

.av-canvas {
  position: fixed;
  left: -9999rpx;
  top: 0;
  opacity: 0;
  pointer-events: none;
}

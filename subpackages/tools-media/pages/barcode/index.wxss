/* ==========================================================================
   条形码生成 · 空间玻璃页面样式
   - 条码固定黑条白底，容器不跟随暗色令牌反色
   - 结果图按宽度自适应，点击可全屏预览
   ========================================================================== */

/* ---- 选项分栏 ---- */
.tool-field {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  box-sizing: border-box;
}

.tool-field__label {
  color: var(--glass-text-2);
  font-size: 24rpx;
  font-weight: 600;
}

.tool-chips {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  box-sizing: border-box;
}

.tool-chip {
  flex: 1;
  min-width: 0;
}

/* ---- 条码图 ---- */
.bc-frame {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 24rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: var(--glass-radius-lg);
  background-color: #ffffff;
  box-shadow: var(--glass-shadow-soft);
}

.bc-img {
  display: block;
  width: 100%;
}

.bc-text {
  box-sizing: border-box;
  padding: 16rpx 20rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: var(--glass-radius-sm);
  background-color: var(--glass-bg-soft);
  color: var(--glass-text-1);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.5;
  word-break: break-all;
}

/* ---- 注释 ---- */

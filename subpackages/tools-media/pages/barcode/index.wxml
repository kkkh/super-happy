<glass-tool-shell
  tool-id="barcode"
  title="{{toolName}}"
  kicker="{{kicker}}"
  desc="{{desc}}"
  run-label="生成条形码"
  poster-data="{{posterData}}"
  state="{{shellState}}"
  has-result="{{hasResult}}"
  can-run="{{canRun}}"
  error="{{error}}"
  empty-title="输入数字或英文，生成条形码"
  empty-sub="CODE128B 本机编码，内容不上传"
  bind:run="onRun"
  bind:example="onExample"
  bind:reset="onReset"
>
  <view slot="input" class="sg-tool-fields">
    <glass-input
      label="条码内容"
      hint="支持数字、英文字母与英文标点，最多 {{maxChars}} 字符"
      maxlength="{{maxChars}}"
      value="{{content}}"
      placeholder="如 TBX-2026-001"
      show-count
      clearable
      size="md"
      cursor-spacing="{{120}}"
      aria-label="条码内容"
      bind:input="onInput"
    />

    <view class="tool-field">
      <text class="tool-field__label">条宽</text>
      <view class="tool-chips">
        <glass-button
          wx:for="{{moduleOptions}}"
          wx:key="key"
          size="sm"
          shape="rounded"
          variant="{{moduleWidth === item.key ? 'primary' : 'ghost'}}"
          custom-class="tool-chip"
          data-key="{{item.key}}"
          aria-label="条宽 {{item.hint}}"
          bind:tap="onModule"
        >
          {{item.label}} · {{item.hint}}
        </glass-button>
      </view>
    </view>
  </view>

  <view slot="result" class="sg-tool-result">
    <view class="sg-tool-result__head">
      <text class="sg-tool-result__label">条形码</text>
      <text class="sg-tool-result__meta">CODE128B · {{sizeText}}</text>
    </view>

    <view
      class="bc-frame"
      bindtap="onPreview"
      aria-role="button"
      aria-label="预览条形码"
    >
      <image
        wx:if="{{outputPath}}"
        class="bc-img"
        src="{{outputPath}}"
        mode="widthFix"
        aria-label="生成的条形码"
      />
    </view>

    <view class="bc-text" aria-role="status">{{resultText}}</view>

    <view class="sg-tool-rows">
      <view wx:for="{{resultRows}}" wx:key="k" class="sg-tool-row">
        <text class="sg-tool-row__k">{{item.k}}</text>
        <text class="sg-tool-row__v">{{item.v}}</text>
      </view>
    </view>

    <view class="sg-tool-result__actions">
      <glass-button
        variant="aurora"
        size="md"
        block
        loading="{{saving}}"
        loading-text="保存中"
        aria-label="保存条形码到相册"
        bind:tap="onSave"
      >
        保存到相册
      </glass-button>
      <glass-button
        variant="ghost"
        size="md"
        block
        aria-label="复制条码内容"
        bind:tap="onCopy"
      >
        复制条码内容
      </glass-button>
    </view>

    <view class="sg-tool-note">
      <text class="sg-tool-note__title">编码口径</text>
      <text class="sg-tool-note__text">采用 CODE128B 标准编码并自动计算校验位，左右各保留 10 模块静区；仅支持数字、英文字母与英文标点，中文与 Emoji 无法编码。条码图不含人眼可读文字，原文在本页展示；编码、出图与保存均在本机完成，不联网、不上传。</text>
    </view>
  </view>
</glass-tool-shell>

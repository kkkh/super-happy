<glass-tool-shell
  tool-id="photo-edit"
  title="{{toolName}}"
  kicker="{{kicker}}"
  desc="{{desc}}"
  poster-data="{{posterData}}"
  show-run="{{false}}"
  show-example="{{false}}"
  state="{{shellState}}"
  has-result="{{hasResult}}"
  error="{{error}}"
  empty-title="从相册选择图片，开始编辑"
  empty-sub="裁剪、旋转、翻转与格式转换，全部在本机完成"
  bind:reset="onReset"
>
  <view slot="input" class="sg-tool-fields">
    <view wx:if="{{devtools}}" class="pe-notice">
      <text class="pe-notice__text">开发者工具暂不支持 Skyline Canvas，请扫码在真机预览中使用图片编辑。</text>
    </view>

    <view
      class="pe-stage"
      bind:tap="onChoose"
      aria-role="button"
      aria-label="{{imagePath ? '重新选择图片' : '从相册选择图片'}}"
    >
      <image
        wx:if="{{outputPath || imagePath}}"
        class="pe-stage__img"
        src="{{outputPath || imagePath}}"
        mode="aspectFit"
        aria-label="{{outputPath ? '编辑结果预览' : '原图预览'}}"
      />
      <view wx:else class="pe-stage__blank">
        <text class="pe-stage__title">从相册选择图片</text>
        <text class="pe-stage__sub">源图 ≤12MP，长边超过 4096 会先等比缩小</text>
      </view>
      <view wx:if="{{processing}}" class="pe-stage__mask">
        <text class="pe-stage__mask-text">本机处理中</text>
      </view>
    </view>

    <view wx:if="{{sourceMeta}}" class="pe-meta-row">
      <text class="pe-meta">原图 {{sourceMeta}}</text>
      <text wx:if="{{sourceNote}}" class="pe-meta pe-meta--warn">{{sourceNote}}</text>
    </view>

    <view class="pe-section">
      <text class="pe-label">裁剪比例</text>
      <view class="pe-chips">
        <view
          wx:for="{{ratioOptions}}"
          wx:key="key"
          class="pe-chip {{item.key === ratioKey ? 'pe-chip--on' : ''}}"
          data-key="{{item.key}}"
          bindtap="onRatio"
          aria-role="button"
          aria-label="裁剪比例 {{item.label}}"
        >{{item.label}}</view>
      </view>
    </view>

    <view class="pe-section">
      <text class="pe-label">旋转 / 翻转</text>
      <view class="pe-row">
        <view class="pe-chip" data-delta="{{-90}}" bindtap="onRotate" aria-role="button" aria-label="左转 90 度">左转 90°</view>
        <text class="pe-angle">{{rotation}}°</text>
        <view class="pe-chip" data-delta="{{90}}" bindtap="onRotate" aria-role="button" aria-label="右转 90 度">右转 90°</view>
      </view>
      <view class="pe-chips">
        <view
          class="pe-chip {{flipH ? 'pe-chip--on' : ''}}"
          data-axis="h"
          bindtap="onFlip"
          aria-role="checkbox"
          aria-checked="{{flipH}}"
        >水平翻转</view>
        <view
          class="pe-chip {{flipV ? 'pe-chip--on' : ''}}"
          data-axis="v"
          bindtap="onFlip"
          aria-role="checkbox"
          aria-checked="{{flipV}}"
        >垂直翻转</view>
      </view>
    </view>

    <view class="pe-section">
      <text class="pe-label">输出格式</text>
      <view class="pe-chips">
        <view
          wx:for="{{formatOptions}}"
          wx:key="key"
          class="pe-chip {{item.key === formatKey ? 'pe-chip--on' : ''}}"
          data-key="{{item.key}}"
          bindtap="onFormat"
          aria-role="button"
          aria-label="输出格式 {{item.label}}"
        >{{item.label}}</view>
      </view>
      <view wx:if="{{formatKey === 'jpeg'}}" class="pe-chips">
        <view
          wx:for="{{qualityOptions}}"
          wx:key="key"
          class="pe-chip {{item.key === qualityKey ? 'pe-chip--on' : ''}}"
          data-key="{{item.key}}"
          bindtap="onQuality"
          aria-role="button"
          aria-label="JPEG 质量 {{item.label}}"
        >{{item.label}}</view>
      </view>
    </view>
  </view>

  <view slot="result" class="sg-tool-result">
    <view class="sg-tool-result__head">
      <text class="sg-tool-result__label">输出</text>
      <text class="sg-tool-result__meta" bindtap="onCopyInfo">点击复制信息</text>
    </view>

    <view class="sg-tool-result__main" aria-role="status">{{outputWidth}} × {{outputHeight}}</view>

    <image
      class="pe-output"
      src="{{outputPath}}"
      mode="aspectFit"
      bindtap="onPreview"
      aria-role="button"
      aria-label="预览编辑结果"
    />

    <view class="sg-tool-rows">
      <view wx:for="{{resultRows}}" wx:key="k" class="sg-tool-row">
        <text class="sg-tool-row__k">{{item.k}}</text>
        <text class="sg-tool-row__v">{{item.v}}</text>
      </view>
    </view>

    <view class="tool-actions">
      <glass-button variant="ghost" size="md" block bind:tap="onPreview">预览</glass-button>
      <glass-button
        variant="primary"
        size="md"
        block
        loading="{{saving}}"
        loading-text="保存中"
        bind:tap="onSave"
      >保存到相册</glass-button>
    </view>

    <view class="sg-tool-note">
      <text class="sg-tool-note__title">说明</text>
      <text class="sg-tool-note__text">按真实像素重新绘制，预览仅做屏幕缩放；透明 PNG 输出 JPEG 时自动补白底。图片只在本机处理，退出页面即清理临时文件。</text>
    </view>
  </view>
</glass-tool-shell>

<canvas
  wx:if="{{!devtools}}"
  id="photo-canvas"
  type="2d"
  class="pe-canvas"
  style="width: {{canvasCss}}px; height: {{canvasCss}}px;"
></canvas>

/* ==========================================================================
   九宫格切图 · 空间玻璃页面样式
   - 只使用 --glass-* / --sg-* 令牌
   - 隐藏 Canvas 保持原生节点，仅做离屏绘制
   ========================================================================== */

.tool-notice {
  box-sizing: border-box;
  padding: 16rpx 20rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: var(--glass-radius-sm);
  background-color: var(--glass-accent-warm-soft);
}

.tool-notice__text {
  color: var(--glass-text-2);
  font-size: 21rpx;
  line-height: 1.6;
}

/* ---- 选图舞台 ---- */
.tool-stage {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 360rpx;
  overflow: hidden;
  box-sizing: border-box;
  border: 1rpx solid var(--glass-border);
  border-radius: var(--glass-radius-md);
  background-color: var(--glass-bg-soft);
  box-shadow: inset 0 1rpx 0 var(--glass-inner-glow);
}

.tool-stage__preview {
  width: 100%;
  height: 420rpx;
  display: block;
}

.tool-stage__blank {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-sizing: border-box;
  padding: 56rpx 24rpx;
}

.tool-stage__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 96rpx;
  height: 96rpx;
  border: 1rpx solid var(--glass-border-strong);
  border-radius: 28rpx;
  background-color: var(--glass-accent-soft);
  box-shadow: var(--glass-shadow-soft);
}

.tool-stage__title {
  color: var(--glass-text);
  font-size: 27rpx;
  font-weight: 700;
}

.tool-stage__sub {
  color: var(--glass-text-3);
  font-size: 21rpx;
  line-height: 1.5;
  text-align: center;
}

.tool-stage__loading {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  background-color: var(--glass-scrim);
}

.tool-stage__spinner {
  width: 44rpx;
  height: 44rpx;
  box-sizing: border-box;
  border: 3rpx solid var(--glass-border);
  border-top-color: var(--glass-accent-2);
  border-radius: 999rpx;
  animation: tool-media-spin 0.8s linear infinite;
}

.tool-stage__loading-text {
  color: var(--glass-text);
  font-size: 23rpx;
}

@keyframes tool-media-spin {
  to {
    transform: rotate(360deg);
  }
}

/* ---- 提示行 ---- */
.tool-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  box-sizing: border-box;
}

.tool-meta__hint {
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 20rpx;
  line-height: 1.5;
}

/* ---- 结果 ---- */
.tool-metrics {
  display: flex;
  flex-direction: row;
  gap: 14rpx;
  box-sizing: border-box;
}

.tool-metric {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
  box-sizing: border-box;
  padding: 16rpx 18rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: var(--glass-radius-sm);
  background-color: var(--glass-bg-soft);
}

.tool-metric__k {
  color: var(--glass-text-3);
  font-size: 19rpx;
}

.tool-metric__v {
  color: var(--glass-text);
  font-family: var(--glass-font-mono);
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.1;
}

/* ---- 九宫格 ---- */
.tool-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 8rpx;
  box-sizing: border-box;
}

.tool-grid__cell {
  position: relative;
  flex: 1 1 30%;
  min-width: 0;
  box-sizing: border-box;
  overflow: hidden;
  border: 1rpx solid var(--glass-border);
  border-radius: var(--glass-radius-xs);
  background-color: var(--glass-bg-soft);
}

.tool-grid__cell_pressed {
  border-color: var(--glass-border-strong);
  box-shadow: var(--glass-shadow-soft);
}

.tool-grid__img {
  width: 100%;
  height: 196rpx;
  display: block;
}

.tool-grid__index {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  box-sizing: border-box;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background-color: var(--glass-bg-strong);
  color: var(--glass-text-2);
  font-family: var(--glass-font-mono);
  font-size: 16rpx;
}

.tool-hint {
  color: var(--glass-text-3);
  font-size: 21rpx;
  line-height: 1.6;
}

/* ---- 隐藏画布 ---- */
.tool-canvas {
  position: fixed;
  left: -9999rpx;
  top: 0;
  opacity: 0;
  pointer-events: none;
}

/* ---- 注释 ---- */
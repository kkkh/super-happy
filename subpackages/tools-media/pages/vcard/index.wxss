/* 二维码名片 · 图片名片 / 二维码 / vCard 文本预览 */
.vc-card-wrap{display:flex;justify-content:center}
.vc-card{width:320px;height:auto;border-radius:18rpx;box-shadow:0 18rpx 46rpx rgba(8,12,24,.28);background-color:#0a0f1c}
.vc-card-empty{box-sizing:border-box;width:100%;padding:36rpx 24rpx;border:1rpx dashed var(--glass-border);border-radius:18rpx;color:var(--glass-text-3);font-size:20rpx;text-align:center}
.vc-qr{width:100%;height:300rpx;border-radius:var(--glass-radius-md);background-color:var(--glass-bg-soft)}
.vc-text{max-height:360rpx;box-sizing:border-box;padding:16rpx 18rpx;border:1rpx solid var(--glass-border);border-radius:var(--glass-radius-md);background-color:var(--glass-bg-soft);color:var(--glass-text);font-family:var(--glass-font-mono);font-size:21rpx;line-height:1.6;word-break:break-all}
.tool-actions{display:flex;flex-direction:column;gap:18rpx;margin-top:10rpx}

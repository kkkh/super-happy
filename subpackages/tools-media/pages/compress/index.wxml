<glass-tool-shell
  tool-id="compress"
  title="{{toolName}}"
  kicker="{{kicker}}"
  desc="{{desc}}"
  poster-data="{{posterData}}"
  state="{{shellState}}"
  show-run="{{false}}"
  show-example="{{false}}"
  has-result="{{hasResult}}"
  error="{{error}}"
  empty-title="从相册选择图片开始压缩"
  empty-sub="最多 9 张串行处理，图片只在本机，不会上传服务器"
  bind:reset="onReset"
>
  <view slot="input" class="sg-tool-fields">
    <view class="tool-stage" aria-label="{{items.length ? '已选择 ' + items.length + ' 张图片' : '尚未选择图片'}}">
      <block wx:if="{{items.length}}">
        <view class="batch-grid">
          <view
            wx:for="{{items}}"
            wx:key="id"
            class="batch-thumb batch-thumb--{{item.status}}"
          >
            <image class="batch-thumb__img" src="{{item.originalPath}}" mode="aspectFill" aria-label="{{item.name}}" />
            <text class="batch-thumb__index">{{index + 1}}</text>
            <view wx:if="{{item.status === 'processing'}}" class="batch-thumb__mask">处理中</view>
            <view wx:elif="{{item.status === 'failed' || item.status === 'rejected'}}" class="batch-thumb__mask batch-thumb__mask--error">!</view>
            <view wx:elif="{{item.status === 'done'}}" class="batch-thumb__badge">✓</view>
          </view>
        </view>
      </block>
      <view wx:else class="tool-stage__blank">
        <view class="tool-stage__icon">
          <g-icon name="image" size="{{44}}" tone="media" />
        </view>
        <text class="tool-stage__title">从相册选择图片</text>
        <text class="tool-stage__sub">最多 9 张 · 单张 ≤12MP · 总源 ≤80MB</text>
      </view>

      <view wx:if="{{compressing}}" class="batch-progress">
        <view class="batch-progress__head">
          <text>{{cancelling ? '正在取消…' : '正在压缩 ' + processingIndex + ' / ' + processingTotal}}</text>
          <text>{{progressPercent}}%</text>
        </view>
        <view class="batch-progress__track">
          <view class="batch-progress__bar" style="width: {{progressPercent}}%"></view>
        </view>
        <text class="batch-progress__name">{{processingName}}</text>
        <glass-button
          size="sm"
          variant="ghost"
          aria-label="取消批量压缩"
          bind:tap="onCancel"
        >{{cancelling ? '取消中' : '取消'}}</glass-button>
      </view>
    </view>

    <view class="tool-meta">
      <text class="tool-meta__hint">
        {{items.length ? items.length + ' 张 · 原图合计 ' + sourceTotalText : '不会读取相册，也不会申请相机'}}
      </text>
    </view>

    <glass-button
      variant="primary"
      size="md"
      block
      loading="{{compressing}}"
      loading-text="本机压缩中"
      aria-label="{{items.length ? '重新选择图片' : '从相册选择图片'}}"
      bind:tap="onChoose"
    >
      {{items.length ? '重新选择（最多 9 张）' : '从相册选择图片'}}
    </glass-button>

    <view class="tool-field">
      <text class="tool-field__label">压缩质量</text>
      <view class="tool-chips">
        <glass-button
          wx:for="{{qualities}}"
          wx:key="key"
          size="sm"
          shape="rounded"
          variant="{{qualityKey === item.key ? 'primary' : 'ghost'}}"
          custom-class="tool-chip"
          data-key="{{item.key}}"
          aria-label="压缩质量{{item.label}}"
          bind:tap="onQuality"
        >
          {{item.label}}
        </glass-button>
      </view>
    </view>

    <view class="tool-field">
      <text class="tool-field__label">最大边尺寸</text>
      <view class="tool-chips">
        <glass-button
          wx:for="{{edges}}"
          wx:key="key"
          size="sm"
          shape="rounded"
          variant="{{edgeKey === item.key ? 'primary' : 'ghost'}}"
          custom-class="tool-chip"
          data-key="{{item.key}}"
          aria-label="最大边{{item.label}}"
          bind:tap="onEdge"
        >
          {{item.label}}
        </glass-button>
      </view>
      <text class="batch-cap-hint">批量场景输出长边最多 2048px</text>
    </view>
  </view>

  <view slot="result" class="sg-tool-result">
    <view class="sg-tool-result__head">
      <text class="sg-tool-result__label">批量压缩</text>
      <text class="sg-tool-result__meta">{{doneCount}} / {{totalCount}} 张完成</text>
    </view>

    <view wx:if="{{doneCount}}" class="tool-metrics">
      <view class="tool-metric">
        <text class="tool-metric__k">原图合计</text>
        <text class="tool-metric__v">{{totalOriginalText}}</text>
      </view>
      <view class="tool-metric">
        <text class="tool-metric__k">压缩后合计</text>
        <text class="tool-metric__v">{{totalCompressedText}}</text>
      </view>
    </view>

    <view wx:if="{{doneCount}}" class="tool-hero">
      <animated-number
        value="{{totalRatioValue}}"
        decimals="1"
        suffix="%"
        size="xl"
        tone="aurora"
      />
      <text class="tool-hero__label">总体积变化 / DELTA</text>
      <text class="tool-hero__caption">{{totalSavedText}}</text>
    </view>

    <view class="batch-list">
      <view wx:for="{{items}}" wx:key="id" class="batch-row batch-row--{{item.status}}">
        <image class="batch-row__thumb" src="{{item.originalPath}}" mode="aspectFill" aria-label="{{item.name}}缩略图" />
        <view class="batch-row__body">
          <view class="batch-row__head">
            <text class="batch-row__name">{{item.name}}</text>
            <text class="batch-row__status">{{item.statusText}}</text>
          </view>
          <text wx:if="{{item.status === 'done'}}" class="batch-row__size">{{item.originalSizeText}} → {{item.compressedSizeText}}</text>
          <text wx:if="{{item.status === 'done'}}" class="batch-row__saved">{{item.savedText}}</text>
          <text wx:elif="{{item.error}}" class="batch-row__error">{{item.error}}</text>
          <text wx:else class="batch-row__size">{{item.originalSizeText}} · {{item.originalWidth}} × {{item.originalHeight}}</text>
        </view>
        <glass-button
          wx:if="{{item.status === 'done'}}"
          size="sm"
          variant="ghost"
          custom-class="batch-row__save"
          data-id="{{item.id}}"
          loading="{{savingId === item.id}}"
          loading-text="保存中"
          aria-label="保存{{item.name}}到相册"
          bind:tap="onSaveItem"
        >保存</glass-button>
      </view>
    </view>

    <view wx:if="{{failedCount}}" class="tool-notice">
      有 {{failedCount}} 张未完成（超过 12MP 或压缩失败），已跳过，不影响其余图片。
    </view>

    <view wx:if="{{doneCount}}" class="sg-tool-result__actions">
      <glass-button
        variant="aurora"
        size="md"
        block
        loading="{{savingAll}}"
        loading-text="保存中"
        aria-label="保存全部压缩图片到相册"
        bind:tap="onSaveAll"
      >
        保存全部（{{doneCount}} 张）
      </glass-button>
      <glass-button
        variant="ghost"
        size="md"
        block
        aria-label="复制压缩信息"
        bind:tap="onCopyInfo"
      >
        复制信息
      </glass-button>
    </view>

    <text wx:if="{{doneCount}}" class="batch-poster-note">海报取第 1 张已完成图片</text>
  </view>

  <view slot="note">
    <glass-card tone="amber" radius="lg" padding="md" depth="soft">
      <view class="sg-tool-note">
        <text class="sg-tool-note__title">本机批量处理</text>
        <text class="sg-tool-note__text">
          使用微信原生压缩能力逐张串行处理，只读取您主动选择的图片；不扫描相册列表、不申请相机、不上传服务器。
          单张超过 12MP 会跳过，单批最多 9 张且总源不超过 80MB；取消或关闭页面会清理临时文件。
          仅在点击保存时申请写入权限。
        </text>
      </view>
    </glass-card>
  </view>
</glass-tool-shell>

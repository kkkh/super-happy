/* ==========================================================================
   图片压缩 · 空间玻璃页面样式
   - 只使用 --glass-* / --sg-* 令牌，无硬编码色值
   ========================================================================== */

/* ---- 选图舞台 ---- */
.tool-stage {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 360rpx;
  overflow: hidden;
  box-sizing: border-box;
  border: 1rpx solid var(--glass-border);
  border-radius: var(--glass-radius-md);
  background-color: var(--glass-bg-soft);
  box-shadow: inset 0 1rpx 0 var(--glass-inner-glow);
}

.tool-stage__preview {
  width: 100%;
  height: 420rpx;
  display: block;
}

.tool-stage__blank {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-sizing: border-box;
  padding: 56rpx 24rpx;
}

.tool-stage__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 96rpx;
  height: 96rpx;
  border: 1rpx solid var(--glass-border-strong);
  border-radius: 28rpx;
  background-color: var(--glass-accent-soft);
  box-shadow: var(--glass-shadow-soft);
}

.tool-stage__title {
  color: var(--glass-text);
  font-size: 27rpx;
  font-weight: 700;
}

.tool-stage__sub {
  color: var(--glass-text-3);
  font-size: 21rpx;
  line-height: 1.5;
  text-align: center;
}

.tool-stage__loading {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  background-color: var(--glass-scrim);
  color: var(--glass-text);
  font-size: 23rpx;
}

.tool-stage__spinner {
  width: 44rpx;
  height: 44rpx;
  box-sizing: border-box;
  border: 3rpx solid var(--glass-border);
  border-top-color: var(--glass-accent-2);
  border-radius: 999rpx;
  animation: tool-media-spin 0.8s linear infinite;
}

.tool-stage__loading-text {
  color: var(--glass-text);
  font-size: 23rpx;
}

@keyframes tool-media-spin {
  to {
    transform: rotate(360deg);
  }
}

/* ---- 提示行 ---- */
.tool-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  box-sizing: border-box;
}

.tool-meta__hint {
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 20rpx;
  line-height: 1.5;
}

/* ---- 选项分栏 ---- */
.tool-field {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  box-sizing: border-box;
}

.tool-field__label {
  color: var(--glass-text-2);
  font-size: 24rpx;
  font-weight: 600;
}

.tool-chips {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  box-sizing: border-box;
}

.tool-chip {
  flex: 1;
  min-width: 0;
}

/* ---- 结果 ---- */
.tool-compare {
  display: flex;
  flex-direction: row;
  gap: 14rpx;
  box-sizing: border-box;
}

.tool-compare__item {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
  box-sizing: border-box;
  padding: 12rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: var(--glass-radius-sm);
  background-color: var(--glass-bg-soft);
}

.tool-compare__img {
  width: 100%;
  height: 220rpx;
  display: block;
  border-radius: var(--glass-radius-xs);
  background-color: var(--glass-bg);
}

.tool-compare__name {
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 17rpx;
  letter-spacing: 0.06em;
}

.tool-compare__size {
  color: var(--glass-text);
  font-family: var(--glass-font-mono);
  font-size: 24rpx;
  font-weight: 600;
}

.tool-hero {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  box-sizing: border-box;
  padding-top: 6rpx;
}

.tool-hero__label {
  color: var(--glass-text-3);
  font-family: var(--glass-font-mono);
  font-size: 18rpx;
  letter-spacing: 0.12em;
}

.tool-hero__caption {
  color: var(--glass-text-2);
  font-size: 21rpx;
  line-height: 1.5;
}

.tool-metrics {
  display: flex;
  flex-direction: row;
  gap: 14rpx;
  box-sizing: border-box;
}

.tool-metric {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
  box-sizing: border-box;
  padding: 16rpx 18rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: var(--glass-radius-sm);
  background-color: var(--glass-bg-soft);
}

.tool-metric__k {
  color: var(--glass-text-3);
  font-size: 19rpx;
}

.tool-notice {
  box-sizing: border-box;
  padding: 16rpx 20rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: var(--glass-radius-sm);
  background-color: var(--glass-accent-warm-soft);
  color: var(--glass-text-2);
  font-size: 21rpx;
  line-height: 1.6;
}

/* ---- 注释 ---- */

/* ---- 批量选图网格 ---- */
.batch-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  width: 100%;
  box-sizing: border-box;
  padding: 14rpx;
}

.batch-thumb {
  position: relative;
  overflow: hidden;
  border: 1rpx solid var(--glass-border);
  border-radius: var(--glass-radius-xs);
  background-color: var(--glass-bg);
}

.batch-thumb--processing {
  border-color: var(--glass-accent-2);
}

.batch-thumb--failed,
.batch-thumb--rejected {
  opacity: 0.72;
}

.batch-thumb__img {
  display: block;
  width: 100%;
  height: 154rpx;
}

.batch-thumb__index {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  min-width: 30rpx;
  padding: 2rpx 8rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background-color: var(--glass-scrim);
  color: var(--glass-text);
  font-family: var(--glass-font-mono);
  font-size: 17rpx;
  text-align: center;
}

.batch-thumb__mask {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 4rpx 0;
  background-color: var(--glass-scrim);
  color: var(--glass-text);
  font-size: 17rpx;
  text-align: center;
}

.batch-thumb__mask--error {
  color: var(--glass-danger-text);
  font-weight: 700;
}

.batch-thumb__badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background-color: var(--glass-accent);
  color: var(--glass-on-accent);
  font-size: 18rpx;
  font-weight: 700;
}

/* ---- 串行进度 ---- */
.batch-progress {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  width: 100%;
  box-sizing: border-box;
  padding: 16rpx 18rpx 18rpx;
  border-top: 1rpx solid var(--glass-border);
  background-color: var(--glass-bg-soft);
}

.batch-progress__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--glass-text-2);
  font-family: var(--glass-font-mono);
  font-size: 20rpx;
}

.batch-progress__track {
  overflow: hidden;
  height: 10rpx;
  border-radius: 999rpx;
  background-color: var(--glass-bg-strong);
}

.batch-progress__bar {
  height: 100%;
  border-radius: 999rpx;
  background-color: var(--glass-accent-2);
  transition: width 180ms ease;
}

.batch-progress__name {
  color: var(--glass-text-3);
  font-size: 19rpx;
}

.batch-cap-hint {
  color: var(--glass-text-3);
  font-size: 19rpx;
}

/* ---- 批量结果 ---- */
.tool-metric__v {
  color: var(--glass-text);
  font-family: var(--glass-font-mono);
  font-size: 26rpx;
  font-weight: 600;
}

.batch-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  box-sizing: border-box;
}

.batch-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14rpx;
  box-sizing: border-box;
  padding: 12rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: var(--glass-radius-sm);
  background-color: var(--glass-bg-soft);
}

.batch-row--processing {
  border-color: var(--glass-accent-2);
}

.batch-row--failed,
.batch-row--rejected {
  border-color: var(--glass-danger);
}

.batch-row__thumb {
  flex: none;
  width: 84rpx;
  height: 84rpx;
  border-radius: var(--glass-radius-xs);
  background-color: var(--glass-bg);
}

.batch-row__body {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.batch-row__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.batch-row__name {
  overflow: hidden;
  color: var(--glass-text);
  font-size: 23rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.batch-row__status {
  flex: none;
  color: var(--glass-text-3);
  font-size: 18rpx;
}

.batch-row__size,
.batch-row__saved,
.batch-row__error {
  color: var(--glass-text-2);
  font-family: var(--glass-font-mono);
  font-size: 19rpx;
  line-height: 1.4;
}

.batch-row__saved {
  color: var(--glass-accent-text);
}

.batch-row__error {
  color: var(--glass-danger-text);
}

.batch-row__save {
  flex: none;
}

.batch-poster-note {
  color: var(--glass-text-3);
  font-size: 18rpx;
  text-align: center;
}
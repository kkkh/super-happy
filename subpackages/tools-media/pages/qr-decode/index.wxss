/* ==========================================================================
   二维码识别 · 选图 / 结果文本 / 截断提示
   - 文本区固定高度滚动，避免超长内容把结果卡撑开
   - 真机 WXSS 禁止裸伪类，交互态全部走显式 class
   ========================================================================== */

.qr-notice {
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 159, 10, 0.12);
  border: 1rpx solid rgba(255, 159, 10, 0.28);
}

.qr-notice__text {
  color: var(--glass-text-2);
  font-size: 22rpx;
  line-height: 1.55;
}

.qr-blank {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 260rpx;
  padding: 36rpx 24rpx;
  border-radius: 28rpx;
  border: 1rpx dashed var(--glass-border);
  background: var(--glass-bg-soft);
}

.qr-blank__title {
  color: var(--glass-text);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.3;
}

.qr-blank__sub {
  margin-top: 10rpx;
  color: var(--glass-text-3);
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}

.qr-source {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx;
  border-radius: 26rpx;
  border: 1rpx solid var(--glass-border);
  background: var(--glass-bg-soft);
}

.qr-source__img {
  flex: none;
  width: 168rpx;
  height: 168rpx;
  border-radius: 18rpx;
  background-color: #ffffff;
}

.qr-source__meta {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.qr-source__title {
  color: var(--glass-text);
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.35;
}

.qr-source__sub {
  margin-top: 8rpx;
  color: var(--glass-text-3);
  font-size: 21rpx;
  line-height: 1.4;
  word-break: break-all;
}

.qr-hint {
  padding: 4rpx 4rpx 0;
  color: var(--glass-text-3);
  font-size: 21rpx;
  line-height: 1.55;
}

.qr-text {
  box-sizing: border-box;
  height: 320rpx;
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid var(--glass-border);
  background: var(--glass-bg-soft);
}

.qr-text__value {
  color: var(--glass-text);
  font-family: var(--glass-font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
  font-size: 23rpx;
  line-height: 1.65;
  word-break: break-all;
  white-space: pre-wrap;
}

.qr-truncated {
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  border-radius: 18rpx;
  background: rgba(255, 159, 10, 0.1);
  color: var(--glass-text-2);
  font-size: 21rpx;
  line-height: 1.5;
}

.qr-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.qr-canvas {
  position: absolute;
  left: -9999px;
  top: -9999px;
  width: 300px;
  height: 300px;
}

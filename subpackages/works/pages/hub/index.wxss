/* 作品宇宙 */
.hub_scroll {
  flex: 1;
  width: 100%;
}

.hub_body {
  display: flex;
  flex-direction: column;
  padding: 8rpx 56rpx calc(56rpx + env(safe-area-inset-bottom));
  gap: 36rpx;
}

.hub_loading {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  padding-top: 16rpx;
}

/* ---- 头 ---- */
.hub_head {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-top: 16rpx;
}

.hub_title {
  font-size: 56rpx;
  font-weight: 800;
  color: var(--g-ink);
  letter-spacing: 4rpx;
}

.hub_sub {
  font-size: 20rpx;
  color: var(--g-ink-4);
  letter-spacing: 3rpx;
  font-weight: 600;
}

/* ---- 收藏速览 ---- */
.hub_fav {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
}

.hub_fav_text {
  font-size: 22rpx;
  color: var(--g-amber);
  letter-spacing: 2rpx;
}

/* ---- 分类卡 ---- */
.hub_cats {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.hub_cat {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.hub_cat_head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.hub_kicker {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.hub_kicker_iris { color: var(--g-iris); }
.hub_kicker_aurora { color: var(--g-aurora); }
.hub_kicker_amber { color: var(--g-amber); }

.hub_count {
  min-width: 56rpx;
  height: 56rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--g-well);
  border: 1rpx solid var(--g-stroke);
}

.hub_count text {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--g-ink-2);
  font-variant-numeric: tabular-nums;
}

.hub_cat_title {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--g-ink);
  letter-spacing: 3rpx;
}

.hub_cat_desc {
  font-size: 24rpx;
  color: var(--g-ink-3);
  line-height: 1.7;
}

.hub_cat_cta {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6rpx;
  margin-top: 4rpx;
}

.hub_cta_text {
  font-size: 22rpx;
  letter-spacing: 3rpx;
  font-weight: 600;
}

.hub_cta_text_iris { color: var(--g-iris); }
.hub_cta_text_aurora { color: var(--g-aurora); }
.hub_cta_text_amber { color: var(--g-amber); }
